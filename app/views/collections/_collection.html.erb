<div id="<%= dom_id(collection) %>" class="relative flex flex-col rounded-lg bg-white p-6 shadow-sm inset-ring inset-ring-gray-900/5 dark:bg-white/5 dark:inset-ring-white/10 hover:shadow-md transition-shadow">
  <%= link_to collection_path(collection), data: { turbo_frame: "collection" }, class: "absolute inset-0 rounded-lg" do %>
    <span class="sr-only"><%= collection.title %></span>
  <% end %>

  <div class="flex items-start justify-between">
    <div class="flex items-center gap-3">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-[#5f734c] dark:text-[#7a8f62] shrink-0">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 0 0-1.883 2.542l.857 6a2.25 2.25 0 0 0 2.227 1.932H19.05a2.25 2.25 0 0 0 2.227-1.932l.857-6a2.25 2.25 0 0 0-1.883-2.542m-16.5 0V6A2.25 2.25 0 0 1 6 3.75h3.879a1.5 1.5 0 0 1 1.06.44l2.122 2.12a1.5 1.5 0 0 0 1.06.44H18A2.25 2.25 0 0 1 20.25 9v.776" />
      </svg>
      <h3 class="text-base font-semibold text-gray-900 dark:text-white"><%= collection.title %></h3>
    </div>
    <% if collection.public? %>
      <span class="relative z-10 inline-flex items-center rounded-full bg-[#e8ede3] px-2 py-0.5 text-xs font-medium text-[#5f734c] dark:bg-[#7a8f62]/20 dark:text-[#7a8f62]">Public</span>
    <% end %>
  </div>

  <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
    <%= pluralize(collection.recipes.count, 'recipe') %>
  </p>

  <% if collection.owned_by?(current_user) %>
    <div class="relative z-10 mt-4 flex items-center gap-3 pt-4 border-t border-gray-100 dark:border-white/10">
      <%= link_to "Edit", edit_collection_path(collection),
            data: { turbo_frame: "collection" },
            class: "text-sm font-medium text-[#5f734c] hover:text-[#4b5a3d] dark:text-[#7a8f62]" %>
      <%= button_to "Delete", collection_path(collection), method: :delete,
            data: { turbo_confirm: "Delete this collection?" },
            class: "text-sm font-medium text-dusty-rose-600 hover:text-dusty-rose-800 dark:text-dusty-rose-400" %>
    </div>
  <% end %>
</div>
