<%# locals: (event:, id:) %>
<%# The hover card on an event chip in the month, week and day views — just
    enough to tell events apart (title, when, which calendar, where). The
    full details are in the dialog the chip opens. Shown and placed by
    event_tooltip_controller.js; it sits inside the chip's wrapper, which has
    that controller. %>
<div data-event-tooltip-target="tooltip" role="tooltip" id="<%= id %>"
     class="hidden fixed z-[70] w-64 max-w-[calc(100vw-1rem)] pointer-events-none rounded-lg border border-gray-200 bg-white p-3 text-left shadow-lg
            dark:border-white/15 dark:bg-[#242b1e]">
  <p class="text-sm font-semibold text-gray-900 dark:text-white break-words"><%= event.title %></p>
  <p class="mt-1 text-xs text-gray-600 dark:text-gray-300"><%= event_tooltip_when(event) %></p>
  <p class="mt-2 flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400">
    <span class="size-2 shrink-0 rounded-full <%= event.calendar_source.color_classes[:dot] %>"></span>
    <span class="truncate"><%= event.calendar_source.name %></span>
  </p>
  <% if event.location.present? %>
    <p class="mt-1 flex items-start gap-1.5 text-xs text-gray-500 dark:text-gray-400">
      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="mt-px size-3 shrink-0">
        <path fill-rule="evenodd" d="m9.69 18.933.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 0 0 .281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 1 0 3 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 0 0 2.273 1.765 11.842 11.842 0 0 0 .976.544l.062.029.018.008.006.003ZM10 11.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Z" clip-rule="evenodd" />
      </svg>
      <span class="line-clamp-2"><%= event.location %></span>
    </p>
  <% end %>
</div>
