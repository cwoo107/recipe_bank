<% content_for :title, "Calendar — Week of #{@date.strftime("%b %d, %Y")}" %>

<div class="w-full" data-controller="calendar">
  <%# ── Header ── %>
  <div class="sm:flex sm:items-center sm:justify-between mb-6">
    <div>
      <h1 class="text-5xl tracking-tight text-olive-800 dark:text-[#e8ede3]">
        <span style="font-family: 'Instrument Serif', serif;">
          <span class="text-[#5f734c]">Week</span>
          <span class="text-olive-800 dark:text-[#e8ede3] text-3xl font-normal">
            <%= @date.strftime("%b %-d") %> – <%= @range_end.strftime("%b %-d, %Y") %>
          </span>
        </span>
      </h1>
    </div>

    <div class="mt-4 sm:mt-0 flex items-center gap-2 flex-wrap">
      <%= render "calendars/view_switcher", current: :week, date: @date %>
      <%= link_to "Today", week_calendars_path(date: Time.zone.today.to_s),
            class: "rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-xs
                    inset-ring inset-ring-gray-300 hover:bg-gray-50
                    dark:bg-white/10 dark:text-white dark:inset-ring-white/5 dark:hover:bg-white/20" %>
      <div class="flex items-center gap-1">
        <%= link_to prev_week_path(@date), class: "p-2 rounded-md hover:bg-gray-100 dark:hover:bg-white/10 text-gray-500 dark:text-gray-400 transition" do %>
          <svg class="size-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" /></svg>
        <% end %>
        <%= link_to next_week_path(@date), class: "p-2 rounded-md hover:bg-gray-100 dark:hover:bg-white/10 text-gray-500 dark:text-gray-400 transition" do %>
          <svg class="size-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
        <% end %>
      </div>
      <%= link_to new_calendar_event_path,
            class: "inline-flex items-center gap-x-1.5 rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold
                    text-white shadow-xs hover:bg-[#4b5a3d] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c]" do %>
        <svg viewBox="0 0 20 20" fill="currentColor" class="-ml-0.5 size-5"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" /></svg>
        New event
      <% end %>
    </div>
  </div>

  <div class="flex gap-6">
    <div class="flex-1 min-w-0 rounded-lg border border-gray-200 dark:border-white/10
                bg-[var(--ivory)] dark:bg-[#1a1f16] overflow-hidden">

      <%# ── Day header row ── %>
      <div class="grid border-b border-gray-200 dark:border-white/10 bg-[var(--ivory)] dark:bg-[#1a1f16]"
           style="grid-template-columns: 4rem repeat(7, 1fr);">
        <div></div>
        <% 7.times do |i| %>
          <% d = @date + i.days %>
          <% is_today = d == Time.zone.today %>
          <%= link_to day_calendars_path(date: d.to_s),
                class: "py-3 text-center border-l border-gray-100 dark:border-white/5
                        hover:bg-gray-50 dark:hover:bg-white/5 transition" do %>
            <div class="text-xs font-semibold uppercase tracking-wide
                        <%= is_today ? 'text-[#5f734c] dark:text-[#7a8f62]' : 'text-gray-400 dark:text-gray-500' %>">
              <%= d.strftime("%a") %>
            </div>
            <div class="mt-0.5 inline-flex size-8 items-center justify-center rounded-full text-sm
                        <%= is_today ? 'bg-[#5f734c] text-white font-semibold dark:bg-[#7a8f62]' : 'text-gray-800 dark:text-white' %>">
              <%= d.day %>
            </div>
          <% end %>
        <% end %>
      </div>

      <%# ── All-day strip ── %>
      <% if @all_day_events.any? %>
        <div class="grid border-b border-gray-200 dark:border-white/10"
             style="grid-template-columns: 4rem repeat(7, 1fr);">
          <div class="py-2 pr-2 text-right text-xs text-gray-400 dark:text-gray-500 self-center">all day</div>
          <% 7.times do |i| %>
            <% d = @date + i.days %>
            <div class="min-h-8 p-1 border-l border-gray-100 dark:border-white/5 flex flex-col gap-0.5">
              <% @all_day_events.select { |e| e.starts_at.to_date <= d && e.ends_at.to_date >= d }.each do |event| %>
                <%= render "calendars/event_chip_week", event: event %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# ── Hourly grid ── %>
      <div class="relative overflow-y-auto" style="height: 600px;">
        <%# Hour ruler lines %>
        <div class="grid" style="grid-template-columns: 4rem 1fr; grid-template-rows: repeat(24, 3rem);">
          <% 24.times do |hour| %>
            <div class="border-t border-gray-100 dark:border-white/5 pr-2 text-right text-xs
                        text-gray-400 dark:text-gray-500 -translate-y-2.5 pt-0.5">
              <%= hour == 0 ? "" : hour_label(hour) %>
            </div>
            <div class="border-t border-gray-100 dark:border-white/5 col-span-1"></div>
          <% end %>
        </div>

        <%# Event columns overlay %>
        <div class="absolute inset-0 grid pointer-events-none" style="grid-template-columns: 4rem repeat(7, 1fr);">
          <div></div>
          <% 7.times do |i| %>
            <% d = @date + i.days %>
            <div class="relative border-l border-gray-100 dark:border-white/5 pointer-events-auto" style="height: #{24 * 3}rem;">
              <% (@events_by_day[d] || []).reject(&:all_day?).each do |event| %>
                <div data-controller="dialog" data-action="click->dialog#backdropClose"
                     class="absolute left-0.5 right-0.5"
                     style="<%= event_position_style(event, hour_height_rem: 3.0) %>">
                  <dialog data-dialog-target="dialog"
                          class="dark:bg-[#1a1f16] w-11/12 sm:w-[480px] rounded-xl p-0 shadow-2xl backdrop:bg-black/50 overflow-hidden">
                    <%= turbo_frame_tag "calendar_event_#{event.id}", src: calendar_event_path(event), loading: "lazy" %>
                    <div class="px-6 py-4">
                      <button type="button" data-action="dialog#close"
                              class="rounded-lg px-4 py-2 bg-gray-100 hover:bg-gray-200 dark:bg-white/10 dark:hover:bg-white/20
                                     text-sm font-medium text-gray-700 dark:text-white transition">Close</button>
                    </div>
                  </dialog>
                  <button type="button"
                          data-action="dialog#open"
                          class="absolute inset-0 w-full text-left rounded overflow-hidden text-xs px-1.5 py-1
                                 ring-1 ring-inset leading-snug hover:ring-2 transition z-10 <%= event_chip_classes(event) %>">
                    <div class="font-semibold truncate"><%= event.title %></div>
                    <div class="opacity-75 truncate"><%= event.short_time %></div>
                  </button>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <%# Current time indicator %>
        <% if @date <= Time.zone.today && Time.zone.today <= @range_end %>
          <% now = Time.zone.now %>
          <div class="absolute left-0 right-0 flex items-center pointer-events-none z-20"
               style="top: <%= ((now.hour * 60 + now.min) * 3.0 / 60.0).round(4) %>rem;">
            <div class="w-16 flex justify-end pr-1">
              <div class="size-2 rounded-full bg-[#5f734c]"></div>
            </div>
            <div class="flex-1 h-px bg-[#5f734c]"></div>
          </div>
        <% end %>
      </div>
    </div>

    <%= render "calendars/sidebar", sources: @sources %>
  </div>
</div>
