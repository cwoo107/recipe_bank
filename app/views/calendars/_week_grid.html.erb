<%# locals: (date:, range_end:, events_by_day:, all_day_events:, height: 600) %>
<%# A week's events as a grid — a column per day, an hour per row, all-day
    events in a strip on top. The Calendar's Week view, and the calendar step
    of "Plan your week" (plan_week/_calendar_step). %>
<div class="rounded-lg border border-gray-200 dark:border-white/10 bg-[var(--ivory)] dark:bg-[#1a1f16] overflow-hidden">

  <%# ── Day header row ── %>
  <div class="grid border-b border-gray-200 dark:border-white/10 bg-[var(--ivory)] dark:bg-[#1a1f16]"
       style="grid-template-columns: 4rem repeat(7, 1fr);">
    <div></div>
    <% 7.times do |i| %>
      <% d = date + i.days %>
      <% is_today = d == Time.zone.today %>
      <%= link_to day_calendars_path(date: d.to_s),
            class: "py-3 text-center border-l border-gray-100 dark:border-white/5
                    hover:bg-gray-50 dark:hover:bg-white/5 transition" do %>
        <div class="text-xs font-semibold uppercase tracking-wide
                    <%= is_today ? 'text-[#5f734c] dark:text-[#7a8f62]' : 'text-gray-400 dark:text-gray-500' %>">
          <%= d.strftime("%a") %>
        </div>
        <div class="mt-0.5 inline-flex size-8 items-center justify-center rounded-full text-sm
                    <%= is_today ? 'bg-[#5f734c] text-white font-semibold dark:bg-[#7a8f62]' : 'text-gray-800 dark:text-white' %>">
          <%= d.day %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%# ── All-day strip ── %>
  <% if all_day_events.any? %>
    <div class="grid border-b border-gray-200 dark:border-white/10"
         style="grid-template-columns: 4rem repeat(7, 1fr);">
      <div class="py-2 pr-2 text-right text-xs text-gray-400 dark:text-gray-500 self-center">all day</div>
      <% 7.times do |i| %>
        <% d = date + i.days %>
        <div class="min-h-8 p-1 border-l border-gray-100 dark:border-white/5 flex flex-col gap-0.5">
          <% all_day_events.select { |e| e.starts_at.to_date <= d && e.ends_at.to_date >= d }.each do |event| %>
            <%= render "calendars/event_chip_week", event: event, day: d %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ── Hourly grid ── %>
  <% day_start = 4 %>   <%# 4 AM %>
  <% day_end   = 23 %>  <%# 11 PM — last labeled hour; grid runs through midnight %>
  <% hour_h    = 3.0 %> <%# rem per hour %>
  <% rows      = (day_end - day_start) + 1 %>  <%# 20 rows: 4…23 %>
  <% grid_h    = rows * hour_h %>              <%# 60rem %>

  <div class="relative overflow-y-auto" style="height: <%= height %>px;">
    <%# Hour ruler %>
    <div class="grid" style="grid-template-columns: 4rem 1fr; grid-template-rows: repeat(<%= rows %>, <%= hour_h %>rem);">
      <% rows.times do |i| %>
        <% h = day_start + i %>
        <div class="relative border-t border-gray-100 dark:border-white/5">
    <span class="absolute top-0.5 right-2 text-[11px] leading-none text-gray-400 dark:text-gray-500">
      <%= hour_label(h) %>
    </span>
        </div>
        <div class="border-t border-gray-100 dark:border-white/5"></div>
      <% end %>
    </div>

    <%# Event columns overlay %>
    <div class="absolute inset-0 grid pointer-events-none" style="grid-template-columns: 4rem repeat(7, 1fr);">
      <div></div>
      <% 7.times do |i| %>
        <% d = date + i.days %>
        <div class="relative border-l border-gray-100 dark:border-white/5 pointer-events-auto" style="height: <%= grid_h %>rem;">
          <% (events_by_day[d] || []).reject(&:all_day?).each do |event| %>
            <% style = event_position_style(event, hour_height_rem: hour_h, start_hour: day_start, end_hour: day_end + 1) %>
            <% next if style.nil? %>
            <div data-controller="dialog event-stack event-tooltip"
                 data-action="click->dialog#backdropClose click->event-tooltip#hide mouseenter->event-stack#lift mouseleave->event-stack#drop
                              mouseenter->event-tooltip#show mouseleave->event-tooltip#hide focusin->event-tooltip#show focusout->event-tooltip#hide"
                 class="absolute left-0.5 right-0.5"
                 style="<%= style %>">
              <dialog data-dialog-target="dialog"
                      class="dark:bg-[#1a1f16] w-11/12 sm:w-[480px] rounded-xl p-0 shadow-2xl backdrop:bg-black/50 overflow-hidden">
                <%= turbo_frame_tag "calendar_event_#{event.id}", src: calendar_event_path(event), loading: "lazy" %>
                <div class="px-6 py-4">
                  <button type="button" data-action="dialog#close"
                          class="rounded-lg px-4 py-2 bg-gray-100 hover:bg-gray-200 dark:bg-white/10 dark:hover:bg-white/20
                           text-sm font-medium text-gray-700 dark:text-white transition">Close</button>
                </div>
              </dialog>
              <button type="button"
                      data-action="dialog#open" aria-describedby="event_tooltip_<%= event.id %>"
                      class="absolute inset-0 w-full text-left rounded overflow-hidden text-xs px-1.5 py-1
                       ring-1 ring-inset leading-snug hover:ring-2 transition z-10 <%= event_chip_classes(event) %>">
                <div class="font-semibold truncate"><%= event.title %></div>
                <div class="opacity-75 truncate"><%= event.short_time %></div>
              </button>
              <%= render "calendars/event_tooltip", event: event, id: "event_tooltip_#{event.id}" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Current time indicator %>
    <% if date <= Time.zone.today && Time.zone.today <= range_end %>
      <% now = Time.zone.now %>
      <% if now.hour >= day_start && now.hour <= day_end %>
        <% now_top = ((now.hour * 60 + now.min) - day_start * 60) * hour_h / 60.0 %>
        <div class="absolute left-0 right-0 flex items-center pointer-events-none z-20"
             style="top: <%= now_top.round(4) %>rem;">
          <div class="w-16 flex justify-end pr-1">
            <div class="size-2 rounded-full bg-[#5f734c]"></div>
          </div>
          <div class="flex-1 h-px bg-[#5f734c]"></div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
