<% content_for :title, "Plan #{@weekly_plan.week_label} — #{@dashboard_section.label}" %>

<%= native_form_tag %>

<div class="w-full max-w-6xl mx-auto">
  <%= render "plan_week/week_switcher", week_start: @week_start, weekly_plan: @weekly_plan,
             plannable_weeks: @plannable_weeks, week_plans: @week_plans %>

  <%= render "plan_week/progress", sections: @sections, current_key: @dashboard_section.key %>

  <div class="rounded-lg border border-gray-200 dark:border-white/10 bg-[var(--ivory)] dark:bg-[#1a1f16] overflow-hidden">
    <div class="flex items-center gap-2.5 px-4 py-3 border-b border-gray-200 dark:border-white/10">
      <%= render "dashboard/icon", name: @dashboard_section.icon_name %>
      <h1 class="text-2xl font-semibold text-olive-800 dark:text-[#e8ede3]" style="font-family: 'Instrument Serif', serif;">
        <%= @dashboard_section.label %>
      </h1>
    </div>

    <div class="p-4 sm:p-6">
      <%= render "plan_week/#{@dashboard_section.key}_step", section: @dashboard_section %>
    </div>
  </div>

  <%# Last step: offer to print the week being planned. (The household's last
      step — later ones may have been left out of the planner.) %>
  <% if @dashboard_section.key == current_household.planner_section_keys.last %>
    <div class="mt-4 flex flex-col gap-3 rounded-lg border border-[#5f734c]/30 bg-[#5f734c]/5 px-4 py-3 sm:flex-row sm:items-center sm:justify-between dark:border-[#7a8f62]/30 dark:bg-[#7a8f62]/10">
      <p class="text-sm text-gray-700 dark:text-gray-300">That's the last step. Want a printed copy of <%= WeeklyPlan.week_label(@week_start).downcase_first %>'s plan for the fridge?</p>
      <%= link_to new_week_print_path(week: @week_start), class: "shrink-0 inline-flex items-center gap-x-2 rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:inset-ring-white/5 dark:hover:bg-white/20" do %>
        <svg viewBox="0 0 20 20" fill="currentColor" class="-ml-0.5 size-5" aria-hidden="true"><path fill-rule="evenodd" d="M5 2.75C5 1.784 5.784 1 6.75 1h6.5c.966 0 1.75.784 1.75 1.75v3.552c.377.046.752.097 1.126.153A2.212 2.212 0 0 1 18 8.653v4.097A2.25 2.25 0 0 1 15.75 15h-.241l.305 1.984A1.75 1.75 0 0 1 14.084 19H5.915a1.75 1.75 0 0 1-1.73-2.016L4.492 15H4.25A2.25 2.25 0 0 1 2 12.75V8.653c0-1.082.775-2.034 1.874-2.198.374-.056.75-.107 1.127-.153L5 6.25v-3.5Zm8.5 3.397a41.533 41.533 0 0 0-7 0V2.75a.25.25 0 0 1 .25-.25h6.5a.25.25 0 0 1 .25.25v3.397ZM6.608 12.5a.25.25 0 0 0-.247.212l-.693 4.5a.25.25 0 0 0 .247.288h8.17a.25.25 0 0 0 .246-.288l-.692-4.5a.25.25 0 0 0-.247-.212H6.608Z" clip-rule="evenodd" /></svg>
        Print this week's plan
      <% end %>
    </div>
  <% end %>

  <div class="mt-4 flex items-center justify-between gap-3">
    <% if @previous_key %>
      <%= link_to plan_week_step_path(section: @previous_key, week: @week_start),
                  class: "text-sm font-medium text-gray-500 hover:text-[#5f734c] dark:text-gray-400 dark:hover:text-[#7a8f62]" do %>
        ← Back
      <% end %>
    <% else %>
      <%= link_to "← Back to dashboard", dashboard_path, class: "text-sm font-medium text-gray-500 hover:text-[#5f734c] dark:text-gray-400 dark:hover:text-[#7a8f62]" %>
    <% end %>

    <%= button_to "Skip this step", plan_week_step_path(section: @dashboard_section.key, week: @week_start),
                  method: :patch, params: { status: "skipped" },
                  class: "text-sm font-medium text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 bg-transparent p-0 border-0" %>
  </div>
</div>
