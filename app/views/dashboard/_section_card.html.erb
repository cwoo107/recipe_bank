<section aria-labelledby="section-<%= section.key %>-heading"
     class="flex flex-col rounded-lg border border-gray-200 dark:border-white/10 bg-[var(--ivory)] dark:bg-[#1a1f16] overflow-hidden">
  <div class="flex items-center justify-between gap-2 px-4 py-3 border-b border-gray-200 dark:border-white/10">
    <div class="flex items-center gap-2.5">
      <%= render "dashboard/icon", name: section.icon_name %>
      <h2 id="section-<%= section.key %>-heading"
          class="text-xl font-semibold text-olive-800 dark:text-[#e8ede3]"
          style="font-family: 'Instrument Serif', serif;">
        <%= section.label %>
      </h2>
    </div>

    <% if section.weekly_plan_section.done? %>
      <span class="inline-flex items-center rounded-full bg-seafoam-100 px-2.5 py-0.5 text-xs font-medium text-seafoam-800 dark:bg-seafoam-900/30 dark:text-seafoam-300">Done</span>
    <% elsif section.weekly_plan_section.skipped? %>
      <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 dark:bg-white/10 dark:text-gray-400">Skipped</span>
    <% end %>
  </div>

  <div class="p-4 flex-1 flex flex-col gap-3">
    <% if section.empty? %>
      <p class="text-sm text-gray-400 dark:text-gray-600 italic"><%= section.empty_body %></p>
      <%= link_to section.cta_label, section.cta_path,
                  class: "mt-auto self-start inline-flex items-center gap-x-2 rounded-md bg-[#5f734c] px-3.5 py-2 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:shadow-none dark:hover:bg-[#5f734c]" %>
    <% else %>
      <p class="text-base font-medium text-gray-900 dark:text-white"><%= section.summary_line %></p>
      <% if section.detail_line %>
        <p class="text-sm text-gray-600 dark:text-gray-400"><%= section.detail_line %></p>
      <% end %>
      <%= link_to "Edit #{section.label.downcase}", section.step_path,
                  class: "mt-auto self-start text-sm font-medium text-[#5f734c] dark:text-[#7a8f62] hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] rounded" %>
    <% end %>
  </div>
</section>
