<% content_for :title, "Dashboard" %>

<div class="w-full">
  <div class="sm:flex sm:items-center sm:justify-between mb-8">
    <div>
      <%# "ThisWeek" / "NextWeek" / "LastWeek" — or "Week of Oct 26" further out. %>
      <% offset = (@week_start - Date.current.beginning_of_week).to_i / 7 %>
      <% lead, rest = { 0 => %w[This Week], 1 => %w[Next Week], -1 => %w[Last Week] }.fetch(offset) { [ "Week", " of #{@week_start.strftime('%b %-d')}" ] } %>
      <h1 class="text-5xl tracking-tight text-olive-800 dark:text-[#e8ede3]">
        <span class="text-[#5f734c]" style="font-family: 'Instrument Serif', serif;"><%= lead %><span class="text-olive-800 dark:text-[#e8ede3]"><%= rest %></span></span>
      </h1>
      <p class="mt-2 text-sm text-gray-700 dark:text-gray-400">
        Week of <%= @week_start.strftime("%b %-d, %Y") %>
      </p>
    </div>

    <div class="mt-4 sm:ml-16 sm:mt-0 flex flex-wrap gap-2">
      <%# Printing is read-only, so every member gets it — for the week shown.
          The print page can step to any other week. %>
      <%= link_to new_week_print_path(week: @week_start), class: "inline-flex items-center gap-x-2 rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:inset-ring-white/5 dark:hover:bg-white/20" do %>
        <svg viewBox="0 0 20 20" fill="currentColor" class="-ml-0.5 size-5" aria-hidden="true"><path fill-rule="evenodd" d="M5 2.75C5 1.784 5.784 1 6.75 1h6.5c.966 0 1.75.784 1.75 1.75v3.552c.377.046.752.097 1.126.153A2.212 2.212 0 0 1 18 8.653v4.097A2.25 2.25 0 0 1 15.75 15h-.241l.305 1.984A1.75 1.75 0 0 1 14.084 19H5.915a1.75 1.75 0 0 1-1.73-2.016L4.492 15H4.25A2.25 2.25 0 0 1 2 12.75V8.653c0-1.082.775-2.034 1.874-2.198.374-.056.75-.107 1.127-.153L5 6.25v-3.5Zm8.5 3.397a41.533 41.533 0 0 0-7 0V2.75a.25.25 0 0 1 .25-.25h6.5a.25.25 0 0 1 .25.25v3.397ZM6.608 12.5a.25.25 0 0 0-.247.212l-.693 4.5a.25.25 0 0 0 .247.288h8.17a.25.25 0 0 0 .246-.288l-.692-4.5a.25.25 0 0 0-.247-.212H6.608Z" clip-rule="evenodd" /></svg>
        <%= @this_week ? "Print this week's plan" : "Print plan for week of #{@week_start.strftime('%b %-d')}" %>
      <% end %>
      <% if household_admin? && !@nothing_planned %>
        <%= link_to "Plan #{WeeklyPlan.week_label(@next_week_to_plan).downcase_first}", plan_week_path(week: @next_week_to_plan),
                    class: "inline-flex items-center gap-x-2 rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:inset-ring-white/5 dark:hover:bg-white/20" %>
      <% end %>
    </div>
  </div>

  <%# Week navigation — the same as the meal planner's; the whole page follows. %>
  <% nav = "inline-flex items-center gap-x-2 rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:shadow-none dark:hover:bg-[#5f734c]" %>
  <div class="mb-8 flex items-center justify-between gap-2">
    <%= link_to dashboard_path(date: (@week_start - 1.week).iso8601), class: nav do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="-ml-0.5 size-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
      </svg>
      <span class="hidden sm:inline">Previous Week</span>
      <span class="sm:hidden">Prev</span>
    <% end %>

    <span class="text-sm font-medium text-gray-700 dark:text-gray-300 sm:hidden">
      <%= @week_start.strftime("%b %d") %> – <%= (@week_start + 6.days).strftime("%b %d") %>
    </span>

    <%= link_to dashboard_path(date: (@week_start + 1.week).iso8601), class: nav do %>
      <span class="hidden sm:inline">Next Week</span>
      <span class="sm:hidden">Next</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="-ml-0.5 size-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>
    <% end %>
  </div>

  <% if @unfinished_plan %>
    <div class="mb-6 flex flex-col gap-3 rounded-lg border border-[#5f734c]/30 bg-[#5f734c]/5 px-4 py-3 sm:flex-row sm:items-center sm:justify-between dark:border-[#7a8f62]/30 dark:bg-[#7a8f62]/10">
      <p class="text-sm text-gray-700 dark:text-gray-300">
        You're partway through planning
        <span class="font-medium text-gray-900 dark:text-white"><%= @unfinished_plan.week_label.downcase_first %></span>
        (<%= @unfinished_plan.week_range_label %>). Next up is
        <%= Dashboard.section_class(@unfinished_plan.active_key)::LABEL.downcase %>.
      </p>
      <%= link_to "Continue planning", plan_week_path(week: @unfinished_plan.week_start),
                  class: "inline-flex shrink-0 items-center justify-center rounded-md bg-[#5f734c] px-3.5 py-2 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:shadow-none dark:hover:bg-[#5f734c]" %>
    </div>
  <% end %>

  <% if @nothing_planned %>
    <div class="mb-8 rounded-lg bg-[#3f4d34] dark:bg-[#2a3322] px-6 py-8 sm:px-10 sm:py-10 text-center">
      <h2 class="text-3xl text-white" style="font-family: 'Instrument Serif', serif;">Nothing planned for <%= @week_phrase %> yet</h2>
      <p class="mt-2 text-sm text-[#d7e0cd]">
        <%= household_admin? ? "Walk through #{@planned_steps.to_sentence} in a few minutes." : "Your household admin hasn't planned #{@week_phrase} yet." %>
      </p>
      <% if household_admin? && @plannable %>
      <%= link_to "Plan your week", plan_week_path(week: @week_start),
                  class: "mt-6 inline-flex items-center gap-x-2 rounded-md bg-white px-4 py-2.5 text-sm font-semibold text-[#3f4d34] shadow-xs hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" %>
      <% end %>
    </div>
  <% elsif @everything_done && household_admin? %>
    <p class="mb-6 text-sm text-gray-600 dark:text-gray-400">
      <%= @week_phrase.upcase_first %> is fully planned.
      <% if @plannable %><%= link_to "Reopen the plan", plan_week_path(week: @week_start), class: "text-[#5f734c] dark:text-[#7a8f62] font-medium hover:underline" %> to make a change.<% end %>
    </p>
  <% end %>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <% @sections.each do |section| %>
      <%= render "dashboard/section_card", section: section %>
    <% end %>
  </div>
</div>
