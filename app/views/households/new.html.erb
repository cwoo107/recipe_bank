<div class="mx-auto max-w-md">
  <p class="text-xs font-semibold uppercase tracking-widest text-sage-400 dark:text-gray-400">Getting started</p>
  <h1 class="mt-1 font-serif text-3xl text-sage-900 dark:text-[#e8ede3]">Set up your household</h1>
  <p class="mt-3 text-sm leading-relaxed text-olive-500 dark:text-gray-400">
    Your household is where you'll invite family members and share meal plans,
    recipes, and grocery lists.
  </p>

  <div class="mt-6 rounded-xl border border-sage-100 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-[#1a1f16]">
    <%= render "form", household: @household %>
  </div>
</div>
