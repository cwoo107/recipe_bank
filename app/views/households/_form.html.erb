<%# locals: (household:) %>
<%= form_with model: household, url: household_path, method: household.persisted? ? :patch : :post, class: "space-y-5" do |f| %>

  <% if household.errors.any? %>
    <div class="rounded-xl border border-dusty-rose-200 bg-dusty-rose-50 px-4 py-3 dark:border-dusty-rose-800/60 dark:bg-dusty-rose-900/20">
      <ul class="list-inside list-disc text-sm text-dusty-rose-700 dark:text-dusty-rose-300">
        <% household.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :family_name, class: "block text-sm font-medium text-gray-900 dark:text-white mb-2" %>
    <%= f.text_field :family_name, class: "block w-full rounded-lg bg-white dark:bg-white/5 px-3 py-2.5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 focus:border-[#5f734c] dark:focus:border-[#7a8f62] focus:ring-2 focus:ring-[#5f734c]/20 dark:focus:ring-[#7a8f62]/20 outline-none transition", placeholder: "e.g. Anderson" %>
    <p class="mt-1.5 text-xs text-olive-400 dark:text-gray-500">Shown as "The <%= household.family_name.presence || "Anderson" %> household".</p>
  </div>

  <div>
    <%= f.label :family_size, class: "block text-sm font-medium text-gray-900 dark:text-white mb-2" %>
    <%= f.number_field :family_size, min: 1, class: "block w-full rounded-lg bg-white dark:bg-white/5 px-3 py-2.5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 focus:border-[#5f734c] dark:focus:border-[#7a8f62] focus:ring-2 focus:ring-[#5f734c]/20 dark:focus:ring-[#7a8f62]/20 outline-none transition" %>
    <p class="mt-1.5 text-xs text-olive-400 dark:text-gray-500">How many people eat at home, whether or not they have an account. Used as the default servings for new meals and on recipes.</p>
  </div>

  <div>
    <%= f.label :minutes_per_day, "Minutes per day for to-dos", class: "block text-sm font-medium text-gray-900 dark:text-white mb-2" %>
    <%= f.number_field :minutes_per_day, min: 1, class: "block w-full rounded-lg bg-white dark:bg-white/5 px-3 py-2.5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 focus:border-[#5f734c] dark:focus:border-[#7a8f62] focus:ring-2 focus:ring-[#5f734c]/20 dark:focus:ring-[#7a8f62]/20 outline-none transition", placeholder: "30" %>
    <p class="mt-1.5 text-xs text-olive-400 dark:text-gray-500">How much time your household typically has each day to work on to-dos. Used to schedule and order to-do dates.</p>
  </div>

  <div>
    <%= f.label :week_start_day, "Week starts on", class: "block text-sm font-medium text-gray-900 dark:text-white mb-2" %>
    <%= f.select :week_start_day, Household.week_start_day_options, {}, class: "block w-full rounded-lg bg-white dark:bg-white/5 px-3 py-2.5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 focus:border-[#5f734c] dark:focus:border-[#7a8f62] focus:ring-2 focus:ring-[#5f734c]/20 dark:focus:ring-[#7a8f62]/20 outline-none transition" %>
    <p class="mt-1.5 text-xs text-olive-400 dark:text-gray-500">Every week in your household — meals, chores, plans, grocery lists and the calendar — runs from this day. Changing it moves this week's and future chore charts, weekly plans and grocery lists onto the new weeks.</p>
  </div>

  <div>
    <%= f.label :time_zone, "Time zone", class: "block text-sm font-medium text-gray-900 dark:text-white mb-2" %>
    <%= f.select :time_zone, Household.time_zone_options(household.time_zone), { include_blank: "Not set" },
          class: "block w-full rounded-lg bg-white dark:bg-white/5 px-3 py-2.5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 focus:border-[#5f734c] dark:focus:border-[#7a8f62] focus:ring-2 focus:ring-[#5f734c]/20 dark:focus:ring-[#7a8f62]/20 outline-none transition" %>
    <p class="mt-1.5 text-xs text-olive-400 dark:text-gray-500">Used for everyone's calendar and schedule, and for syncing calendars. Set from your browser the first time you signed in.</p>
  </div>

  <div class="pt-2">
    <%= f.submit household.persisted? ? "Save changes" : "Create household", class: "rounded-lg px-6 py-2.5 bg-[#5f734c] hover:bg-[#4b5a3d] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c] text-white font-medium cursor-pointer transition shadow-sm" %>
  </div>
<% end %>
