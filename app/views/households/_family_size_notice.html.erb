<%# Offered after the family size changes: carry it over to upcoming shared
    meals (see FamilySizeChange). locals: (change:) %>
<% meals, rules = change.upcoming_meals.size, change.upcoming_recurring_meals.size %>
<% direction = change.delta.positive? ? "add #{pluralize(change.delta, 'serving')} to" : "take #{pluralize(-change.delta, 'serving')} off" %>
<div id="family_size_notice" data-controller="dismissible"
     class="mt-6 rounded-lg border border-honey-200 bg-honey-50 px-4 py-3 text-sm text-gray-800 dark:border-honey-800/60 dark:bg-honey-900/20 dark:text-gray-200">
  <p>
    Your family size changed from <span class="font-medium"><%= change.from %></span> to <span class="font-medium"><%= change.to %></span>.
    Adjust the meals already planned for the whole family?
  </p>
  <p class="mt-1 text-xs text-gray-600 dark:text-gray-400">
    This will <%= direction %>
    <%= [ (pluralize(meals, "upcoming shared meal") if meals.positive?),
          (pluralize(rules, "recurring meal") if rules.positive?) ].compact.to_sentence %>.
    Past meals and meals assigned to specific people stay as they are.
  </p>

  <div class="mt-3 flex items-center gap-2">
    <%= button_to "Yes, adjust meals", adjust_servings_household_path, method: :patch,
          params: { from: change.from, to: change.to },
          class: "rounded-md bg-[#5f734c] px-3 py-1.5 text-xs font-semibold text-white hover:bg-[#4b5a3d] cursor-pointer dark:bg-[#7a8f62] dark:hover:bg-[#5f734c]" %>
    <button type="button" data-action="dismissible#dismiss"
            class="rounded-md px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-black/5 cursor-pointer dark:text-gray-400 dark:hover:bg-white/10">
      No thanks
    </button>
  </div>
</div>
