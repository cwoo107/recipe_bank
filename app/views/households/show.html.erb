<% content_for :title, "Household" %>
<%# Once a trial runs out, this page is all that's left open — just billing
    and the recipe export until someone picks a plan. %>
<% locked = household_locked? %>

<div class="mx-auto max-w-6xl">
  <div class="flex items-end justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-sage-400 dark:text-gray-400">Household</p>
      <h1 class="mt-1 font-serif text-4xl text-sage-900 dark:text-[#e8ede3]">
        The <%= @household.family_name %> household
      </h1>
    </div>
  </div>

  <% unless locked %>
  <% if flash[:family_size_change] && @household.admin?(current_user) %>
    <%= render "households/family_size_notice",
               change: FamilySizeChange.new(@household, from: flash[:family_size_change]["from"], to: flash[:family_size_change]["to"]) %>
  <% end %>

  <%= turbo_frame_tag "household_members" do %>
    <%= render "household_members/list" %>
  <% end %>

  <%# Household settings — editable by admins, read-only for everyone else. %>
  <div id="household_settings" class="mt-8 overflow-hidden rounded-xl border border-sage-100 bg-white shadow-sm dark:border-white/10 dark:bg-[#1a1f16]">
    <div class="px-5 py-4">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-sage-400 dark:text-gray-400">Settings</h2>
    </div>

    <div class="border-t border-sage-100 px-5 py-8 sm:px-8 dark:border-white/10">
      <% if @household.admin?(current_user) %>
        <%= render "form", household: @household %>
      <% else %>
        <%# Read-only, in the same sections as the admins' form. %>
        <% term = "text-sm/6 text-gray-600 dark:text-gray-400" %>
        <% value = "mt-1 text-sm/6 font-medium text-gray-900 dark:text-white" %>
        <div class="space-y-10">
          <% [
               [ "Household", [ [ "Family name", @household.family_name ], [ "Family size", @household.family_size ] ] ],
               [ "Schedule",  [ [ "Week starts on", @household.week_start_day_name ],
                                [ "Time zone", @household.time_zone&.tr("_", " ") || "Not set" ],
                                [ "Time for to-dos", "#{@household.minutes_per_day} min / day" ] ] ],
               [ "Weekly planner", [ [ "Steps", @household.planner_section_keys.map { |key| Dashboard.section_class(key)::LABEL }.to_sentence ] ] ]
             ].each do |heading, rows| %>
            <div class="border-b border-gray-900/10 pb-10 last:border-b-0 last:pb-0 dark:border-white/10">
              <h3 class="text-base/7 font-semibold text-gray-900 dark:text-white"><%= heading %></h3>
              <dl class="mt-4 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-3">
                <% rows.each do |label, shown| %>
                  <div>
                    <dt class="<%= term %>"><%= label %></dt>
                    <dd class="<%= value %>"><%= shown %></dd>
                  </div>
                <% end %>
              </dl>
            </div>
          <% end %>
        </div>
        <p class="mt-8 text-xs text-olive-400 dark:text-gray-500">Only household admins can change these.</p>
      <% end %>
    </div>
  </div>
  <% end %>

  <%= render "households/billing", household: @household %>

  <% if @household.owner?(current_user) %>
    <%# The owner's copy of every recipe the household has created — always
        available, subscribed or not (RecipeExportsController). %>
    <div id="recipe_export" class="mt-8 rounded-xl border border-sage-100 bg-white p-6 shadow-sm dark:border-white/10 dark:bg-[#1a1f16]">
      <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Export recipes</h2>
      <p class="mt-1 text-sm text-olive-500 dark:text-gray-400">
        Download a PDF of every recipe your household's members have created.
      </p>
      <%= link_to "Download recipes (PDF)", household_recipe_export_path(format: :pdf), data: { turbo: false },
            class: "mt-4 inline-flex rounded-lg px-3 py-1.5 text-sm border border-sage-200 bg-white font-medium text-gray-900 hover:bg-sage-50 transition dark:border-white/10 dark:bg-white/5 dark:text-white dark:hover:bg-white/10" %>
    </div>

    <% unless locked %>
    <div class="mt-8 rounded-xl border border-dusty-rose-200 bg-white p-6 shadow-sm dark:border-dusty-rose-900/60 dark:bg-[#1a1f16]">
      <h2 class="text-sm font-semibold text-dusty-rose-800 dark:text-dusty-rose-300">Danger zone</h2>
      <p class="mt-1 text-sm text-olive-500 dark:text-gray-400">
        Deleting the household removes all members. This can't be undone.
      </p>
      <%= button_to "Delete household", household_path, method: :delete,
            data: { turbo_confirm: "Delete the household and remove all members?" },
            class: "mt-4 rounded-lg px-3 py-1.5 text-sm border border-dusty-rose-200 bg-dusty-rose-50 font-medium text-dusty-rose-700 hover:bg-dusty-rose-100 cursor-pointer transition dark:border-dusty-rose-800 dark:bg-dusty-rose-900/20 dark:text-dusty-rose-300 dark:hover:bg-dusty-rose-900/40" %>
    </div>
    <% end %>
  <% end %>
</div>
