<% content_for :title, "Household" %>

<div class="mx-auto max-w-6xl">
  <div class="flex items-end justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-sage-400">Household</p>
      <h1 class="mt-1 font-serif text-4xl text-sage-900">
        The <%= @household.family_name %> household
      </h1>
    </div>
    <% if @household.admin?(current_user) %>
      <%= link_to "Settings", edit_household_path,
            class: "rounded-lg px-4 py-2.5 bg-white dark:bg-white/5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 hover:bg-gray-50 dark:hover:bg-white/10 font-medium transition" %>
    <% end %>
  </div>

  <%= turbo_frame_tag "household_members" do %>
    <%= render "household_members/list" %>
  <% end %>

  <p class="mt-4 text-sm text-olive-500">
    Members sign in with their own email and password. Admins have the same level of
    control as the owner.
  </p>
</div>
