<div class="mx-auto max-w-md">
  <p class="text-xs font-semibold uppercase tracking-widest text-sage-400">Household</p>
  <h1 class="mt-1 font-serif text-3xl text-sage-900">Household settings</h1>

  <div class="mt-6 rounded-xl border border-sage-100 bg-white p-6 shadow-sm">
    <%= render "form", household: @household %>
  </div>

  <% if @household.owner?(current_user) %>
    <div class="mt-6 rounded-xl border border-dusty-rose-200 bg-white p-6 shadow-sm">
      <h2 class="text-sm font-semibold text-dusty-rose-800">Danger zone</h2>
      <p class="mt-1 text-sm text-olive-500">
        Deleting the household removes all members. This can't be undone.
      </p>
      <%= button_to "Delete household", household_path, method: :delete,
            data: { turbo_confirm: "Delete the household and remove all members?" },
            class: "mt-4 rounded-lg px-3 py-1.5 text-sm border border-dusty-rose-200 bg-dusty-rose-50 font-medium text-dusty-rose-700 hover:bg-dusty-rose-100 cursor-pointer transition" %>
    </div>
  <% end %>
</div>
