<% content_for :title, "Chore Chart" %>

<div class="w-full">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-5xl tracking-tight text-olive-800 dark:text-[#e8ede3]">
        <span class="text-[#5f734c]" style="font-family: 'Instrument Serif', serif;">Chore<span class="text-olive-800 dark:text-[#e8ede3]">Chart</span></span>
      </h1>
      <p class="mt-2 text-sm text-gray-700 dark:text-gray-400">
        <% if @view == "table" %>
          <% if @filters.any? %>
            <%= @chores.size %> of <%= pluralize(@total, "recurring chore") %>
          <% else %>
            <%= pluralize(@chores.size, "recurring chore") %>
          <% end %>
        <% else %>
          Week of <%= @week_start.strftime("%b %-d, %Y") %>
        <% end %>
      </p>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0 flex flex-wrap items-center gap-2">
      <%# The week's chart (in the print plan's default, landscape) — from
          either view. %>
      <%= render "shared/print_button", url: week_section_pdf_path("chores", @week_start), label: "Print chore chart" %>
      <%= link_to chore_templates_path,
                  class: "inline-flex items-center gap-x-2 rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-inset ring-gray-300 hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:ring-white/10 dark:hover:bg-white/20" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="-ml-0.5 size-5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0-5.571 3-5.571-3" />
        </svg>
        Templates
      <% end %>
    <% if household_admin? %>
        <%= link_to new_chore_path(return_to: request.fullpath),
                    class: "inline-flex items-center gap-x-2 rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:shadow-none dark:hover:bg-[#5f734c]" do %>
          <svg viewBox="0 0 20 20" fill="currentColor" class="-ml-0.5 size-5" aria-hidden="true">
            <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
          </svg>
          New chore
        <% end %>
    <% end %>
    </div>
  </div>

  <%# Week View / Table View. Switching keeps the week being looked at. %>
  <% view_tab = "inline-flex items-center rounded-md px-3 py-1.5 text-sm font-medium transition-colors" %>
  <nav class="mt-6 inline-flex rounded-lg bg-gray-100 dark:bg-white/5 p-1 gap-1" aria-label="Chore Chart view">
    <% { "week" => "Week View", "table" => "Table View" }.each do |view, label| %>
      <%= link_to label, weekly_chores_path(view: (view unless view == "week"), date: (@week_start.iso8601 if params[:date].present?)),
            aria: { current: (@view == view ? "page" : nil) },
            class: "#{view_tab} #{@view == view ? 'bg-white text-gray-900 shadow-xs dark:bg-white/15 dark:text-white' : 'text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white'}" %>
    <% end %>
  </nav>

  <%# A new household's chart starts empty — point it at the template library. %>
  <% if household_admin? && current_household.chores.none? %>
    <div id="chore_templates_prompt" class="mt-6 rounded-lg border-2 border-dashed border-gray-200 dark:border-white/10 p-6 text-center">
      <h2 class="text-base font-semibold text-gray-900 dark:text-white">Get started with a template</h2>
      <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
        Pick from ready-made categories like Standard Cleaning, Deep Cleaning and Admin, or add your own chores.
      </p>
      <%= link_to "Browse chore templates", chore_templates_path,
                  class: "mt-4 inline-flex items-center rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] dark:bg-[#7a8f62] dark:shadow-none dark:hover:bg-[#5f734c]" %>
    </div>
  <% end %>

  <% if @view == "table" %>
    <div class="mt-6">
      <%= render "chores/table", chores: @chores, categories: @categories, sort: @sort, direction: @direction, filters: @filters %>
    </div>
  <% else %>
  <div class="mt-6 mb-8">
    <div class="flex items-center justify-between mb-4 gap-2">
      <%= link_to weekly_chores_path(date: @week_start - 1.week),
                  class: "inline-flex items-center gap-x-2 rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:shadow-none dark:hover:bg-[#5f734c]" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="-ml-0.5 size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        <span class="hidden sm:inline">Previous Week</span>
        <span class="sm:hidden">Prev</span>
      <% end %>

      <span class="text-sm font-medium text-gray-700 dark:text-gray-300 sm:hidden">
        <%= @week_start.strftime("%b %d") %> – <%= (@week_start + 6.days).strftime("%b %d") %>
      </span>

      <%= link_to weekly_chores_path(date: @week_start + 1.week),
                  class: "inline-flex items-center gap-x-2 rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:shadow-none dark:hover:bg-[#5f734c]" do %>
        <span class="hidden sm:inline">Next Week</span>
        <span class="sm:hidden">Next</span>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="-ml-0.5 size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      <% end %>
    </div>
  </div>

  <section class="rounded-lg border border-gray-200 dark:border-white/10 bg-[var(--ivory)] dark:bg-[#1a1f16] overflow-hidden">

    <%= render "weekly_chores/due_soon_board", weekly_chores: @weekly_chores, week_start: @week_start,
                                               categories: @categories, due_chores: @due_chores %>
  </section>
  <% end %>
</div>
