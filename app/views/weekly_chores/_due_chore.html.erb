<%# locals: (chore:, week_start:) %>
<%# A card in the board's "Coming up" strip.
    Draggable onto a day on desktop (see chore_board_controller.js) — into
    another category's row re-files it, after a confirmation. Phones can't
    drag, so they get an "Add to this week" button that asks which day. %>
<% due_on = chore.next_due_on %>
<div id="due_chore_<%= chore.id %>"
     data-chore-id="<%= chore.id %>"
     data-category-key="<%= chore_board_category_key(chore) %>"
     data-chore-name="<%= chore.name %>"
     title="<%= chore_card_assignee_label(chore.assignee) %>"
     class="chore-card group relative flex items-center justify-between gap-3 rounded-md border <%= chore_card_color_classes(chore.assignee) %> px-3 py-2 shadow-sm sm:w-64 <%= 'cursor-grab active:cursor-grabbing' if household_admin? %>">

  <%# Drag handle (invisible but full-width, class used by chore_board_controller.js) %>
  <div class="sortable-handle absolute inset-0 rounded-md" aria-hidden="true"></div>

  <div class="relative z-10 pointer-events-none min-w-0">
    <p class="text-sm font-medium text-gray-900 dark:text-white leading-snug">
      <%= chore.name %>
      <span class="sr-only">· <%= chore_card_assignee_label(chore.assignee) %></span>
    </p>
    <div class="mt-1 flex items-center gap-1.5 flex-wrap">
      <%= render "chores/frequency_pill", chore: chore, small: true %>
      <span class="text-[11px] <%= chore_due_label_classes(due_on) %>"><%= chore.last_completed_at ? chore_due_label(due_on) : "Never done" %></span>
    </div>
  </div>

  <% if household_admin? %>
    <%# Phone-only: pick the day in a prompt styled like the other app alerts
        (see weekly_chores/_move_dialog.html.erb). Adding the chore removes
        this card — and the dialog with it — via create.turbo_stream.erb. %>
    <div class="sm:hidden relative z-10 shrink-0" data-controller="dialog" data-action="click->dialog#backdropClose">
      <dialog data-dialog-target="dialog" class="dark:bg-[#1a1f16] w-11/12 sm:w-96 rounded-lg p-6 shadow-xl backdrop:bg-black/50 m-auto">
        <h3 class="text-base font-semibold text-gray-900 dark:text-white">Which day?</h3>
        <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">
          <%= chore.name %> · week of <%= week_start.strftime("%b %-d") %>
        </p>

        <div class="mt-5 flex flex-col gap-2">
          <% (0..6).map { |i| week_start + i }.each do |day| %>
            <%= button_to weekly_chores_path(chore_id: chore.id, week_start: week_start, scheduled_date: day.iso8601),
                  method: :post,
                  class: "w-full flex items-center justify-between rounded-lg px-4 py-2.5 bg-[#5f734c]/10 hover:bg-[#5f734c]/20 dark:bg-[#7a8f62]/15 dark:hover:bg-[#7a8f62]/25 text-gray-900 dark:text-white text-sm font-medium cursor-pointer transition" do %>
              <span><%= day.strftime("%A") %></span>
              <span class="text-xs <%= day == Date.current ? 'font-semibold text-[#5f734c] dark:text-[#a3b88a]' : 'text-gray-500 dark:text-gray-400' %>">
                <%= day == Date.current ? "Today" : day.strftime("%b %-d") %>
              </span>
            <% end %>
          <% end %>
          <button type="button" data-action="dialog#close"
                  class="w-full rounded-lg px-4 py-2.5 bg-gray-200 hover:bg-gray-300 dark:bg-white/10 dark:hover:bg-white/20 text-gray-900 dark:text-white text-sm font-medium cursor-pointer transition">
            Cancel
          </button>
        </div>
      </dialog>

      <button type="button" data-action="dialog#open"
              aria-label="Add <%= chore.name %> to this week"
              class="inline-flex items-center rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:inset-ring-white/5 dark:hover:bg-white/20 cursor-pointer">
        Add to this week
      </button>
    </div>
  <% end %>
</div>
