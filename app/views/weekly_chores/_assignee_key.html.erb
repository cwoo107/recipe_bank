<%# The key for the Chore Chart's assignee colors: chore cards are tinted by
    who they're assigned to (ChoresHelper#chore_card_color_classes) rather
    than carrying a name pill. Each swatch is a mini card in that color. %>
<% people = current_household.people %>
<% if current_household.assignable? && people.any? %>
  <div class="px-4 py-2 border-b border-gray-200 dark:border-white/10 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs text-gray-600 dark:text-gray-300" aria-label="Who each card color belongs to">
    <span class="font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Key</span>
    <% people.each do |person| %>
      <span class="inline-flex items-center gap-1.5">
        <span class="inline-block size-3.5 rounded border <%= chore_card_color_classes(person) %>" aria-hidden="true"></span>
        <%= person.name %>
      </span>
    <% end %>
    <span class="inline-flex items-center gap-1.5">
      <span class="inline-block size-3.5 rounded border <%= chore_card_color_classes(nil) %>" aria-hidden="true"></span>
      Unassigned
    </span>
  </div>
<% end %>
