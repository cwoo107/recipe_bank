<%# locals: (weekly_chores:, week_start:, rows:) %>
<%# Desktop grid: a row per
    chore category (see ChoresHelper#chore_board_rows), a column per day.
    Each row is its own grid (sharing the header's column template) so the
    rows can be drag-reordered as whole units — see
    chore_board_controller.js. "Uncategorized" sits outside the sortable
    list, always last. %>
<%
  grouped  = weekly_chores.group_by { |wc| [ wc.scheduled_date, chore_board_category_key(wc.chore) ] }
  days     = (0..6).map { |i| week_start + i }
  columns  = "grid-template-columns: 8rem repeat(7, minmax(0, 1fr));"
  sortable, fixed = rows.partition { |_key, _name, category| category }
%>
<div class="hidden sm:block p-3 overflow-x-auto">
  <div class="min-w-[48rem] flex flex-col gap-1.5">
    <div class="grid gap-1.5" style="<%= columns %>">
      <div></div>
      <% days.each do |day| %>
        <% is_today = day == Date.current %>
        <h3 class="text-[11px] font-semibold px-1.5 py-0.5 <%= is_today ? 'bg-[#5f734c] text-white dark:bg-[#7a8f62] rounded' : 'text-gray-500 dark:text-gray-400' %>">
          <%= day.strftime("%a %-d") %>
        </h3>
      <% end %>
    </div>

    <% row_locals = { days: days, grouped: grouped, columns: columns } %>
    <div data-chore-board-target="rows" class="flex flex-col gap-1.5">
      <% sortable.each do |key, name, category| %>
        <%= render "weekly_chores/board_row", key: key, name: name, category: category, **row_locals %>
      <% end %>
    </div>
    <% fixed.each do |key, name, category| %>
      <%= render "weekly_chores/board_row", key: key, name: name, category: category, **row_locals %>
    <% end %>

    <% if household_admin? %>
      <%= render "weekly_chores/add_category_tile" %>
    <% end %>
  </div>
</div>
