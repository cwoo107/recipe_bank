<%# locals: (weekly_chores:, week_start:) %>
<%
  grouped = weekly_chores.group_by(&:scheduled_date)
  days    = (0..6).map { |i| week_start + i }
%>
<div class="hidden sm:block p-3">
  <div class="grid grid-cols-7 gap-2">
    <% days.each do |day| %>
      <% is_today = day == Date.current %>
      <div class="min-w-0 flex flex-col rounded-md border p-1.5 <%= is_today ? 'border-[#5f734c] dark:border-[#7a8f62] bg-[#5f734c]/5 dark:bg-[#7a8f62]/10' : 'border-gray-200 dark:border-white/10' %>">

        <h3 class="text-[11px] font-semibold px-1 pb-1 mb-1 <%= is_today ? 'bg-[#5f734c] text-white dark:bg-[#7a8f62] rounded' : 'text-gray-500 dark:text-gray-400' %>">
          <%= day.strftime("%a %-d") %>
        </h3>
        <div id="weekly_chores_day_desktop_<%= day.iso8601 %>"
             data-chore-board-target="column" data-date="<%= day.iso8601 %>"
             class="flex flex-col gap-1.5 min-h-32">
          <% (grouped[day] || []).each do |weekly_chore| %>
            <%= render "weekly_chores/weekly_chore", weekly_chore: weekly_chore %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
