<%# locals: (weekly_chore:) %>
<% chore = weekly_chore.chore %>
<div id="weekly_chore_<%= weekly_chore.id %>"
     data-weekly-chore-id="<%= weekly_chore.id %>"
     data-category-key="<%= chore_board_category_key(chore) %>"
     data-recurring="<%= chore.recurring? %>"
     data-chore-name="<%= chore.name %>"
     data-frequency-label="<%= chore.frequency_label %>"
     data-controller="chore-item"
     title="<%= chore_card_assignee_label(weekly_chore.assignee) %>"
     class="chore-card weekly-chore-<%= weekly_chore.id %> group relative rounded-md border <%= chore_card_color_classes(weekly_chore.assignee) %> p-2 shadow-sm hover:shadow-md transition-shadow cursor-grab active:cursor-grabbing">

  <%# Drag handle (invisible but full-width, class used by chore_board_controller.js).
      Dragging the card back up into "Coming up" takes it off this week. %>
  <div class="sortable-handle absolute inset-0 rounded-md cursor-grab active:cursor-grabbing" aria-hidden="true"></div>

  <%# Only the checkbox opts back into pointer events — the
      rest of the card (including the name/assignee text) stays part of the
      drag-handle hit area underneath, matching todos/_todo.html.erb. %>
  <div class="relative z-10 pointer-events-none flex flex-col gap-1">
    <div class="flex items-start gap-1.5 min-w-0">
      <%# Admins can tick any chore; limited members only the ones assigned to them. %>
      <% if weekly_chore_completable?(weekly_chore) %>
        <%= form_with model: weekly_chore, url: weekly_chore_path(weekly_chore), method: :patch,
              class: "pointer-events-auto mt-0.5 shrink-0", data: { chore_item_target: "form", format: :turbo_stream } do |f| %>
          <%= f.check_box :completed,
                data: { action: "change->chore-item#toggleCheck" },
                style: "accent-color: #5f734c;",
                class: "size-4 rounded border-gray-300 focus:ring-[#5f734c] dark:border-gray-600" %>
        <% end %>
      <% else %>
        <input type="checkbox" disabled <%= "checked" if weekly_chore.completed? %> aria-label="<%= weekly_chore.completed? ? "Done" : "Not done" %>"
               style="accent-color: #5f734c;" class="mt-0.5 size-4 shrink-0 rounded border-gray-300 opacity-60 dark:border-gray-600">
      <% end %>
      <div class="min-w-0 flex-1">
        <%# No assignee pill (the card's color says who — see the page's key)
            and no frequency pill: once it's on the schedule, how often it
            comes around is self-evident. %>
        <p class="text-xs font-medium text-gray-900 dark:text-white leading-snug <%= 'line-through opacity-50' if weekly_chore.completed? %>">
          <%= chore.name %>
          <span class="sr-only">· <%= chore_card_assignee_label(weekly_chore.assignee) %></span>
        </p>
        <% if chore.chore_tasks.any? %>
          <ul class="mt-0.5 space-y-px text-[10px] leading-snug text-gray-600 dark:text-gray-300 <%= 'opacity-50' if weekly_chore.completed? %>"
              aria-label="Tasks">
            <% chore.chore_tasks.each do |task| %>
              <li class="break-words"><span aria-hidden="true" class="text-gray-400 dark:text-gray-500">•</span> <%= task.name %></li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>
  </div>
</div>
