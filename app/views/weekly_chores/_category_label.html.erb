<%# locals: (name:, category:) %>
<%# A board row's heading. For admins (and real
    categories, not "Uncategorized") the name opens a dialog to rename or
    delete the category (chore_categories/edit.html.erb), and the heading is
    the handle for dragging the whole row up or down. %>
<% sortable = category && household_admin? %>
<div class="pr-1 pt-1.5 min-w-0 <%= 'category-row-handle cursor-grab active:cursor-grabbing rounded-md hover:bg-[#5f734c]/5 dark:hover:bg-[#7a8f62]/10' if sortable %>"
     <%= tag.attributes(title: ("Drag to reorder rows" if sortable)) %>>
  <% if category && household_admin? %>
    <div data-controller="dialog" data-action="click->dialog#backdropClose">
      <dialog data-dialog-target="dialog" class="dark:bg-[#1a1f16] w-11/12 sm:w-1/2 rounded-lg p-6 shadow-xl backdrop:bg-black/50">
        <%= turbo_frame_tag "edit_chore_category_#{category.id}", src: edit_chore_category_path(category, return_to: request.fullpath), loading: :lazy do %><% end %>
        <div class="mt-4">
          <button type="button" data-action="dialog#close"
                  class="rounded-lg px-6 py-2.5 bg-gray-200 hover:bg-gray-300 dark:bg-white/10 dark:hover:bg-white/20 text-gray-900 dark:text-white font-medium transition">
            Close
          </button>
        </div>
      </dialog>
      <button type="button" data-action="dialog#open" title="Rename or delete <%= category.name %>"
              class="text-left text-xs font-semibold text-olive-800 dark:text-[#e8ede3] leading-snug break-words hover:text-[#5f734c] dark:hover:text-[#7a8f62] hover:underline underline-offset-2 cursor-pointer">
        <%= name %>
      </button>
    </div>
  <% else %>
    <p class="text-xs font-semibold text-olive-800 dark:text-[#e8ede3] leading-snug break-words"><%= name %></p>
  <% end %>
</div>
