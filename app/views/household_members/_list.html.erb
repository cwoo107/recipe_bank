<div class="mt-8 overflow-hidden rounded-xl border border-sage-100 bg-white shadow-sm">

  <div class="flex items-center justify-between px-5 py-4">
    <h2 class="text-xs font-semibold uppercase tracking-widest text-sage-400">Members</h2>
    <% if @household.admin?(current_user) %>
      <%= link_to "Add member", new_household_member_path,
            class: "rounded-lg px-3 py-1.5 text-sm bg-white dark:bg-white/5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 hover:bg-gray-50 dark:hover:bg-white/10 font-medium transition" %>
    <% end %>
  </div>

  <ul class="divide-y divide-sage-100 border-t border-sage-100">
    <li class="flex items-center justify-between px-5 py-4">
      <div>
        <p class="font-medium text-sage-900"><%= @household.owner.email %></p>
        <span class="mt-1 inline-flex items-center rounded-full px-2 py-1 text-xs font-medium bg-sage-100 text-sage-700">Owner</span>
      </div>
    </li>

    <%= render @members %>
  </ul>
</div>
