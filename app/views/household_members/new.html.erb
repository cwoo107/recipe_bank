<%= turbo_frame_tag "household_members" do %>
  <div class="mt-8 overflow-hidden rounded-xl border border-sage-100 bg-white shadow-sm p-6 dark:border-white/10 dark:bg-[#1a1f16]">
    <p class="text-xs font-semibold uppercase tracking-widest text-sage-400 dark:text-gray-400">Household</p>
    <h2 class="mt-1 font-serif text-2xl text-sage-900 dark:text-[#e8ede3]">Add a member</h2>

    <div class="mt-6">
      <%= render "form", member: @member %>
    </div>
  </div>
<% end %>
