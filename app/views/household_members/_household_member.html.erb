<li id="<%= dom_id household_member %>" class="flex items-center justify-between px-5 py-4">
  <div>
    <p class="font-medium text-sage-900"><%= household_member.name %></p>
    <div class="mt-1 flex items-center gap-2">
      <% if household_member.user.nil? %>
        <span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-medium bg-taupe-100 text-taupe-700">No login</span>
      <% elsif household_member.admin? %>
        <span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-medium bg-honey-100 text-honey-800">Admin</span>
      <% else %>
        <span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-medium bg-mist-100 text-mist-700">Limited</span>
      <% end %>
      <% if household_member.user %>
        <span class="text-xs text-olive-400"><%= household_member.user.email %></span>
      <% end %>
    </div>
  </div>

  <% if @household.admin?(current_user) %>
    <div class="flex items-center gap-2">
      <%= link_to "Edit", edit_household_member_path(household_member),
                  class: "rounded-lg px-3 py-1.5 text-sm bg-white dark:bg-white/5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 hover:bg-gray-50 dark:hover:bg-white/10 font-medium transition" %>
      <%= button_to "Remove", household_member_path(household_member), method: :delete,
                    data: { turbo_confirm: "Remove #{household_member.name} and delete their login?" },
                    class: "rounded-lg px-3 py-1.5 text-sm border border-transparent font-medium text-dusty-rose-600 hover:bg-dusty-rose-50 transition cursor-pointer" %>
    </div>
  <% end %>
</li>