<div class="mx-auto max-w-2xl">
  <div class="flex items-end justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-sage-400">Household</p>
      <h1 class="mt-1 font-serif text-4xl text-sage-900">
        The <%= @household.family_name %> household
      </h1>
    </div>
    <% if @household.admin?(current_user) %>
      <%= link_to "Settings", edit_household_path, class: "btn-secondary" %>
    <% end %>
  </div>

  <div class="mt-8 overflow-hidden rounded-xl border border-sage-100 bg-white shadow-sm">
    <div class="flex items-center justify-between px-5 py-4">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-sage-400">Members</h2>
      <% if @household.admin?(current_user) %>
        <%= link_to "Manage members", household_members_path, class: "btn-secondary btn-sm" %>
      <% end %>
    </div>

    <ul class="divide-y divide-sage-100 border-t border-sage-100">
      <li class="flex items-center justify-between px-5 py-4">
        <p class="font-medium text-sage-900"><%= @household.owner.email %></p>
        <span class="badge bg-sage-100 text-sage-700">Owner</span>
      </li>
      <% @members.each do |member| %>
        <li class="flex items-center justify-between px-5 py-4">
          <p class="font-medium text-sage-900"><%= member.name %></p>
          <% if member.user.nil? %>
            <span class="badge bg-taupe-100 text-taupe-700">No login</span>
          <% elsif member.admin? %>
            <span class="badge bg-honey-100 text-honey-800">Admin</span>
          <% else %>
            <span class="badge bg-mist-100 text-mist-700">Limited</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
