<% content_for :title, "Also on your restock list?" %>

<%# Ticked pairs are linked; unticked ones are remembered as "not the same",
    so neither is asked about again. Laid out like the receipt review. %>
<div class="max-w-3xl mx-auto p-6">
  <%= link_to "← Back to grocery list", grocery_lists_path(date: @date),
              class: "text-sm font-medium text-[#5f734c] hover:text-[#4b5a3d] dark:text-[#7a8f62]" %>
  <h1 class="mt-2 text-3xl font-bold tracking-tight text-olive-800 dark:text-[#e8ede3] mb-6">Also on your restock list?</h1>

  <div class="rounded-lg border border-gray-200 bg-white p-4 sm:p-6 dark:border-white/10 dark:bg-white/5"
       data-controller="match-confirmation">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h3 class="text-base font-semibold text-gray-900 dark:text-white">Confirm restock matches</h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
          <%= pluralize(@suggestions.size, "grocery item") %> for the week of <%= @date.strftime("%b %d") %>
          <%= @suggestions.size == 1 ? "looks" : "look" %> like something on your restock list.
          Ticked ones will show on both lists, and checking one off checks off the other.
          Untick any that aren't the same — we'll remember and won't ask again.
        </p>
      </div>
      <div class="flex shrink-0 gap-2 text-sm">
        <button type="button" data-action="match-confirmation#checkAll"
                class="rounded-md px-2.5 py-1.5 font-medium text-[#5f734c] hover:bg-gray-50 dark:text-[#7a8f62] dark:hover:bg-white/10">
          Check all
        </button>
        <button type="button" data-action="match-confirmation#uncheckAll"
                class="rounded-md px-2.5 py-1.5 font-medium text-gray-500 hover:bg-gray-50 dark:text-gray-400 dark:hover:bg-white/10">
          Uncheck all
        </button>
      </div>
    </div>

    <%= form_with url: restock_matches_path(date: @date), method: :post, class: "mt-4" do %>
      <ul role="list" class="divide-y divide-gray-200 dark:divide-white/10">
        <% @suggestions.each do |suggestion| %>
          <li class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:gap-4">
            <%# On the grocery list %>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-medium text-gray-900 dark:text-white"><%= suggestion.ingredient.ingredient %></p>
              <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">On this week's grocery list</p>
            </div>

            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
                 class="hidden size-4 shrink-0 text-gray-400 sm:block dark:text-gray-500">
              <path fill-rule="evenodd" d="M2 10a.75.75 0 0 1 .75-.75h12.59l-2.1-2.1a.75.75 0 1 1 1.06-1.06l3.38 3.38a.75.75 0 0 1 0 1.06l-3.38 3.38a.75.75 0 1 1-1.06-1.06l2.1-2.1H2.75A.75.75 0 0 1 2 10Z" clip-rule="evenodd" />
            </svg>

            <%# On the restock list %>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-medium text-gray-900 dark:text-white"><%= suggestion.restock_item.name %></p>
              <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">
                On your restock list<%= " · #{suggestion.restock_item.brand}" if suggestion.restock_item.brand.present? %>
              </p>
            </div>

            <div class="shrink-0 sm:w-28 sm:text-right">
              <label class="inline-flex cursor-pointer items-center gap-2">
                <%= check_box_tag "confirmed[]", suggestion.key, true,
                                  id: "confirmed_#{suggestion.key}",
                                  data: { match_confirmation_target: "checkbox" },
                                  class: "rounded border-gray-300 dark:border-white/20 text-[#5f734c] focus:ring-[#5f734c]/40" %>
                <span class="text-sm text-gray-700 dark:text-gray-300">Same thing</span>
              </label>
            </div>
          </li>
        <% end %>
      </ul>

      <div class="mt-5 flex items-center gap-3 border-t border-gray-200 pt-4 dark:border-white/10">
        <%= submit_tag "Save matches",
                       class: "inline-flex items-center gap-x-2 rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c] cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
