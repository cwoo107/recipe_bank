<%= turbo_frame_tag "ingredients-index" do %>
  <%= turbo_frame_tag "ingredient" do %>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-8 text-[#5f734c] dark:text-[#7a8f62]">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 0 1-.657.643 48.39 48.39 0 0 1-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 0 1-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 0 0-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 0 1-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 0 0 .657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 0 1-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 0 0 5.427-.63 48.05 48.05 0 0 0 .582-4.717.532.532 0 0 0-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.96.401v0a.656.656 0 0 0 .658-.663 48.422 48.422 0 0 0-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 0 1-.61-.58v0Z" />
        </svg>

        <h1 class="text-4xl font-bold tracking-tight text-olive-800 dark:text-[#e8ede3]">Ingredients</h1>
      </div>
      <div class="mt-4 sm:mt-0">
        <%= link_to new_ingredient_path, data: { turbo: false },
                    class: "inline-flex items-center gap-x-2 rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:shadow-none dark:hover:bg-[#5f734c]" do %>
          <svg viewBox="0 0 20 20" fill="currentColor" class="-ml-0.5 size-5" aria-hidden="true">
            <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
          </svg>
          New Ingredient
        <% end %>
      </div>
    </div>

    <div class="mt-8">
      <%# Family filters %>
      <div class="my-2 flex flex-wrap gap-2">
        <% @ingredient_families.each do |tag| %>
          <%= link_to ingredients_path(filter: tag[:label].downcase) do %>
            <span class="inline-flex items-center rounded-full bg-<%= tag[:color] %>-300 px-2 py-1 text-xs font-medium text-<%= tag[:color] %>-600 inset-ring inset-ring-<%= tag[:color] %>-600/20 dark:bg-<%= tag[:color] %>-800/20 dark:text-<%= tag[:color] %>-300 dark:inset-ring-<%= tag[:color] %>-300/30">
              <%= tag[:label] %>
            </span>
          <% end %>
        <% end %>
        <% if params[:filter].present? %>
          <%= link_to ingredients_path do %>
            <span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-medium inset-ring inset-ring-gray-900/10 dark:inset-ring-white/10">
              clear filter
            </span>
          <% end %>
        <% end %>
      </div>

      <%# Search %>
      <%= form_with url: ingredients_path, method: :get, class: "flex gap-4" do |form| %>
        <div class="flex-1">
          <label for="query" class="sr-only">Search</label>
          <div class="grid grid-cols-1">
            <%= form.text_field :query,
                                value: params[:query],
                                placeholder: "Search ingredients...",
                                class: "col-start-1 row-start-1 block w-full rounded-md bg-white py-1.5 pr-3 pl-10 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-[#5f734c] sm:pl-9 sm:text-sm/6 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500 dark:focus:outline-[#7a8f62]" %>
            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="pointer-events-none col-start-1 row-start-1 ml-3 size-5 self-center text-gray-400 sm:size-4 dark:text-gray-500">
              <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>
        <button type="submit"
                class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:shadow-none dark:inset-ring-white/5 dark:hover:bg-white/20">
          Search
        </button>
      <% end %>
    </div>

    <div class="mt-8">

      <%# ── MOBILE: card list ──────────────────────────────────────────────── %>
      <div class="sm:hidden space-y-3">
        <% @ingredients.each do |ingredient| %>
          <div id="ingredient_<%= ingredient.id %>" class="rounded-lg bg-white shadow-sm inset-ring inset-ring-gray-900/5 dark:bg-white/5 dark:inset-ring-white/10 overflow-hidden">
            <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100 dark:border-white/5">
              <div class="flex items-center gap-2 min-w-0">
                <% if ingredient.favorite? %>
                  <span class="text-yellow-500 shrink-0">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.72-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd" /></svg>
                  </span>
                <% end %>
                <%= link_to ingredient, data: { turbo_frame: "ingredient" }, class: "text-sm font-semibold text-gray-900 dark:text-white truncate" do %>
                  <%= ingredient.ingredient %>
                <% end %>
              </div>
              <div class="flex items-center gap-3 shrink-0 ml-3">
                <%= link_to "Edit", edit_ingredient_path(ingredient), data: { turbo_frame: "ingredient" }, class: "text-sm text-[#5f734c] dark:text-[#7a8f62]" %>
                <%= button_to "Delete", ingredient_path(ingredient), method: :delete,
                              data: { turbo_confirm: "Are you sure?" },
                              class: "text-sm text-dusty-rose-600 dark:text-dusty-rose-400" %>
              </div>
            </div>
            <div class="px-4 py-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-gray-500 dark:text-gray-400">
              <% if ingredient.brand.present? %>
                <span><%= ingredient.brand %></span>
              <% end %>
              <%= ingredient_family_tag(ingredient.family) %>
              <% if ingredient.organic? %>
                <span class="inline-flex items-center rounded-full bg-[#e8ede3] px-2 py-0.5 text-xs font-medium text-[#5f734c] inset-ring inset-ring-[#5f734c]/20 dark:bg-[#7a8f62]/20 dark:text-[#7a8f62]">Organic</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <%# ── DESKTOP: table ─────────────────────────────────────────────────── %>
      <div class="hidden sm:block overflow-hidden bg-white shadow-sm inset-ring inset-ring-gray-900/5 sm:rounded-lg dark:bg-white/5 dark:inset-ring-white/10">
        <table class="min-w-full divide-y divide-gray-300 dark:divide-white/10">
          <thead class="bg-gray-50 dark:bg-white/5">
            <tr>
              <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6 dark:text-white">
                <%= link_to "Name", ingredients_path(sort: 'ingredient', direction: params[:sort] == 'ingredient' && params[:direction] == 'asc' ? 'desc' : 'asc') %>
              </th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">
                <%= link_to "Brand", ingredients_path(sort: 'brand', direction: params[:sort] == 'brand' && params[:direction] == 'asc' ? 'desc' : 'asc') %>
              </th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">
                <%= link_to "Family", ingredients_path(sort: 'family', direction: params[:sort] == 'family' && params[:direction] == 'asc' ? 'desc' : 'asc') %>
              </th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">
                <%= link_to "Organic", ingredients_path(sort: 'organic', direction: params[:sort] == 'organic' && params[:direction] == 'asc' ? 'desc' : 'asc') %>
              </th>
              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white dark:divide-white/10 dark:bg-white/5">
            <% @ingredients.each do |ingredient| %>
              <tr id="ingredient_<%= ingredient.id %>">
                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6 dark:text-white">
                  <div class="flex items-center gap-x-2">
                    <% if ingredient.favorite? %>
                      <span class="text-yellow-500">
                        <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd" /></svg>
                      </span>
                    <% end %>
                    <%= link_to ingredient.ingredient, ingredient, data: { turbo_frame: "ingredient" }, class: "hover:text-[#5f734c] dark:hover:text-[#7a8f62]" %>
                  </div>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500 dark:text-gray-400"><%= ingredient.brand || "—" %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500 dark:text-gray-400">
                  <%= ingredient_family_tag(ingredient.family) || "-" %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500 dark:text-gray-400">
                  <% if ingredient.organic? %>
                    <span class="inline-flex items-center rounded-full bg-[#e8ede3] px-2 py-1 text-xs font-medium text-[#5f734c] inset-ring inset-ring-[#5f734c]/20 dark:bg-[#7a8f62]/20 dark:text-[#7a8f62] dark:inset-ring-[#7a8f62]/30">Organic</span>
                  <% else %>
                    —
                  <% end %>
                </td>
                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                  <%= link_to "Edit", edit_ingredient_path(ingredient), data: { turbo_frame: "ingredient" }, class: "text-[#5f734c] hover:text-[#4b5a3d] dark:text-[#7a8f62]" %>
                  <span class="text-gray-300 dark:text-gray-600"> | </span>
                  <%= button_to "Delete", ingredient_path(ingredient), method: :delete,
                                data: { turbo_confirm: "Are you sure?" },
                                class: "text-dusty-rose-600 hover:text-dusty-rose-900 dark:text-dusty-rose-400" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    </div>
  <% end %>
<% end %>
