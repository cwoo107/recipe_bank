<div class="mx-auto max-w-2xl">

  <div class="mb-8">
    <%# Coming from a recipe, the way back is that recipe %>
    <%= link_to(@recipe ? recipe_path(@recipe) : ingredients_path,
                class: "inline-flex items-center gap-x-1.5 text-sm font-semibold text-gray-900 hover:text-[#5f734c] dark:text-white dark:hover:text-[#7a8f62]") do %>
      <svg viewBox="0 0 20 20" fill="currentColor" class="size-5" aria-hidden="true">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
      <%= @recipe ? "Back to #{@recipe.title}" : "Back to ingredients" %>
    <% end %>
  </div>

  <div>
    <h1 class="text-5xl font-bold tracking-tight text-olive-800 dark:text-[#e8ede3]">New Ingredient</h1>
    <p class="mt-2 text-sm text-gray-700 dark:text-gray-400">
      <%= @recipe ? "It'll be added straight to #{@recipe.title}." : "Add a new ingredient to your library." %>
    </p>
  </div>

  <%# The recipe page links here from inside its own "new_ingredient" frame,
      so both variants have to stay wrapped in one — otherwise that link gets
      Turbo's "content missing". data-turbo="false" keeps the submit a plain
      request, so the redirect is a real navigation rather than a frame swap. %>
  <div class="mt-8" data-turbo="false">
    <%= turbo_frame_tag "new_ingredient" do %>
      <% if @recipe %>
        <h2 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">
          Create an ingredient for <%= @recipe.title %>
        </h2>

        <%= render "recipe_form", ingredient: @ingredient, recipe: @recipe,
                                  recipe_ingredient: @recipe_ingredient %>
      <% else %>
        <h2 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Create an ingredient</h2>

        <%= render 'form', ingredient: @ingredient %>
      <% end %>
    <% end %>
  </div>
</div>