<%# An X in a dialog's top-right corner that closes it — for dialogs run by
    the dialog controller (data-controller="dialog"). %>
<button type="button" data-action="dialog#close" aria-label="Close"
        class="absolute top-3 right-3 rounded-md p-1.5 text-gray-400 hover:bg-gray-100 hover:text-gray-600 dark:text-gray-500 dark:hover:bg-white/10 dark:hover:text-gray-300 cursor-pointer transition-colors">
  <svg viewBox="0 0 20 20" fill="currentColor" class="size-5" aria-hidden="true">
    <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
  </svg>
</button>
