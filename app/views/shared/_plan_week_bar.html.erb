<%#
  Sticky "continue planning" bar, shown from anywhere in the app while a
  weekly plan is in progress (WeeklyPlan#currently_planning). Suppressed on
  the wizard itself and the dashboard — see ApplicationController#active_weekly_plan.
  Closing it ends the planning session (PlanWeekController#close); the
  dashboard then offers "Continue planning" to pick it back up.
%>
<% if (plan = active_weekly_plan) %>
  <% active_key   = plan.active_key %>
  <% active_label = Dashboard.section_class(active_key)::LABEL %>
  <% next_key     = plan.next_key_after(active_key) %>
  <% next_label   = next_key && Dashboard.section_class(next_key)::LABEL %>
  <% step_path    = plan_week_step_path(section: active_key, week: plan.week_start) %>

  <div id="plan_week_bar"
       class="fixed bottom-[calc(1rem+var(--ruby-native-safe-area-bottom))] right-4 z-40 w-[calc(100%-2rem)] max-w-xs rounded-lg border border-gray-200 dark:border-white/10 bg-white dark:bg-[#1a1f16] shadow-lg p-3">
    <div class="mb-2 flex items-start justify-between gap-2">
      <p class="px-1 text-xs text-gray-500 dark:text-gray-400">
        Planning <span class="font-medium text-gray-900 dark:text-white">week of <%= plan.week_range_label %></span> —
        <%= link_to active_label, step_path, class: "font-medium text-[#5f734c] dark:text-[#7a8f62] hover:underline" %>
      </p>
      <%= button_to plan_week_path, method: :delete,
                    form_class: "-m-1 shrink-0",
                    class: "rounded-md p-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200",
                    title: "Close — continue any time from the dashboard",
                    "aria-label": "Close planning bar" do %>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-4">
          <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
        </svg>
      <% end %>
    </div>
    <div class="flex items-center gap-2">
      <%= button_to next_label ? "Continue to #{next_label}" : "Finish planning",
                    step_path, method: :patch, params: { status: "done" },
                    form_class: "flex-1",
                    class: "w-full inline-flex items-center justify-center rounded-md bg-[#5f734c] px-3.5 py-2 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:shadow-none dark:hover:bg-[#5f734c]" %>
      <%= button_to "Skip",
                    step_path, method: :patch, params: { status: "skipped" },
                    class: "inline-flex items-center justify-center rounded-md bg-white px-3.5 py-2 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:inset-ring-white/5 dark:hover:bg-white/20" %>
    </div>
  </div>
<% end %>
