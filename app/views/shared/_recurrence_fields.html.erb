<%# Locals:
      prefix:         param name prefix, e.g. "meal[recurring]" or "recurring_meal"
      recurring_meal: a RecurringMeal (new or persisted) supplying prefilled values
%>
<%
  end_type = recurring_meal.end_type ||
             if recurring_meal.persisted?
               recurring_meal.end_date.nil? ? "ongoing" : "date"
             else
               "week" # sensible default for a brand new rule: don't silently go ongoing
             end
  is_weekday_pattern = recurring_meal.pattern_type == "days_of_week"
  pill_span_class = <<~CLASSES.squish
    flex items-center gap-1.5 px-3.5 py-2 rounded-full text-sm font-medium cursor-pointer
    border border-gray-300 dark:border-white/15
    text-gray-600 dark:text-gray-300
    bg-white dark:bg-white/5
    transition-all duration-150
    peer-checked:bg-[#5f734c] peer-checked:border-[#5f734c] peer-checked:text-white
    dark:peer-checked:bg-[#7a8f62] dark:peer-checked:border-[#7a8f62] dark:peer-checked:text-white
    hover:border-[#5f734c]/50 dark:hover:border-[#7a8f62]/50
    hover:text-[#5f734c] dark:hover:text-[#7a8f62]
    peer-checked:hover:text-white
  CLASSES
  # The joined bars of choices below (shared/_segment_option).
  segment_bar_class = "isolate flex w-full -space-x-px rounded-md shadow-xs dark:shadow-none"
%>

<div data-controller="recurrence-pattern" class="space-y-4">
  <%# Repeat pattern %>
  <div>
    <span class="block text-sm font-medium text-gray-900 dark:text-white mb-2">Repeat</span>
    <div class="flex flex-wrap gap-2 mb-3">
      <label class="meal-type-pill">
        <%= radio_button_tag "#{prefix}[pattern_type]", "interval",
                              !is_weekday_pattern,
                              class: "sr-only peer",
                              data: { action: "change->recurrence-pattern#patternTypeChanged" } %>
        <span class="<%= pill_span_class %>">Every few days</span>
      </label>
      <label class="meal-type-pill">
        <%= radio_button_tag "#{prefix}[pattern_type]", "days_of_week",
                              is_weekday_pattern,
                              class: "sr-only peer",
                              data: { action: "change->recurrence-pattern#patternTypeChanged" } %>
        <span class="<%= pill_span_class %>">Specific weekdays</span>
      </label>
    </div>

    <%# How often — every day up to every week (RecurringMeal::INTERVAL_LABELS).
        Radios underneath, so arrow keys move between them. A rule from before
        the limit keeps its own interval as an extra choice until it's changed. %>
    <% interval = recurring_meal.interval_days || 1 %>
    <% interval_choices = RecurringMeal::INTERVAL_LABELS.dup %>
    <% interval_choices[interval] ||= "Every #{interval} Days" %>
    <div data-recurrence-pattern-target="intervalFields" class="<%= 'hidden' if is_weekday_pattern %>">
      <div role="radiogroup" aria-label="How often" class="<%= segment_bar_class %>">
        <% interval_choices.each_with_index do |(days, label), index| %>
          <%= render "shared/segment_option", label: label, index: index, count: interval_choices.size,
                     input: radio_button_tag("#{prefix}[interval_days]", days, days == interval, class: "peer sr-only") %>
        <% end %>
      </div>
    </div>

    <%# Which weekdays — the same bar, but checkboxes, since a meal can fall
        on several days. In the household's week order. %>
    <div data-recurrence-pattern-target="weekdayFields" class="<%= 'hidden' unless is_weekday_pattern %>">
      <div role="group" aria-label="Which days" class="<%= segment_bar_class %>">
        <% wdays = current_household.ordered_wdays %>
        <% wdays.each_with_index do |wday, index| %>
          <%= render "shared/segment_option", label: Date::ABBR_DAYNAMES[wday], index: index, count: wdays.size,
                     input: check_box_tag("#{prefix}[days_of_week][]", wday, recurring_meal.days_of_week&.include?(wday),
                                          id: "#{prefix.parameterize(separator: '_')}_days_of_week_#{wday}", class: "peer sr-only") %>
        <% end %>
      </div>
    </div>
  </div>

  <%# Start date %>
  <div>
    <%= label_tag "#{prefix}[start_date]", "Starts", class: "block text-sm font-medium text-gray-900 dark:text-white mb-2" %>
    <%= date_field_tag "#{prefix}[start_date]", recurring_meal.start_date || Date.today,
                        required: true,
                        data: { controller: "date-field", date_field_first_day_value: current_household.week_start_day },
                        class: "block w-full rounded-lg bg-white dark:bg-white/5 px-3 py-2.5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 focus:border-[#5f734c] dark:focus:border-[#7a8f62] focus:ring-2 focus:ring-[#5f734c]/20 dark:focus:ring-[#7a8f62]/20 outline-none transition" %>
  </div>

  <%# End condition %>
  <div>
    <span class="block text-sm font-medium text-gray-900 dark:text-white mb-2">Ends</span>
    <div class="flex flex-col gap-1.5">
      <label class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
        <%= radio_button_tag "#{prefix}[end_type]", "week", end_type == "week",
                              data: { action: "change->recurrence-pattern#endTypeChanged" } %>
        End of this week
      </label>
      <label class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
        <%= radio_button_tag "#{prefix}[end_type]", "ongoing", end_type == "ongoing",
                              data: { action: "change->recurrence-pattern#endTypeChanged" } %>
        No end date
      </label>
      <label class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
        <%= radio_button_tag "#{prefix}[end_type]", "date", end_type == "date",
                              data: { action: "change->recurrence-pattern#endTypeChanged" } %>
        On a specific date
      </label>
    </div>
    <%= date_field_tag "#{prefix}[end_date]", recurring_meal.end_date,
                        data: { controller: "date-field", date_field_first_day_value: current_household.week_start_day,
                                 recurrence_pattern_target: "endDateField" },
                        class: "mt-2 #{'hidden' unless end_type == 'date'} block w-full rounded-lg bg-white dark:bg-white/5 px-3 py-2.5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 focus:border-[#5f734c] dark:focus:border-[#7a8f62] focus:ring-2 focus:ring-[#5f734c]/20 dark:focus:ring-[#7a8f62]/20 outline-none transition" %>
  </div>
</div>
