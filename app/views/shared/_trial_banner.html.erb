<%# Last week of the free trial, for admins who haven't picked a plan yet
    (ApplicationController#trial_banner?). Dismissing hides it for the day. %>
<% if trial_banner? %>
  <% days = current_household.trial_days_left %>
  <div id="trial_banner" class="border-b border-honey-200 bg-honey-50 dark:border-honey-800/60 dark:bg-honey-900/20">
    <div class="mx-auto flex max-w-7xl items-center gap-3 px-4 py-2 text-sm text-gray-800 sm:px-6 lg:px-8 dark:text-gray-200">
      <p class="flex-1">
        <span class="font-medium"><%= pluralize(days, "day") %> left</span> in your free trial.
        <%= link_to "Choose a plan", household_path(anchor: "billing"), class: "font-medium text-[#5f734c] underline hover:text-[#4b5a3d] dark:text-[#95a97d]" %>
      </p>
      <%= button_to dismiss_trial_banner_billing_path,
            form_class: "shrink-0",
            class: "rounded-md p-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200",
            title: "Hide for today", "aria-label": "Hide trial reminder" do %>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-4">
          <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
        </svg>
      <% end %>
    </div>
  </div>
<% end %>
