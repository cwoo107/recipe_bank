<% content_for :title, "Grocery lists" %>

<div class="w-full" data-controller="tabs">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
    <div>
      <h1 class="text-5xl  tracking-tight text-olive-800 dark:text-[#e8ede3]">
        <span class="text-[#5f734c]" style="font-family: 'Instrument Serif', serif;">Shopping<span class="text-olive-800 dark:text-[#e8ede3]">List</span></span>
      </h1>
      <p class="mt-2 text-sm text-gray-700 dark:text-gray-400">Grocery List for the week of <%= @date.strftime("%b %d, %Y") %>.</p>
    </div>
    <%# One grid of equal-width buttons, two to a row (a limited member
        just has Print). The row wrappers are display: contents, so every
        button is a cell of the same grid and stretches to its column;
        *:*: centres the links' labels, as w-full justify-center does for
        the two buttons. %>
    <div class="grid <%= 'grid-cols-2' if household_admin? %> gap-2 *:*:justify-center">
    <% if household_admin? %>
    <div class="contents">
      <%= button_to generate_grocery_lists_path(date: @date),
                    method: :post,
                    class: "w-full justify-center inline-flex items-center gap-x-2 rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:shadow-none dark:hover:bg-[#5f734c]",
                    data: { turbo_confirm: "This will replace your current grocery list. Continue?" } do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="-ml-0.5 size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 0 0-3.7-3.7 48.678 48.678 0 0 0-7.324 0 4.006 4.006 0 0 0-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 0 0 3.7 3.7 48.656 48.656 0 0 0 7.324 0 4.006 4.006 0 0 0 3.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3-3 3" />
        </svg>
        Auto generate list
      <% end %>

      <div data-controller="dialog" data-action="click->dialog#backdropClose">
        <dialog data-dialog-target="dialog" class="w-11/12 sm:w-1/2 rounded-lg px-6 pt-6 pb-10 shadow-xl backdrop:bg-black/50">
          <%= turbo_frame_tag 'new_grocery_list', src: new_grocery_list_path(week: @date) do %>
          <% end %>
          <div class="mt-4">
            <button type="button" data-action="dialog#close" autofocus class="rounded-lg px-6 py-2.5 bg-gray-200 hover:bg-gray-300 dark:bg-white/10 dark:hover:bg-white/20 text-gray-900 dark:text-white font-medium transition">close</button>
          </div>
        </dialog>
        <button type="button" data-action="dialog#open" class="w-full justify-center inline-flex items-center gap-x-2 rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:shadow-none dark:hover:bg-[#5f734c]">
          <svg viewBox="0 0 20 20" fill="currentColor" class="-ml-0.5 size-5" aria-hidden="true">
            <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
          </svg>
          Add an ingredient
        </button>
      </div>
    </div>
    <% end %>
      <div class="contents">
        <%# Groceries, then anything marked Restock — the print plan's Shopping list page. %>
        <%= render "shared/print_button", url: week_section_pdf_path("shopping", @date), label: "Print shopping list" %>

        <% if household_admin? %>
          <%# Reads a receipt photo and checks off what's on it (ReceiptScansController). %>
          <%# Secondary, like Print beside it — not one of the list's main actions. %>
          <%= link_to new_receipt_scan_path(date: @date),
                      class: "inline-flex items-center gap-x-2 rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-white/10 dark:text-white dark:inset-ring-white/5 dark:hover:bg-white/20" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="-ml-0.5 size-5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z" />
            </svg>
            Upload Receipt
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%# Two lists: groceries from the meal plan, and restock items from the
      restock checklist. %>
  <% restock_count = @restock_list.sum { |_, categories| categories.sum { |_, items| items.size } } %>
  <div class="mt-8 flex gap-6 border-b border-gray-200 dark:border-white/10" role="tablist">
    <% [ [ "groceries", "Groceries" ], [ "restock", "Restock (#{restock_count})" ] ].each do |key, label| %>
      <button type="button" role="tab" data-tabs-target="tab" data-tabs-panel="<%= key %>_panel" data-action="tabs#show"
              class="-mb-px border-b-2 px-1 pb-2 text-sm font-semibold cursor-pointer <%= @active_list == key ? "border-[#5f734c] text-[#5f734c] dark:text-[#7a8f62] dark:border-[#7a8f62]" : "border-transparent text-gray-500" %>">
        <%= label %>
      </button>
    <% end %>
  </div>

  <div id="groceries_panel" data-tabs-target="panel" class="mt-4 <%= 'hidden' unless @active_list == 'groceries' %>">
    <%# Week navigation %>
    <div class="flex items-center justify-between mb-4 gap-2">
      <%= link_to grocery_lists_path(date: @date - 1.week),
                  class: "inline-flex items-center gap-x-2 rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:shadow-none dark:hover:bg-[#5f734c]" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="-ml-0.5 size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        <span class="hidden sm:inline">Previous Week</span>
        <span class="sm:hidden">Prev</span>
      <% end %>

      <span class="text-sm font-medium text-gray-700 dark:text-gray-300 sm:hidden">
        <%= @date.strftime("%b %d") %> – <%= (@date + 6.days).strftime("%b %d") %>
      </span>

      <%= link_to grocery_lists_path(date: @date + 1.week),
                  class: "inline-flex items-center gap-x-2 rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:shadow-none dark:hover:bg-[#5f734c]" do %>
        <span class="hidden sm:inline">Next Week</span>
        <span class="sm:hidden">Next</span>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="-ml-0.5 size-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      <% end %>
    </div>

    <%# Family filters %>
    <div class="my-2 flex flex-wrap gap-2">
      <% Ingredient::FAMILIES.each_key do |family| %>
        <%= link_to grocery_lists_path(filter: family, date: params[:date]) do %>
          <%= ingredient_family_tag(family) %>
        <% end %>
      <% end %>
      <% if params[:filter].present? %>
        <%= link_to grocery_lists_path(date: params[:date]) do %>
          <span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-medium inset-ring inset-ring-gray-900/10 dark:inset-ring-white/10">
            clear filter
          </span>
        <% end %>
      <% end %>
    </div>

    <div class="p-4 bg-white shadow-sm inset-ring inset-ring-gray-900/5 sm:rounded-lg dark:bg-white/5 dark:inset-ring-white/10">
      <%# The Subtotal follows the rows live (grocery_subtotal_controller.js). %>
      <div role="list" class="divide-y divide-gray-100 dark:divide-white/5"
           data-controller="grocery-subtotal" data-action="input->grocery-subtotal#recalculate">
        <%= turbo_stream_from current_household, 'grocery_lists' %>
        <%# Items added to the list are broadcast in here (GroceryListsController#create). %>
        <div id="grocery_lists" class="divide-y divide-gray-100 dark:divide-white/5">
          <%= render @grocery_lists, uses: @grocery_uses %>
        </div>

        <div class="flex justify-between gap-x-6 p-4 bg-[#faf9f7] dark:bg-[#1a1f16]">
          <div class="flex min-w-0 flex-1 gap-x-4 ml-3">
            <div class="min-w-0 flex-auto">
              <p class="text-lg font-bold text-gray-900 dark:text-white">Subtotal</p>
              <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
                This is just an estimate. Grocery costs vary by store, quality, and location.
              </p>
            </div>
          </div>
          <div class="shrink-0 flex items-center">
            <% subtotal = @grocery_lists.sum { |gl| gl.ingredient&.unit_price.present? ? (gl.ingredient.unit_price * gl.units) : 0 } %>
            <p class="text-xl font-bold text-gray-900 dark:text-white" data-grocery-subtotal-target="total"><%= format("$%.2f", subtotal) %></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="restock_panel" data-tabs-target="panel" class="mt-4 <%= 'hidden' unless @active_list == 'restock' %>">

    <% if @restock_list.empty? %>
      <div class="rounded-lg border-2 border-dashed border-gray-200 dark:border-white/10 p-8 text-center">
        <p class="text-sm text-gray-500 dark:text-gray-400">Nothing to restock right now.</p>
      </div>
    <% else %>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <% @restock_list.each do |store, categories| %>
          <section class="rounded-lg bg-white shadow-sm inset-ring inset-ring-gray-900/5 dark:bg-white/5 dark:inset-ring-white/10">
            <h2 class="px-4 pt-4 text-2xl text-olive-800 dark:text-[#e8ede3]" style="font-family: 'Instrument Serif', serif"><%= store %></h2>
            <div class="px-2 pb-3">
              <% categories.each do |category, items| %>
                <h3 class="mt-3 px-2 text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500"><%= category.name %></h3>
                <ul class="divide-y divide-gray-100 dark:divide-white/5">
                  <% items.each do |item| %>
                    <%= render "restock_items/shopping_item", item: item %>
                  <% end %>
                </ul>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
