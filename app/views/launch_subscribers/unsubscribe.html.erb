<% content_for :title, "Unsubscribed — HomemakersHaven" %>

<section class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6">
  <h1 class="text-4xl text-olive-900 dark:text-white" style="font-family: 'Instrument Serif', serif;">You're unsubscribed</h1>
  <p class="mt-4 text-gray-600 dark:text-gray-300">
    We won't email <strong><%= @subscriber.email %></strong> about the launch. Your three free months still stand if you sign up with this email.
  </p>
  <%= link_to "Back to HomemakersHaven", root_path, class: "mt-8 inline-flex items-center rounded-md bg-[#5f734c] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#4b5a3d]" %>
</section>
