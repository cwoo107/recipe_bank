<% content_for :title, "Recipe Bank — HomemakersHaven" %>
<% content_for :description, "Keep every recipe in one place — written from scratch, imported from a URL, uploaded as a document, or captured with a photo." %>

<%= render "static_pages/feature_hero",
    eyebrow: "Recipe bank",
    headline: "Every recipe you love, in one bank",
    subheadline: "Keep all of your family’s favorite recipes in one place, organized into collections however you like. With nutrition facts and estimated costs built into every recipe, you can stay on track with your nutrition and budget goals—without the mental overwhelm.

  Stop reinventing the wheel every week or endlessly digging through Pinterest trying to find that recipe you saved months ago.",
    image: "marketing/recipe-detail.webp",
    image_alt: "A recipe page in HomemakersHaven showing ingredients, instructions, and nutrition" %>

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl text-olive-900 dark:text-white" style="font-family: 'Instrument Serif', serif;">
      Four ways to add a recipe
    </h2>
    <p class="mt-4 text-base text-gray-600 dark:text-gray-300">
      Whichever way a recipe reaches you, it ends up in the same organized bank.
    </p>
  </div>

  <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2 lg:items-center">
    <div class="flex flex-col gap-4">
      <div class="rounded-2xl border border-black/5 bg-white p-6 dark:bg-white/5 dark:border-white/10">
        <h3 class="text-lg font-semibold text-olive-900 dark:text-white">Write it from scratch</h3>
        <!--<p class="mt-2 text-sm text-gray-600 dark:text-gray-300">Type up your own recipe with ingredients, step-by-step instructions, tags, and serving size.</p>-->
      </div>
      <div class="rounded-2xl border border-black/5 bg-white p-6 dark:bg-white/5 dark:border-white/10">
        <h3 class="text-lg font-semibold text-olive-900 dark:text-white">Import from a URL</h3>
<!--      <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">Paste a link to a recipe blog and HomemakersHaven fetches the page and pulls out the title, ingredients, and instructions.</p>-->
      </div>
      <div class="rounded-2xl border border-black/5 bg-white p-6 dark:bg-white/5 dark:border-white/10">
        <h3 class="text-lg font-semibold text-olive-900 dark:text-white">Upload a document</h3>
<!--      <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">Have a recipe saved as a PDF or Word doc? Upload the file and it gets parsed into the same structured format.</p>-->
      </div>
      <div class="rounded-2xl border border-black/5 bg-white p-6 dark:bg-white/5 dark:border-white/10">
        <h3 class="text-lg font-semibold text-olive-900 dark:text-white">Snap a photo</h3>
<!--      <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">Take a picture of a handwritten card or a cookbook page from your phone and let HomemakersHaven read it.</p>-->
      </div>
    </div>
    <div>
      <div class="rounded-2xl bg-white p-2 shadow-2xl ring-1 ring-black/5 dark:bg-white/5 dark:ring-white/10">
        <%= image_tag "marketing/recipe-import.webp", alt: "Adding a recipe to HomemakersHaven", class: "w-full h-auto rounded-xl", loading: "lazy" %>
      </div>
    </div>
  </div>
</section>

