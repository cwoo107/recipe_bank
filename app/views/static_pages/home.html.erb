<% content_for :title, "HomemakersHaven — Run your household from one place" %>
<% content_for :description, "Meal planning, auto-generated grocery lists, a recipe bank, shared to-do lists, and a household calendar — all in one place." %>

<section class="relative overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 pb-16 pt-16 sm:px-6 sm:pt-24 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center rounded-full bg-sage-100 px-3 py-1 text-xs font-medium text-sage-800 dark:bg-white/10 dark:text-sage-100">
        Built for the whole household
      </span>
      <h1 class="mt-6 text-5xl sm:text-6xl text-olive-900 dark:text-white" style="font-family: 'Instrument Serif', serif;">
        Run your household from one place
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-600 dark:text-gray-300">
        Plan meals, generate the grocery list automatically, keep every recipe you love in one bank, split up the
        to-dos, and see the whole family's calendar in one view — no more sticky notes on the fridge.
      </p>
      <div class="mt-10 flex items-center justify-center gap-4">
        <%= link_to "Get started", new_user_registration_path, class: "inline-flex items-center rounded-md bg-[#5f734c] px-6 py-3 text-base font-semibold text-white hover:bg-[#4b5a3d]" %>
        <%= link_to "See pricing", pricing_path, class: "inline-flex items-center rounded-md px-6 py-3 text-base font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 dark:text-gray-200 dark:ring-white/20 dark:hover:bg-white/5" %>
      </div>
    </div>

    <div class="mx-auto mt-16 max-w-5xl">
      <div class="rounded-2xl bg-white p-2 shadow-2xl ring-1 ring-black/5 dark:bg-white/5 dark:ring-white/10">
        <%= image_tag "marketing/meal-planning.png", alt: "HomemakersHaven meal planning calendar", class: "w-full h-auto rounded-xl", loading: "lazy" %>
      </div>
    </div>
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl sm:text-4xl text-olive-900 dark:text-white" style="font-family: 'Instrument Serif', serif;">
      Everything you need, nothing you don't
    </h2>
    <p class="mt-4 text-base text-gray-600 dark:text-gray-300">
      Five tools that work together, so planning dinner, shopping for it, and getting the dishes done
      doesn't take three different apps.
    </p>
  </div>

  <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <% [
      { path: feature_meal_planning_path, title: "Meal planning", desc: "Plan breakfast, lunch, and dinner for the week and see the nutrition and cost per serving as you go." },
      { path: feature_grocery_lists_path, title: "Grocery lists", desc: "Your shopping list builds itself from whatever's on the meal plan — no more forgotten ingredients." },
      { path: feature_recipes_path, title: "Recipe bank", desc: "Write a recipe from scratch, import it from a URL, upload a document, or snap a photo of a cookbook page." },
      { path: feature_todos_path, title: "To-do lists", desc: "A shared board for household tasks, with a timeline view of what's due when." },
      { path: feature_calendar_path, title: "Shared calendar", desc: "Sync every family calendar into one view so nobody double-books the minivan." },
    ].each do |f| %>
      <%= link_to f[:path], class: "group block rounded-2xl border border-black/5 bg-white p-6 hover:shadow-lg transition-shadow dark:bg-white/5 dark:border-white/10" do %>
        <h3 class="text-lg font-semibold text-olive-900 dark:text-white"><%= f[:title] %></h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300"><%= f[:desc] %></p>
        <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-[#5f734c] dark:text-[#95a97d]">
          See how it works
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 transition-transform group-hover:translate-x-0.5">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
          </svg>
        </span>
      <% end %>
    <% end %>
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
    <div>
      <span class="text-xs font-semibold uppercase tracking-wide text-[#5f734c] dark:text-[#95a97d]">Simple pricing</span>
      <h2 class="mt-2 text-3xl sm:text-4xl text-olive-900 dark:text-white" style="font-family: 'Instrument Serif', serif;">
        One plan. Every feature. No per-person fees.
      </h2>
      <p class="mt-4 text-base text-gray-600 dark:text-gray-300">
        Every household plan includes the full meal planner, grocery lists, recipe bank, to-dos, and shared
        calendar for everyone you invite.
      </p>
      <%= link_to "View pricing", pricing_path, class: "mt-6 inline-flex items-center rounded-md bg-[#5f734c] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#4b5a3d]" %>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-black/5 bg-white p-6 dark:bg-white/5 dark:border-white/10">
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Monthly</p>
        <p class="mt-2 text-4xl text-olive-900 dark:text-white" style="font-family: 'Instrument Serif', serif;">$5<span class="text-base font-sans text-gray-500 dark:text-gray-400">/mo</span></p>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Billed monthly, cancel anytime.</p>
      </div>
      <div class="rounded-2xl border-2 border-[#5f734c] bg-white p-6 dark:bg-white/5">
        <p class="text-sm font-medium text-[#5f734c] dark:text-[#95a97d]">Annual · save 30%</p>
        <p class="mt-2 text-4xl text-olive-900 dark:text-white" style="font-family: 'Instrument Serif', serif;">$3.50<span class="text-base font-sans text-gray-500 dark:text-gray-400">/mo</span></p>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Billed $42 once a year.</p>
      </div>
    </div>
  </div>
</section>

<%= render "static_pages/cta_band",
    headline: "Ready to get the whole household organized?",
    subheadline: "Set up your first meal plan in a few minutes." %>
