<% content_for :title, "Restock List — HomemakersHaven" %>
<% content_for :description, "Keep track of the household staples — mark what's running low and shop it store by store." %>

<%= render "static_pages/feature_hero",
    eyebrow: "Restock list",
    headline: "Stop ordering more just to get express delivery",
