<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
  <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
    <% items.each do |item| %>
      <div>
        <h3 class="text-lg font-semibold text-olive-900 dark:text-white"><%= item[:title] %></h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-300"><%= item[:desc] %></p>
      </div>
    <% end %>
  </div>
</section>
