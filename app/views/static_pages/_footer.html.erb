<footer class="mt-24 border-t border-black/5 dark:border-white/10">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      <div class="col-span-2 sm:col-span-1">
        <span class="text-xl" style="font-family: 'Instrument Serif', serif;">
          <span class="text-[#5f734c] font-bold">Homemakers<span class="text-olive-800 dark:text-[#e8ede3]">Haven</span></span>
        </span>
        <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">Everything your household runs on, in one place.</p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Features</h3>
        <ul class="mt-4 space-y-3 text-sm">
          <li><%= link_to "Meal planning", feature_meal_planning_path, class: "text-gray-500 hover:text-[#5f734c] dark:text-gray-400" %></li>
          <li><%= link_to "Grocery lists", feature_grocery_lists_path, class: "text-gray-500 hover:text-[#5f734c] dark:text-gray-400" %></li>
          <li><%= link_to "Recipes", feature_recipes_path, class: "text-gray-500 hover:text-[#5f734c] dark:text-gray-400" %></li>
          <li><%= link_to "To-do lists", feature_todos_path, class: "text-gray-500 hover:text-[#5f734c] dark:text-gray-400" %></li>
          <li><%= link_to "Shared calendar", feature_calendar_path, class: "text-gray-500 hover:text-[#5f734c] dark:text-gray-400" %></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Company</h3>
        <ul class="mt-4 space-y-3 text-sm">
          <li><%= link_to "Pricing", pricing_path, class: "text-gray-500 hover:text-[#5f734c] dark:text-gray-400" %></li>
          <li><%= link_to "Sign in", new_user_session_path, class: "text-gray-500 hover:text-[#5f734c] dark:text-gray-400" %></li>
          <li><%= link_to "Create an account", new_user_registration_path, class: "text-gray-500 hover:text-[#5f734c] dark:text-gray-400" %></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-black/5 pt-8 dark:border-white/10">
      <p class="text-sm text-gray-500 dark:text-gray-400">&copy; <%= Date.current.year %> HomemakersHaven. All rights reserved.</p>
    </div>
  </div>
</footer>
