<%# The launch mailing list sign-up — the home page's hero and the bottom
    band of every marketing page while sign-ups are closed (Launch).
    `tone: :dark` for the olive band. %>
<% dark = local_assigns[:tone] == :dark %>
<div <%= tag.attributes(id: local_assigns[:anchor]) %> class="mx-auto w-full max-w-md scroll-mt-24">
  <%= form_with model: LaunchSubscriber.new, url: launch_subscribers_path, class: "flex flex-col gap-3 sm:flex-row" do |form| %>
    <%= form.label :email, "Email address", class: "sr-only" %>
    <%= form.email_field :email, required: true, autocomplete: "email", placeholder: "you@example.com",
          class: "min-w-0 flex-1 rounded-md px-4 py-3 text-base outline-1 -outline-offset-1 focus:outline-2 focus:-outline-offset-2 #{dark ? 'bg-white/10 text-white placeholder:text-sage-100/70 outline-white/30 focus:outline-white' : 'bg-white text-gray-900 placeholder:text-gray-400 outline-gray-300 focus:outline-[#5f734c] dark:bg-white/5 dark:text-white dark:outline-white/10'}" %>
    <%= form.submit "Notify me",
          class: "cursor-pointer rounded-md px-6 py-3 text-base font-semibold #{dark ? 'bg-white text-[#3e4a33] hover:bg-sage-50' : 'bg-[#5f734c] text-white hover:bg-[#4b5a3d]'}" %>
  <% end %>
  <p class="mt-3 text-sm <%= dark ? 'text-sage-100' : 'text-gray-500 dark:text-gray-400' %>">
    Join the list and we'll email you when we launch — <strong class="font-semibold">your first three months are free</strong>. No spam; unsubscribe anytime.
  </p>
</div>
