<section class="mx-auto max-w-7xl px-4 pt-16 pb-8 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-3xl text-center">
    <span class="text-xs font-semibold uppercase tracking-wide text-[#5f734c] dark:text-[#95a97d]"><%= eyebrow %></span>
    <h1 class="mt-3 text-5xl sm:text-6xl text-olive-900 dark:text-white" style="font-family: 'Instrument Serif', serif;">
      <%= headline %>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-600 dark:text-gray-300">
      <%= subheadline %>
    </p>
    <div class="mt-8 flex items-center justify-center gap-4">
      <%= link_to "Get started", new_user_registration_path, class: "inline-flex items-center rounded-md bg-[#5f734c] px-6 py-3 text-base font-semibold text-white hover:bg-[#4b5a3d]" %>
      <%= link_to "See pricing", pricing_path, class: "inline-flex items-center rounded-md px-6 py-3 text-base font-semibold text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 dark:text-gray-200 dark:ring-white/20 dark:hover:bg-white/5" %>
    </div>
  </div>

  <div class="mx-auto mt-16 max-w-5xl">
    <div class="rounded-2xl bg-white p-2 shadow-2xl ring-1 ring-black/5 dark:bg-white/5 dark:ring-white/10">
      <%= image_tag image, alt: image_alt, class: "w-full h-auto rounded-xl", loading: "lazy" %>
    </div>
  </div>
</section>
