<% content_for :title, "Plan Your Week — HomemakersHaven" %>
<% content_for :description, "A guided weekly planning session: check the calendar, plan meals, restock, build the grocery list, hand out chores and pick this week's to-dos — in one sitting." %>

<%= render "static_pages/feature_hero",
    eyebrow: "Plan your week",
    headline: "Sit down once, and the whole week is planned",
    subheadline: "Plan your week walks you through everything the household needs for the days ahead — the calendar, meals, the restock list, groceries, chores and to-dos — one step at a time.",
    image: "marketing/plan-week.webp",
    image_alt: "The Plan your week walkthrough in HomemakersHaven, stepping through the calendar, meals, groceries, chores and to-dos" %>

<%= render "static_pages/detail_grid", items: [
  { title: "Start with what's already on", desc: "See the week's appointments and practices first, so you plan meals and chores around the busy nights." },
  { title: "One step at a time", desc: "Plan meals, top up the restock list, build the grocery list, hand out chores and pick this week's to-dos — each step picks up where the last left off." },
  { title: "Pick up where you left off", desc: "Get interrupted halfway? Come back later and you're right back on the step you were on. Skip any step your household doesn't use." },
  { title: "Fit the to-dos to your time", desc: "Set aside how much time you have for to-dos this week, and see straight away when you've planned more than fits." },
  { title: "Plan ahead", desc: "Plan this week or get a head start on next week — each one keeps track of what's done." },
  { title: "Print the plan", desc: "Print the week's meals, groceries, chores and to-dos for the fridge in one PDF." },
] %>

<%= render "static_pages/cta_band",
    headline: "Twenty minutes on Sunday. A calmer week.",
    subheadline: "Plan the whole household's week in one sitting." %>
