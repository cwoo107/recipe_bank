<% content_for :title, "Chore Chart — HomemakersHaven" %>
<% content_for :description, "A shared chore chart for the household: hand out chores, set how often they repeat, and tick them off through the week." %>

<%= render "static_pages/feature_hero",
    eyebrow: "Chore chart",
    headline: "Rule the routine",
    subheadline: "Whether it's a daily pickup around the kitchen or a semi-annual furnace inspection, tell us how often you need it done and we'll keep track for you.",
    image: "marketing/chores.webp",
    mobile_image: "marketing/chores-mobile.webp",
    image_alt: "A weekly chore chart in HomemakersHaven with chores assigned to family members on each day" %>

<%= render "static_pages/detail_grid", items: [
  { title: "Start from a template", desc: "Start from ready-made lists of chores for the kitchen, bathrooms, laundry, yard, and more, then adjust them to fit your home." },
  { title: "Daily to once a year", desc: "Set how often each chore repeats. Weekly chores land on the same day every week, and we'll remind you when your less frequent chores are coming back around." },
  { title: "Hand them out", desc: "Assign each chore to someone in the household. Everyone is color-coded so they can spot their own chores at a glance." },
  { title: "Break it into steps", desc: "Add a checklist to bigger chores so that \"clean the bathroom\" means the same thing to everyone in the house." },
  { title: "Drag to reschedule", desc: "Busy Tuesday? Drag a chore to another day — just this week, or from now on." },
  { title: "Kids can join in", desc: "Kids can have their own login to see and check off their chores without being able to change the rest of the household's plans." },
] %>

<%= render "static_pages/cta_band",
    headline: "Stop being the one who remembers every chore",
    subheadline: "Share the load — and the chart — with the whole household." %>
