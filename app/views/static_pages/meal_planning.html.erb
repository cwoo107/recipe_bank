    image_alt: "A week of meals laid out in the HomemakersHaven meal planner" %>

<%= render "static_pages/detail_grid", items: [
  { title: "Pull straight from your recipe bank", desc: "Any recipe you've saved can be added to a day and meal with its ingredients and instructions already included, so there's no retyping." },
