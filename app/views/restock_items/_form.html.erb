<%# locals: (restock_item:) %>

<%= form_with model: restock_item,
      data: { controller: "dialog", action: "submit->dialog#close" } do |f| %>

  <div class="mb-5">
    <h3 class="text-2xl font-semibold text-olive-800 dark:text-[#e8ede3]"
        style="font-family: 'Instrument Serif', serif;">
      <%= restock_item.new_record? ? "New restock item" : "Edit restock item" %>
    </h3>
  </div>

  <% if restock_item.errors.any? %>
    <div class="mb-4 rounded-lg bg-dusty-rose-50 dark:bg-dusty-rose-900/20 p-3 border border-dusty-rose-200 dark:border-dusty-rose-700">
      <ul class="list-disc list-inside text-sm text-dusty-rose-700 dark:text-dusty-rose-300 space-y-1">
        <% restock_item.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Item name %>
  <div class="mb-4">
    <%= f.label :name, "Item name", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.text_field :name,
          class: "block w-full rounded-md border border-gray-300 dark:border-white/20 bg-white dark:bg-[#242b1e] px-3 py-2 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:border-[#5f734c] focus:ring-2 focus:ring-[#5f734c]/20 focus:outline-none",
          placeholder: "e.g. Toilet paper" %>
  </div>

  <%# Brand %>
  <div class="mb-4">
    <%= f.label :brand, "Brand", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.text_field :brand,
          class: "block w-full rounded-md border border-gray-300 dark:border-white/20 bg-white dark:bg-[#242b1e] px-3 py-2 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:border-[#5f734c] focus:ring-2 focus:ring-[#5f734c]/20 focus:outline-none",
          placeholder: "Optional" %>
  </div>

  <%# Store %>
  <div class="mb-4">
    <%= f.label :store, "Where you buy it", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.text_field :store,
          class: "block w-full rounded-md border border-gray-300 dark:border-white/20 bg-white dark:bg-[#242b1e] px-3 py-2 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:border-[#5f734c] focus:ring-2 focus:ring-[#5f734c]/20 focus:outline-none",
          placeholder: "Optional" %>
  </div>

  <%# List (pre-selected if set via list quick-add) %>
  <div class="mb-6">
    <%= f.label :restock_category_id, "List", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.collection_select :restock_category_id,
          current_household.restock_categories.ordered, :id, :name,
          {},
          class: "block w-full rounded-md border border-gray-300 dark:border-white/20 bg-white dark:bg-[#242b1e] px-3 py-2 text-sm text-gray-900 dark:text-white focus:border-[#5f734c] focus:ring-2 focus:ring-[#5f734c]/20 focus:outline-none" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit restock_item.new_record? ? "Add item" : "Save changes",
          class: "inline-flex items-center rounded-md bg-[#5f734c] px-4 py-2.5 text-sm font-semibold text-white hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c] cursor-pointer transition-colors" %>
  </div>
<% end %>

<% unless restock_item.new_record? %>
  <%# Weekly check-in — kept as separate forms outside the edit form above
      (nesting a <form> inside another <form> is invalid HTML and breaks
      layout unpredictably). Hidden from the card once checked; always
      editable here. %>
  <div class="mt-6 pt-6 border-t border-gray-200 dark:border-white/10">
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Weekly check-in</label>
    <div class="flex items-center gap-2">
      <%= button_to "Stocked", mark_stocked_restock_item_path(restock_item), method: :patch, form_class: "flex-1",
            class: "w-full rounded-lg px-4 py-2.5 bg-sage-600 hover:bg-sage-700 text-white text-sm font-medium cursor-pointer transition" %>
      <%= button_to "Restock", mark_restock_restock_item_path(restock_item), method: :patch, form_class: "flex-1",
            class: "w-full rounded-lg px-4 py-2.5 bg-dusty-rose-600 hover:bg-dusty-rose-700 text-white text-sm font-medium cursor-pointer transition" %>
    </div>
  </div>
<% end %>
