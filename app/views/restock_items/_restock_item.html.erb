<%# locals: (item:) %>

<div id="restock_item_<%= item.id %>"
     data-id="<%= item.id %>"
     data-sortable-target="item"
     data-controller="tap-edit"
     data-action="click->tap-edit#open"
     class="group relative rounded-lg bg-white dark:bg-[#242b1e] border border-gray-200 dark:border-white/10 p-3 shadow-sm hover:shadow-md transition-shadow cursor-grab active:cursor-grabbing has-[[data-tap-edit-target]:focus-visible]:ring-2 has-[[data-tap-edit-target]:focus-visible]:ring-[#5f734c]">

  <%# Drag handle (invisible but full-width) %>
  <div class="sortable-handle absolute inset-0 rounded-lg cursor-grab active:cursor-grabbing" aria-hidden="true"></div>

  <%# Edit dialog, opened by clicking or tapping the card
      (tap_edit_controller.js clicks the screen-reader-only button), with
      Delete beside Close. %>
  <% if household_admin? %>
    <div data-controller="dialog" data-action="click->dialog#backdropClose">
      <dialog data-dialog-target="dialog" class="dark:bg-[#1a1f16] w-11/12 sm:w-1/2 rounded-lg p-6 shadow-xl backdrop:bg-black/50">
        <%= render "shared/dialog_close_x" %>
        <%= turbo_frame_tag "edit_restock_item_#{item.id}", src: edit_restock_item_path(item) do %><% end %>
        <div class="mt-4 flex items-center justify-between gap-3">
          <%= button_to "Delete", restock_item_path(item), method: :delete,
                class: "rounded-lg px-4 py-2.5 text-sm font-semibold text-dusty-rose-700 hover:bg-dusty-rose-50 dark:text-dusty-rose-300 dark:hover:bg-dusty-rose-900/20 cursor-pointer transition",
                data: { turbo_confirm: "Delete \"#{item.name}\"?" } %>
          <button type="button" data-action="dialog#close"
                  class="inline-flex items-center rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:inset-ring-white/5 dark:hover:bg-white/20">
            Close
          </button>
        </div>
      </dialog>
      <button type="button" class="sr-only" data-action="dialog#open" data-tap-edit-target="edit">Edit item</button>
    </div>
  <% end %>

  <div class="relative z-10 pointer-events-none">
    <p class="font-semibold text-gray-900 dark:text-white leading-snug"><%= item.name %></p>

    <div>
      <% if item.stocked_badge? %>
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-sage-100 text-sage-800 dark:bg-sage-900/30 dark:text-sage-300">
          Stocked
        </span>
      <% elsif item.restock_badge? %>
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-dusty-rose-100 text-dusty-rose-800 dark:bg-dusty-rose-900/30 dark:text-dusty-rose-300">
          Restock
        </span>
      <% else %>
        <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-honey-100 text-honey-800 dark:bg-honey-900/30 dark:text-honey-300">
          Needs Check
        </span>
      <% end %>
    </div>

    <% stores = item.stores.map(&:name).join(", ") %>
    <% if item.brand.present? || stores.present? %>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
        <%= [ item.brand, stores ].select(&:present?).join(" · ") %>
      </p>
    <% end %>

    <% if item.last_restocked %>
      <p class="mt-1 text-[11px] text-gray-400 dark:text-gray-500">
        Last restocked <%= item.last_restocked.strftime(item.last_restocked.year == Date.current.year ? "%b %-d" : "%b %-d, %Y") %>
      </p>
    <% end %>

    <%# Stocked / Restock check-in — hidden once checked for the week; still
        available from the edit form so the user can change their mind. %>
    <% if household_admin? && !item.checked_this_week? %>
      <div class="pointer-events-auto mt-3 flex items-center gap-2">
        <%= button_to mark_stocked_restock_item_path(item), method: :patch, form_class: "flex-1",
              class: "w-full rounded-lg px-4 py-1.5 bg-sage-600 hover:bg-sage-700 text-white text-xs font-medium cursor-pointer transition" do %>
          Stocked
        <% end %>
        <%= button_to mark_restock_restock_item_path(item), method: :patch, form_class: "flex-1",
              class: "w-full rounded-lg px-4 py-1.5 bg-dusty-rose-600 hover:bg-dusty-rose-700 text-white text-xs font-medium cursor-pointer transition" do %>
          Restock
        <% end %>
      </div>
    <% end %>
  </div>
</div>
