<%= turbo_frame_tag "stores" do %>
  <% field_class = "block w-full rounded-md border border-gray-300 dark:border-white/20 bg-white dark:bg-[#242b1e] px-3 py-2 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:border-[#5f734c] focus:ring-2 focus:ring-[#5f734c]/20 focus:outline-none" %>

  <div class="mb-5">
    <h3 class="text-2xl font-semibold text-olive-800 dark:text-[#e8ede3]" style="font-family: 'Instrument Serif', serif;">
      Stores
    </h3>
    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
      Where you shop. The restock shopping list is sorted by these. You can also type new ones straight into an item.
    </p>
  </div>

  <% errored = @store_with_errors || (@store if @store.errors.any?) %>
  <% if errored %>
    <div class="mb-4 rounded-lg bg-dusty-rose-50 dark:bg-dusty-rose-900/20 p-3 border border-dusty-rose-200 dark:border-dusty-rose-700">
      <p class="text-sm text-dusty-rose-700 dark:text-dusty-rose-300"><%= errored.errors.full_messages.to_sentence %></p>
    </div>
  <% end %>

  <ul class="divide-y divide-gray-200 dark:divide-white/10">
    <% @stores.each do |store| %>
      <li id="<%= dom_id(store) %>" class="flex items-center gap-2 py-2">
        <%= form_with model: store, class: "grow", data: { controller: "auto-submit" } do |f| %>
          <%= f.text_field :name, class: field_class, aria: { label: "Store name" }, data: { action: "change->auto-submit#submit" } %>
        <% end %>
        <%= button_to store_path(store), method: :delete,
              class: "rounded p-1 text-gray-400 hover:text-dusty-rose-600 dark:hover:text-dusty-rose-400 transition-colors",
              aria: { label: "Delete #{store.name}" },
              data: { turbo_confirm: "Delete \"#{store.name}\"? Items bought there keep their place on the checklist." } do %>
          <svg viewBox="0 0 16 16" fill="currentColor" class="size-5">
            <path d="M5.75 3a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 0 1.5h-3A.75.75 0 0 1 5.75 3ZM3 4.25a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 0 1.5H3A.75.75 0 0 1 3 4.25Zm1.5 1.5.652 6.515A1.75 1.75 0 0 0 6.897 14h2.206a1.75 1.75 0 0 0 1.745-1.735L11.5 5.75h-7Z" />
          </svg>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% if @stores.empty? %>
    <p class="text-sm italic text-gray-400 dark:text-gray-500">No stores yet.</p>
  <% end %>

  <%= form_with model: @store, class: "mt-4 flex items-center gap-2" do |f| %>
    <%= f.text_field :name, class: field_class, placeholder: "New store", aria: { label: "New store name" } %>
    <%= f.submit "Add store",
          class: "shrink-0 inline-flex items-center rounded-md bg-[#5f734c] px-3 py-2 text-sm font-semibold text-white hover:bg-[#4b5a3d] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c] cursor-pointer transition-colors" %>
  <% end %>
<% end %>
