<%# Locals: import_job (required) — the pause between matching and creating.
    Ticked rows reuse the matched ingredient; everything else is created new. %>
<div class="mt-6 rounded-lg border border-gray-200 bg-white p-4 sm:p-6 dark:border-white/10 dark:bg-white/5"
     data-controller="match-confirmation"
     data-new-ingredient-count="<%= import_job.new_ingredient_count %>">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h3 class="text-base font-semibold text-gray-900 dark:text-white">Confirm ingredient matches</h3>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        We matched <%= pluralize(import_job.matched_ingredient_count, "ingredient") %>
        to ones you already have. Untick anything that's wrong — we'll create a new ingredient for it instead.
      </p>
    </div>
    <div class="flex shrink-0 gap-2 text-sm">
      <button type="button" data-action="match-confirmation#checkAll"
              class="rounded-md px-2.5 py-1.5 font-medium text-[#5f734c] hover:bg-gray-50 dark:text-[#7a8f62] dark:hover:bg-white/10">
        Check all
      </button>
      <button type="button" data-action="match-confirmation#uncheckAll"
              class="rounded-md px-2.5 py-1.5 font-medium text-gray-500 hover:bg-gray-50 dark:text-gray-400 dark:hover:bg-white/10">
        Uncheck all
      </button>
    </div>
  </div>

  <%= form_with url: confirm_ingredients_recipe_import_path(import_job), method: :post, class: "mt-4" do %>
    <ul role="list" class="divide-y divide-gray-200 dark:divide-white/10">
      <% import_job.ingredient_matches.each do |match| %>
        <li class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:gap-4">
          <%# What the recipe asked for %>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-medium text-gray-900 dark:text-white"><%= match.original %></p>
            <% if match.name.present? %>
              <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">
                parsed as <span class="font-medium"><%= match.name %></span><%=
                  " · #{match.quantity} #{match.unit}".rstrip if match.quantity.present? %>
              </p>
            <% end %>
          </div>

          <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
               class="hidden size-4 shrink-0 text-gray-400 sm:block dark:text-gray-500">
            <path fill-rule="evenodd" d="M2 10a.75.75 0 0 1 .75-.75h12.59l-2.1-2.1a.75.75 0 1 1 1.06-1.06l3.38 3.38a.75.75 0 0 1 0 1.06l-3.38 3.38a.75.75 0 1 1-1.06-1.06l2.1-2.1H2.75A.75.75 0 0 1 2 10Z" clip-rule="evenodd" />
          </svg>

          <%# What we matched it to %>
          <div class="min-w-0 flex-1">
            <% if match.matched? %>
              <p class="truncate text-sm font-medium text-gray-900 dark:text-white"><%= match.match_name %></p>
              <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">
                <%= match.match_method&.humanize %> match · <%= match.confidence_percent %>% confidence
              </p>
            <% else %>
              <p class="text-sm font-medium text-gray-500 dark:text-gray-400">No match found</p>
              <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">Will be created as a new ingredient</p>
            <% end %>
          </div>

          <%# The confirmation itself %>
          <div class="shrink-0 sm:w-28 sm:text-right">
            <% if match.matched? %>
              <label class="inline-flex cursor-pointer items-center gap-2">
                <%= check_box_tag "confirmed[]", match.index, true,
                                  id: "confirmed_#{match.index}",
                                  data: { match_confirmation_target: "checkbox" },
                                  class: "rounded border-gray-300 dark:border-white/20 text-[#5f734c] focus:ring-[#5f734c]/40" %>
                <span class="text-sm text-gray-700 dark:text-gray-300">Use this</span>
              </label>
            <% else %>
              <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600 dark:bg-white/10 dark:text-gray-300">
                New
              </span>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>

    <div class="mt-5 flex items-center gap-3 border-t border-gray-200 pt-4 dark:border-white/10">
      <%= submit_tag "Confirm and finish import",
                     class: "inline-flex items-center gap-x-2 rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c] cursor-pointer" %>
      <p class="text-sm text-gray-500 dark:text-gray-400" data-match-confirmation-target="summary"></p>
    </div>
  <% end %>
</div>
