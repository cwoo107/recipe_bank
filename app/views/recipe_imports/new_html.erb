<div class="max-w-2xl mx-auto p-6">
  <h1 class="text-3xl font-bold tracking-tight text-olive-800 dark:text-[#e8ede3] mb-6">Import Recipe</h1>

  <%# Tabs %>
  <div data-controller="tabs" class="mb-6">
    <div class="flex border-b border-gray-200 dark:border-white/10">
      <button type="button"
              data-tabs-target="tab"
              data-action="click->tabs#show"
              data-tabs-panel="url-panel"
              class="px-4 py-2.5 text-sm font-medium border-b-2 border-[#5f734c] text-[#5f734c] dark:text-[#7a8f62] dark:border-[#7a8f62] -mb-px">
        From URL
      </button>
      <button type="button"
              data-tabs-target="tab"
              data-action="click->tabs#show"
              data-tabs-panel="file-panel"
              class="px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300 -mb-px">
        From File
      </button>
    </div>

    <%# URL tab %>
    <div id="url-panel" data-tabs-target="panel" class="mt-6">
      <%= form_with url: recipe_imports_path, method: :post, data: { turbo_frame: "import_progress" } do |f| %>
        <div class="mb-4">
          <%= f.label :url, "Recipe URL", class: "block text-sm font-medium text-gray-900 dark:text-white mb-2" %>
          <%= f.text_field :url,
                           placeholder: "https://example.com/recipe",
                           class: "block w-full rounded-lg bg-white dark:bg-white/5 px-3 py-2.5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 focus:border-[#5f734c] dark:focus:border-[#7a8f62] focus:ring-2 focus:ring-[#5f734c]/20 outline-none transition",
                           required: true %>
        </div>
        <%= f.submit "Import Recipe",
                     class: "inline-flex items-center gap-x-2 rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c] cursor-pointer" %>
      <% end %>
    </div>

    <%# File tab %>
    <div id="file-panel" data-tabs-target="panel" class="mt-6 hidden">
      <%= form_with url: create_from_file_recipe_imports_path, method: :post,
                    multipart: true, data: { turbo_frame: "import_progress" } do |f| %>
        <div class="mb-4">
          <%= f.label :file, "Recipe file", class: "block text-sm font-medium text-gray-900 dark:text-white mb-2" %>
          <div class="mt-1 flex justify-center rounded-lg border border-dashed border-gray-300 dark:border-white/20 px-6 py-10">
            <div class="text-center">
              <svg class="mx-auto size-12 text-gray-300 dark:text-gray-600" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" d="M1.5 6a2.25 2.25 0 0 1 2.25-2.25h16.5A2.25 2.25 0 0 1 22.5 6v12a2.25 2.25 0 0 1-2.25 2.25H3.75A2.25 2.25 0 0 1 1.5 18V6ZM3 16.06V18c0 .414.336.75.75.75h16.5A.75.75 0 0 0 21 18v-1.94l-2.69-2.689a1.5 1.5 0 0 0-2.12 0l-.88.879.97.97a.75.75 0 1 1-1.06 1.06l-5.16-5.159a1.5 1.5 0 0 0-2.12 0L3 16.061Zm10.125-7.81a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0Z" clip-rule="evenodd" />
              </svg>
              <div class="mt-4 flex text-sm text-gray-600 dark:text-gray-400 justify-center">
                <label class="relative cursor-pointer rounded-md font-semibold text-[#5f734c] dark:text-[#7a8f62] hover:text-[#4b5a3d]">
                  <span>Upload a file</span>
                  <%= f.file_field :file, accept: "image/*,.pdf", class: "sr-only" %>
                </label>
                <p class="pl-1">or drag and drop</p>
              </div>
              <p class="text-xs text-gray-500 dark:text-gray-500 mt-2">PNG, JPG, GIF, WebP or PDF</p>
            </div>
          </div>
        </div>
        <p class="text-xs text-gray-500 dark:text-gray-400 mb-4">
          The recipe will be extracted using AI. Supported formats: images and PDFs.
        </p>
        <%= f.submit "Import Recipe",
                     class: "inline-flex items-center gap-x-2 rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c] cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <%= turbo_frame_tag "import_progress", class: "mt-8" do %>
  <% end %>
</div>
