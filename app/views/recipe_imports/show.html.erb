<!-- app/views/recipe_imports/show.html.erb -->
<%# Same live progress UI as the inline import flow, so an import opened by
    URL can also be confirmed. Updates arrive over the job's turbo stream —
    no page refresh, which would wipe the confirmation checkboxes. %>
<div class="max-w-3xl mx-auto p-6">
  <h1 class="text-3xl font-bold tracking-tight text-olive-800 dark:text-[#e8ede3] mb-6">Import Recipe</h1>

  <%= render "recipe_imports/progress", import_job: @import_job %>
</div>
