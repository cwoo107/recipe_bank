<div class="lg:col-span-2" id="recipe_steps">
  <div class="rounded-lg bg-white p-6 shadow-sm inset-ring inset-ring-gray-900/5 dark:bg-white/5 dark:inset-ring-white/10">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Instructions</h2>

    <% if recipe.steps.any? %>
      <ol class="mt-4 space-y-4" data-controller="sortable" data-sortable-url-value="<%= reorder_recipe_steps_path(recipe) %>">
        <% recipe.steps.order(:position).each_with_index do |step, index| %>
          <li class="flex gap-x-4" data-sortable-target="item" data-id="<%= step.id %>">
            <%# Drag handle — edit mode only %>
            <div class="hidden flex items-start pt-2" data-edit-mode-target="editOnlyItems">
              <button type="button" aria-label="Reorder step" class="sortable-handle cursor-move text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-400">
                <svg viewBox="0 0 20 20" fill="currentColor" class="size-5"><path fill-rule="evenodd" d="M10 3a.75.75 0 0 1 .55.24l3.25 3.5a.75.75 0 1 1-1.1 1.02L10 4.852 7.3 7.76a.75.75 0 0 1-1.1-1.02l3.25-3.5A.75.75 0 0 1 10 3Zm-3.76 9.2a.75.75 0 0 1 1.06.04l2.7 2.908 2.7-2.908a.75.75 0 1 1 1.1 1.02l-3.25 3.5a.75.75 0 0 1-1.1 0l-3.25-3.5a.75.75 0 0 1 .04-1.06Z" clip-rule="evenodd" /></svg>
              </button>
            </div>
            <div class="step-number flex size-10 shrink-0 items-center justify-center rounded-full bg-[#5f734c] text-base font-semibold text-white dark:bg-[#7a8f62]">
              <%= index + 1 %>
            </div>
            <div class="flex-1 min-w-0">
              <%= render "steps/step", recipe: recipe, step: step %>
            </div>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">No steps yet.</p>
    <% end %>

    <%# Add step — edit mode only %>
    <div class="hidden mt-4 border-t border-gray-200 pt-4 dark:border-white/10" data-edit-mode-target="editOnlyItems">
      <%= turbo_frame_tag 'new_recipe_step' do %>
      <%= link_to new_recipe_step_path(recipe),
                  class: "inline-flex items-center gap-x-2 rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c]" do %>
        <svg viewBox="0 0 20 20" fill="currentColor" class="-ml-0.5 size-5"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" /></svg>
        Add Step
      <% end %>
        <% end %>
    </div>
  </div>
</div>