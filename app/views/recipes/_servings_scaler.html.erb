<%# Locals: recipe (required). The +/- that scales the ingredient quantities
    while reading (serving_scaler_controller) — it doesn't change the recipe,
    so it's hidden in edit mode, where the real servings field is
    (recipes/_servings). Always rendered, even without servings, so saving
    the field has something to replace. %>
<div id="recipe_servings_scaler" data-edit-mode-target="viewOnlyItems">
  <% if recipe.servings.present? %>
    <div class="flex items-center gap-2">
      <button type="button"
              data-action="click->serving-scaler#decrement"
              aria-label="Fewer servings"
              class="flex size-6 items-center justify-center rounded-full inset-ring inset-ring-gray-300 dark:inset-ring-white/10 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-white/10 transition-colors text-sm font-medium">
        −
      </button>
      <span class="text-sm text-gray-700 dark:text-gray-300">
        <span data-serving-scaler-target="count"><%= recipe.servings %></span> servings
      </span>
      <button type="button"
              data-action="click->serving-scaler#increment"
              aria-label="More servings"
              class="flex size-6 items-center justify-center rounded-full inset-ring inset-ring-gray-300 dark:inset-ring-white/10 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-white/10 transition-colors text-sm font-medium">
        +
      </button>
    </div>
  <% end %>
</div>
