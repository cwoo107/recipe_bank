<%# Locals: recipe (required). Attaching another recipe as an ingredient.
    Candidates exclude this recipe, ones already attached, and anything that
    already uses this recipe — that last check walks each candidate's own
    component tree, so it costs a query per candidate. %>
<% candidates = available_component_recipes(recipe, current_household) %>

<div id="new_component" class="hidden mt-4 border-t border-gray-200 pt-4 dark:border-white/10"
     data-edit-mode-target="editOnlyItems">
  <h3 class="text-sm font-medium text-gray-900 dark:text-white">Use another recipe as an ingredient</h3>

  <% if candidates.any? %>
    <%= form_with model: [recipe, RecipeComponent.new], class: "mt-2 space-y-2" do |form| %>
      <%= form.select :component_recipe_id,
                      options_for_select(candidates.map { |r| [r.title, r.id] }),
                      { include_blank: "Choose a recipe..." },
                      class: "block w-full rounded-lg bg-white px-3 py-2 text-sm text-gray-900 border border-gray-300 focus:border-[#5f734c] focus:ring-2 focus:ring-[#5f734c]/20 outline-none dark:bg-white/5 dark:text-white dark:border-white/10 dark:*:bg-gray-800" %>

      <div class="flex items-end gap-2">
        <div class="flex-1">
          <%= form.label :multiplier, "Batches", class: "block text-xs text-gray-500 dark:text-gray-400" %>
          <%= form.number_field :multiplier, value: 1, step: 0.25, min: 0.25,
                                class: "block w-full rounded-lg bg-white px-3 py-2 text-sm text-gray-900 border border-gray-300 focus:border-[#5f734c] focus:ring-2 focus:ring-[#5f734c]/20 outline-none dark:bg-white/5 dark:text-white dark:border-white/10" %>
        </div>
        <%= form.submit "Add recipe",
                        class: "rounded-md bg-[#5f734c] px-3.5 py-2 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c] cursor-pointer" %>
      </div>
    <% end %>
    <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
      Its ingredients and instructions appear here as their own section, and
      stay in step with the original.
    </p>
  <% else %>
    <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
      No other recipes available to add yet.
    </p>
  <% end %>
</div>
