<%# Locals: recipe (required), size (optional).
    The owner gets a toggle — click to flip public/private, the way the
    favourite star works. Everyone else just sees which it is. %>
<% size_class = local_assigns[:size] || "size-4" %>

<span id="visibility_button_<%= recipe.id %>" class="inline-flex shrink-0">
  <% if recipe.owned_by?(current_user) %>
    <%= button_to toggle_visibility_recipe_path(recipe),
                  method: :patch,
                  params: { size: size_class },
                  class: "inline-flex cursor-pointer text-gray-400 hover:text-[#5f734c] transition-colors dark:text-gray-500 dark:hover:text-[#7a8f62]",
                  title: recipe.public? ? "Public — anyone can find this. Click to make it private." : "Private — only your household. Click to make it public.",
                  aria: { label: recipe.public? ? "Make this recipe private" : "Make this recipe public" } do %>
      <%= render "recipes/visibility_glyph", recipe: recipe, size_class: size_class %>
    <% end %>
  <% else %>
    <span class="inline-flex text-gray-400 dark:text-gray-500"
          title="<%= recipe.public? ? 'Public recipe' : 'Private recipe' %>">
      <%= render "recipes/visibility_glyph", recipe: recipe, size_class: size_class %>
    </span>
  <% end %>
</span>
