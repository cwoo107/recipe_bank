<%# Locals: recipe_ingredient (required), recipe (required). The recipe
    arrives as a local rather than an ivar so the enrichment job can
    re-render this row in a broadcast, where there is no request. %>
<tr id="recipe_ingredient_<%= recipe_ingredient.id %>">
  <td class="whitespace-nowrap py-4 text-sm font-medium dark:text-white p-2 rounded">
    <%= link_to recipe_ingredient.ingredient do %>
                  <span class="text-sm font-medium text-gray-900 hover:text-[#5f734c] dark:text-white dark:hover:text-[#7a8f62]">
                    <%= truncate(recipe_ingredient.ingredient.ingredient, length: 20) %>
                  </span>
    <% end %>
  </td>
  <%# Family pill steps aside in edit mode so the amount form gets the width %>
  <td class="whitespace-nowrap text-center text-sm text-gray-500 dark:text-gray-400"
      data-edit-mode-target="viewOnlyItems">
    <%= ingredient_family_tag(recipe_ingredient.ingredient.family) || "-" %>
  </td>
  <td class="whitespace-nowrap text-center px-2 text-sm text-gray-500 dark:text-gray-400">
    <%# Read-only amount — hidden while editing %>
    <span data-edit-mode-target="viewOnlyItems">
      <span data-serving-scaler-target="quantity"
            data-base-quantity="<%= recipe_ingredient.quantity %>">
        <%= recipe_ingredient.quantity %>
      </span>
      <span class="text-xs text-gray-400 dark:text-gray-500"><%= recipe_ingredient.unit %></span>
    </span>

    <%# Editable amount — saves as soon as either field changes %>
    <div class="hidden" data-edit-mode-target="editOnlyItems">
      <%= form_with model: [recipe, recipe_ingredient],
                    class: "flex items-center justify-center gap-1",
                    data: { controller: "auto-submit" } do |form| %>
        <%= form.number_field :quantity,
                              step: 0.01,
                              min: 0,
                              class: "w-16 rounded-md bg-white px-2 py-1 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-[#5f734c] dark:bg-white/5 dark:text-white dark:outline-white/10 dark:focus:outline-[#7a8f62]",
                              aria: { label: "Quantity of #{recipe_ingredient.ingredient.ingredient}" },
                              data: { action: "change->auto-submit#submit" } %>
        <%= form.select :unit,
                        unit_options_for_select(recipe_ingredient.unit),
                        { include_blank: "—" },
                        class: "w-24 rounded-md bg-white px-2 py-1 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-[#5f734c] dark:bg-white/5 dark:text-white dark:outline-white/10 dark:*:bg-gray-800 dark:focus:outline-[#7a8f62]",
                        aria: { label: "Unit for #{recipe_ingredient.ingredient.ingredient}" },
                        data: { action: "change->auto-submit#submit" } %>
      <% end %>
    </div>
  </td>
  <td class="relative whitespace-nowrap text-right text-sm font-medium hidden" data-edit-mode-target="editOnlyItems">
    <%= button_to recipe_recipe_ingredient_path(recipe, recipe_ingredient),
                  method: :delete,
                  data: { turbo_confirm: "Remove this ingredient?" },
                  class: "shrink-0 text-dusty-rose-600 hover:text-dusty-rose-500 dark:text-dusty-rose-400",
                  aria: { label: "Remove #{recipe_ingredient.ingredient.ingredient} from recipe" } do %>
      <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4ZM8.58 7.72a.75.75 0 0 0-1.5.06l.3 7.5a.75.75 0 1 0 1.5-.06l-.3-7.5Zm4.34.06a.75.75 0 1 0-1.5-.06l-.3 7.5a.75.75 0 1 0 1.5.06l.3-7.5Z" clip-rule="evenodd" /></svg>
    <% end %>
  </td>
</tr>
