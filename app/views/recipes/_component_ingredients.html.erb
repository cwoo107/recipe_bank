<%# Locals: recipe (the page's recipe), section (a Recipe::Section).
    A component's ingredients, read-only here — they belong to that recipe,
    and this is a live reference to it. %>
<div class="mt-4 border-t border-gray-200 pt-3 dark:border-white/10">
  <div class="flex items-start justify-between gap-2">
    <div class="min-w-0">
      <%= link_to section.recipe.title, section.recipe,
                  class: "text-sm font-semibold text-gray-900 hover:text-[#5f734c] dark:text-white dark:hover:text-[#7a8f62]" %>
      <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">
        <% if section.depth > 1 && section.via %>
          via <%= section.via.title %>
        <% else %>
        <% end %>
        <% unless section.multiplier == 1.0 %>
          · <%= number_with_precision(section.multiplier, precision: 2, strip_insignificant_zeros: true) %>× batch
        <% end %>
      </p>
    </div>

    <% if section.directly_on?(recipe) %>
      <div class="hidden shrink-0 items-center gap-1" data-edit-mode-target="editOnlyItems">
        <%= form_with model: [recipe, section.component],
                      class: "flex items-center gap-1",
                      data: { controller: "auto-submit" } do |form| %>
          <%= form.number_field :multiplier,
                                step: 0.25, min: 0.25,
                                class: "w-16 rounded-md bg-white px-2 py-1 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-[#5f734c] dark:bg-white/5 dark:text-white dark:outline-white/10 dark:focus:outline-[#7a8f62]",
                                aria: { label: "Batches of #{section.recipe.title}" },
                                data: { action: "change->auto-submit#submit" } %>
          <span class="text-xs text-gray-500 dark:text-gray-400">×</span>
        <% end %>
        <%= button_to recipe_recipe_component_path(recipe, section.component),
                      method: :delete,
                      data: { turbo_confirm: "Remove #{section.recipe.title} from this recipe?" },
                      class: "shrink-0 p-1 text-dusty-rose-600 hover:text-dusty-rose-500 dark:text-dusty-rose-400",
                      aria: { label: "Remove #{section.recipe.title} from this recipe" } do %>
          <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4ZM8.58 7.72a.75.75 0 0 0-1.5.06l.3 7.5a.75.75 0 1 0 1.5-.06l-.3-7.5Zm4.34.06a.75.75 0 1 0-1.5-.06l-.3 7.5a.75.75 0 1 0 1.5.06l.3-7.5Z" clip-rule="evenodd" /></svg>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if section.own_ingredients.any? %>
    <table class="mt-2 min-w-full">
      <tbody class="divide-y divide-gray-100 dark:divide-white/5">
        <% section.own_ingredients.each do |line| %>
          <tr>
            <td class="whitespace-nowrap py-2 text-sm">
              <%= link_to truncate(line.ingredient.ingredient, length: 20), line.ingredient,
                          class: "text-gray-700 hover:text-[#5f734c] dark:text-gray-300 dark:hover:text-[#7a8f62]" %>
            </td>
            <td class="whitespace-nowrap py-2 px-2 text-right text-sm text-gray-500 dark:text-gray-400">
              <span data-serving-scaler-target="quantity" data-base-quantity="<%= line.quantity %>">
                <%= number_with_precision(line.quantity, precision: 2, strip_insignificant_zeros: true) %>
              </span>
              <span class="text-xs text-gray-400 dark:text-gray-500"><%= line.unit %></span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">No ingredients in this recipe.</p>
  <% end %>
</div>
