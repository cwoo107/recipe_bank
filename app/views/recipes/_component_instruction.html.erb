<%# Locals: recipe (the page's recipe), component (a RecipeComponent),
    number (its place in the instruction list).
    A component recipe sits in the list as one draggable entry that expands
    to its own sub-steps, numbered 3.1, 3.2, and so on. %>
<% component_recipe = component.component_recipe %>
<% lines = component_step_lines(component_recipe) %>

<li class="flex gap-x-4" data-sortable-target="item" data-id="component-<%= component.id %>">
  <%# Drag handle — edit mode only %>
  <div class="hidden flex items-start pt-2" data-edit-mode-target="editOnlyItems">
    <button type="button" aria-label="Reorder <%= component_recipe.title %>"
            class="sortable-handle cursor-move text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-400">
      <svg viewBox="0 0 20 20" fill="currentColor" class="size-5"><path fill-rule="evenodd" d="M10 3a.75.75 0 0 1 .55.24l3.25 3.5a.75.75 0 1 1-1.1 1.02L10 4.852 7.3 7.76a.75.75 0 0 1-1.1-1.02l3.25-3.5A.75.75 0 0 1 10 3Zm-3.76 9.2a.75.75 0 0 1 1.06.04l2.7 2.908 2.7-2.908a.75.75 0 1 1 1.1 1.02l-3.25 3.5a.75.75 0 0 1-1.1 0l-3.25-3.5a.75.75 0 0 1 .04-1.06Z" clip-rule="evenodd" /></svg>
    </button>
  </div>

  <div class="step-number flex size-10 shrink-0 items-center justify-center rounded-full bg-[#5f734c] text-base font-semibold text-white dark:bg-[#7a8f62]">
    <%= number %>
  </div>

  <div class="flex-1 min-w-0">
    <div class="flex items-baseline gap-2">
      <%= link_to component_recipe.title, component_recipe,
                  class: "text-sm font-semibold text-gray-900 hover:text-[#5f734c] dark:text-white dark:hover:text-[#7a8f62]" %>
      <% unless component.multiplier == 1.0 %>
        <span class="text-xs text-gray-500 dark:text-gray-400">
          <%= number_with_precision(component.multiplier, precision: 2, strip_insignificant_zeros: true) %>× batch
        </span>
      <% end %>
    </div>

    <% if lines.any? %>
      <ol class="mt-2 space-y-2">
        <% last_section = nil %>
        <% lines.each_with_index do |(section, step), index| %>
          <% if !section.root? && section != last_section %>
            <li class="pt-1 text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">
              <%= section.recipe.title %>
            </li>
          <% end %>
          <% last_section = section %>
          <li class="flex gap-x-3">
            <div class="sub-step-number flex size-8 shrink-0 items-center justify-center rounded-full bg-gray-200 text-sm font-semibold text-gray-700 dark:bg-white/10 dark:text-gray-200">
              <%= index + 1 %>
            </div>
            <div class="min-w-0 flex-1 pt-1 text-sm text-gray-700 dark:text-gray-300"><%= step.content %></div>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">No steps in this recipe.</p>
    <% end %>
  </div>
</li>
