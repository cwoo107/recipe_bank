<%# Ingredient enrichment lands here once the AI estimates come back %>
<%= turbo_stream_from @recipe %>

<div class="mx-auto max-w-7xl" data-controller="edit-mode">

  <%# ── Header ──────────────────────────────────────────────────────────── %>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <%= render "recipes/heading", recipe: @recipe %>

    <% if @recipe.owned_by?(current_user) %>
      <div class="flex shrink-0 gap-x-3">
        <%# Copy steps aside while editing — it's not what you're here for %>
        <div data-edit-mode-target="viewOnlyItems">
          <%= render "recipes/duplicate_button", recipe: @recipe %>
        </div>

        <%# Edit mode toggle. Both labels ship with the button and the target
            toggling picks one — no display utility on the spans themselves,
            since `hidden` and e.g. `inline-flex` would fight over display. %>
        <button type="button"
                data-action="click->edit-mode#toggle"
                data-edit-mode-target="editButton"
                class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:shadow-none dark:inset-ring-white/5 dark:hover:bg-white/20">
          <span data-edit-mode-target="viewOnlyItems">
            <svg viewBox="0 0 20 20" fill="currentColor" class="-ml-0.5 size-5 inline-block" aria-hidden="true">
              <path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z" />
              <path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z" />
            </svg>
            Edit
          </span>
          <span class="hidden" data-edit-mode-target="editOnlyItems">
            <svg viewBox="0 0 20 20" fill="currentColor" class="-ml-0.5 size-5 inline-block" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
            </svg>
            Save edits
          </span>
        </button>

        <%# Delete — edit mode only %>
        <div class="hidden" data-edit-mode-target="editOnlyItems">
          <%= button_to recipe_path(@recipe),
                        method: :delete,
                        data: { turbo_confirm: "Are you sure you want to delete this recipe?" },
                        class: "rounded-md bg-dusty-rose-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-dusty-rose-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-dusty-rose-600 dark:bg-dusty-rose-500 dark:shadow-none dark:hover:bg-dusty-rose-400" do %>
            Delete
          <% end %>
        </div>
      </div>
    <% elsif @recipe.owned_by_household?(current_household) %>
      <div class="flex shrink-0 gap-x-3">
        <%= render "recipes/duplicate_button", recipe: @recipe %>
      </div>
    <% else %>
      <%# Someone else's public recipe — offer to copy it into the household %>
      <div class="flex shrink-0 items-center gap-x-3">
        <% if @saved_copy %>
          <%= link_to "Open your copy", @saved_copy,
                      class: "rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:shadow-none dark:inset-ring-white/5 dark:hover:bg-white/20" %>
        <% else %>
          <%= button_to "Save to Our Recipes", save_to_household_recipe_path(@recipe),
                        method: :post,
                        class: "rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:shadow-none dark:hover:bg-[#5f734c]" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# ── Nutrition chart + Tags ──────────────────────────────────────────── %>
  <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
    <%= render partial: 'macros_chart', locals: {recipe: @recipe} %>

    <div class="lg:col-span-1">
      <div class="rounded-lg bg-white p-6 shadow-sm inset-ring inset-ring-gray-900/5 dark:bg-white/5 dark:inset-ring-white/10">
        <% if @recipe.tags.any? %>
          <div class="flex flex-wrap gap-2">
            <% @recipe.tags.each do |tag| %>
              <span class="inline-flex items-center gap-x-1.5 rounded-full px-3 py-1 text-sm font-medium inset-ring inset-ring-gray-900/10 dark:inset-ring-white/10"
                    style="background-color: <%= tag.color %>20; color: <%= tag.color %>;">
                <%= tag.tag %>
                <%# Remove tag button — edit mode only %>
                <span class="hidden" data-edit-mode-target="editOnlyItems">
                  <%= button_to recipe_recipe_tag_path(@recipe, @recipe.recipe_tags.find_by(tag: tag)),
                                method: :delete,
                                data: { turbo_confirm: "Remove this tag?" },
                                class: "inline-flex shrink-0",
                                aria: { label: "Remove #{tag.tag} tag" } do %>
                    <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" /></svg>
                  <% end %>
                </span>
              </span>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-500 dark:text-gray-400">No tags yet.</p>
        <% end %>

        <%# Add tag form — edit mode only %>
        <div class="hidden mt-4 border-t border-gray-200 pt-4 dark:border-white/10" data-edit-mode-target="editOnlyItems">
          <%= form_with model: [@recipe, @recipe.recipe_tags.build], class: "flex gap-x-3" do |form| %>
            <%= form.select :tag_id,
                            options_from_collection_for_select(Tag.all, :id, :tag),
                            { prompt: "Select a tag" },
                            class: "block rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-[#5f734c] sm:text-sm/6 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:focus:outline-[#7a8f62]" %>
            <%= form.submit "Add Tag",
                            class: "rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c]" %>
          <% end %>
          <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
            Or <%= link_to "create a new tag", new_tag_path, class: "font-medium text-[#5f734c] dark:text-[#7a8f62]" %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <%# ── Ingredients + Steps ─────────────────────────────────────────────── %>
  <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">

    <%# Ingredients %>
    <div class="lg:col-span-1">
      <div class="rounded-lg bg-white p-6 shadow-sm inset-ring inset-ring-gray-900/5 dark:bg-white/5 dark:inset-ring-white/10"
           data-controller="serving-scaler">
        <div class="flex items-center justify-between mb-2">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Ingredients</h2>
          <% if @recipe.servings.present? %>
            <div class="flex items-center gap-2">
              <button type="button"
                      data-action="click->serving-scaler#decrement"
                      class="flex size-6 items-center justify-center rounded-full inset-ring inset-ring-gray-300 dark:inset-ring-white/10 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-white/10 transition-colors text-sm font-medium">
                −
              </button>
              <span class="text-sm text-gray-700 dark:text-gray-300">
          <span data-serving-scaler-target="count"><%= @recipe.servings %></span> servings
        </span>
              <button type="button"
                      data-action="click->serving-scaler#increment"
                      class="flex size-6 items-center justify-center rounded-full inset-ring inset-ring-gray-300 dark:inset-ring-white/10 text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-white/10 transition-colors text-sm font-medium">
                +
              </button>
            </div>
          <% end %>
        </div>

        <%= render "recipes/recipe_ingredients", recipe: @recipe %>

<%# Add ingredient form — edit mode only %>
        <%= render partial: 'new_ingredient' %>

      </div>
    </div>

    <%# Steps %>
    <%= render partial: 'recipe_steps', locals: { recipe: @recipe } %>

  </div>

  <div class="mt-8">
    <%= link_to recipes_path, class: "inline-flex items-center gap-x-1.5 text-sm font-semibold text-gray-900 hover:text-[#5f734c] dark:text-white dark:hover:text-[#7a8f62]" do %>
      <svg viewBox="0 0 20 20" fill="currentColor" class="size-5"><path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" /></svg>
      Back to recipes
    <% end %>
  </div>
</div>
