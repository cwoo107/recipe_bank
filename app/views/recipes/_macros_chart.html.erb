<div class="lg:col-span-2" id="macros_chart">
  <div class="flex flex-col items-center justify-center" data-controller="chart">
    <canvas
      data-controller="chartjs"
      data-chartjs-type-value="pie"
      data-chartjs-data-value='<%= recipe.macros_chart_data.to_json %>'
      data-chartjs-options-value='<%= {
                                        responsive: true,
                                        maintainAspectRatio: true,
                                        plugins: { legend: { display: true, position: "left" } }
                                      }.to_json %>'
      style="max-height: 250px; max-width: 600px">
    </canvas>
    <p class="mt-4 text-xs text-gray-500 dark:text-gray-400 text-center">
      <% if recipe.servings.present? %>
        <%= recipe.calories_per_serving.to_i %> calories per serving — Makes <%= recipe.servings %> <%= "serving".pluralize(recipe.servings) %>
      <% else %>
        <%= recipe.calories_per_serving.to_i %> calories for the whole recipe — set servings to see per-serving values
      <% end %>
    </p>
  </div>
</div>