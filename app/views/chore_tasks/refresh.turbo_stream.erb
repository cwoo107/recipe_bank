<%# After adding, renaming or removing a task: re-render the chore's task
    lists (Table View: desktop Tasks column, mobile modal; Week View: every
    card for the chore) and the mobile row's summary. Targets that aren't on
    the current page are simply skipped. %>
<% %w[desktop mobile].each do |from| %>
  <%= turbo_stream.update "chore_tasks_#{from}_#{@chore.id}" do %>
    <%= render "chore_tasks/list", chore: @chore, from: from, adding: @adding_in == from %>
  <% end %>
<% end %>
<%= turbo_stream.update_all ".chore-tasks-board-#{@chore.id}" do %>
  <%= render "chore_tasks/list", chore: @chore, from: "board", adding: @adding_in == "board" %>
<% end %>
<%= turbo_stream.update "chore_task_summary_#{@chore.id}" do %>
  <%= render "chore_tasks/summary", chore: @chore %>
<% end %>
