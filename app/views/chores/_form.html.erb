<%# locals: (chore:) %>

<%# data-turbo-frame="_top" forces the response to replace the whole page
    rather than just this form's frame — needed when this form is loaded
    into the "view chore" dialog from a board card, so saving lands back on
    the board (see return_to below) instead of re-rendering inside the
    still-closed dialog. %>
<%= form_with model: chore, class: "space-y-6", data: { turbo_frame: "_top" } do |f| %>
  <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>
  <% if chore.errors.any? %>
    <div class="rounded-lg bg-dusty-rose-50 dark:bg-dusty-rose-900/20 p-3 border border-dusty-rose-200 dark:border-dusty-rose-700">
      <ul class="list-disc list-inside text-sm text-dusty-rose-700 dark:text-dusty-rose-300 space-y-1">
        <% chore.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.text_field :name,
          class: "block w-full rounded-md border border-gray-300 dark:border-white/20 bg-white dark:bg-[#242b1e] px-3 py-2 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:border-[#5f734c] focus:ring-2 focus:ring-[#5f734c]/20 focus:outline-none",
          placeholder: "e.g. Clean bathroom" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.text_area :description,
          rows: 3,
          class: "block w-full rounded-md border border-gray-300 dark:border-white/20 bg-white dark:bg-[#242b1e] px-3 py-2 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:border-[#5f734c] focus:ring-2 focus:ring-[#5f734c]/20 focus:outline-none resize-none",
          placeholder: "Optional details…" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :frequency, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.select :frequency,
            Chore::FREQUENCIES.map { |freq| [ Chore::FREQUENCY_LABELS[freq], freq ] },
            {},
            class: "block w-full rounded-md border border-gray-300 dark:border-white/20 bg-white dark:bg-[#242b1e] px-3 py-2 text-sm text-gray-900 dark:text-white focus:border-[#5f734c] focus:ring-2 focus:ring-[#5f734c]/20 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :assignee_id, "Assigned to", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
      <%= f.collection_select :assignee_id,
            current_household.household_members.order(:name), :id, :name,
            { include_blank: "Unassigned" },
            class: "block w-full rounded-md border border-gray-300 dark:border-white/20 bg-white dark:bg-[#242b1e] px-3 py-2 text-sm text-gray-900 dark:text-white focus:border-[#5f734c] focus:ring-2 focus:ring-[#5f734c]/20 focus:outline-none" %>
    </div>
  </div>

  <div class="flex gap-3">
    <%= f.submit chore.persisted? ? "Save changes" : "Create chore",
          class: "inline-flex items-center rounded-md bg-[#5f734c] px-4 py-2.5 text-sm font-semibold text-white hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c] cursor-pointer transition-colors" %>
    <%= link_to "Cancel", params[:return_to].presence || chores_path,
          class: "inline-flex items-center rounded-md bg-white px-4 py-2.5 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:inset-ring-white/5 dark:hover:bg-white/20" %>
  </div>
<% end %>
