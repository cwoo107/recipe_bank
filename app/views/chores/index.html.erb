<% content_for :title, "Chore Chart" %>

<div class="w-full">
  <div class="sm:flex sm:items-center sm:justify-between mb-8">
    <div>
      <h1 class="text-5xl tracking-tight text-olive-800 dark:text-[#e8ede3]">
        <span class="text-[#5f734c]" style="font-family: 'Instrument Serif', serif;">Chore<span class="text-olive-800 dark:text-[#e8ede3]">Chart</span></span>
      </h1>
      <p class="mt-2 text-sm text-gray-700 dark:text-gray-400">
        <%= @chores.count %> recurring chore<%= @chores.count == 1 ? "" : "s" %> · <%= link_to "This week's list", weekly_chores_path, class: "text-[#5f734c] dark:text-[#7a8f62] font-medium hover:underline" %>
      </p>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0 <%= 'hidden' unless household_admin? %>">
      <%= link_to new_chore_path,
                  class: "inline-flex items-center gap-x-2 rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:shadow-none dark:hover:bg-[#5f734c]" do %>
        <svg viewBox="0 0 20 20" fill="currentColor" class="-ml-0.5 size-5" aria-hidden="true">
          <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
        </svg>
        New chore
      <% end %>
    </div>
  </div>

  <% if household_admin? %>
    <details class="mb-6 rounded-lg border border-gray-200 dark:border-white/10 bg-[var(--ivory)] dark:bg-[#1a1f16] group/categories">
      <summary class="cursor-pointer select-none px-4 py-3 flex items-center justify-between">
        <span class="text-xl font-semibold text-olive-800 dark:text-[#e8ede3]" style="font-family: 'Instrument Serif', serif;">
          Manage Categories
        </span>
        <svg viewBox="0 0 20 20" fill="currentColor" class="size-5 text-gray-400 transition-transform group-open/categories:rotate-180" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
        </svg>
      </summary>
      <div class="px-4 pb-4 space-y-2">
        <% @categories.each do |category| %>
          <div id="<%= dom_id(category) %>" class="flex items-center gap-2">
            <%= form_with model: category, class: "flex-1", data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |f| %>
              <%= f.label :name, "Name for #{category.name}", class: "sr-only" %>
              <%= f.text_field :name, required: true,
                    class: "block w-full rounded-md border border-gray-300 dark:border-white/20 bg-white dark:bg-[#242b1e] px-2.5 py-1.5 text-sm text-gray-900 dark:text-white focus:border-[#5f734c] focus:ring-2 focus:ring-[#5f734c]/20 focus:outline-none" %>
            <% end %>
            <%= button_to chore_category_path(category), method: :delete,
                  class: "text-gray-400 hover:text-dusty-rose-600 dark:hover:text-dusty-rose-400 transition-colors cursor-pointer",
                  data: { turbo_confirm: "Delete the \"#{category.name}\" category? Its chores will become uncategorized." },
                  aria: { label: "Delete the #{category.name} category" } do %>
              <svg viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true">
                <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
              </svg>
            <% end %>
          </div>
        <% end %>

        <%= form_with model: ChoreCategory.new, url: chore_categories_path, class: "flex items-center gap-2 pt-2" do |f| %>
          <%= f.label :name, "New category name", class: "sr-only" %>
          <%= f.text_field :name, required: true, placeholder: "New category, e.g. Yard",
                class: "block flex-1 rounded-md border border-dashed border-gray-300 dark:border-white/20 bg-white dark:bg-[#242b1e] px-2.5 py-1.5 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:border-[#5f734c] focus:ring-2 focus:ring-[#5f734c]/20 focus:outline-none" %>
          <%= f.submit "Add category",
                class: "inline-flex items-center rounded-md bg-white px-3 py-1.5 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 dark:bg-white/10 dark:text-white dark:inset-ring-white/5 dark:hover:bg-white/20 cursor-pointer" %>
        <% end %>
      </div>
    </details>
  <% end %>

  <% if @chores.empty? %>
    <div class="rounded-lg border border-dashed border-gray-300 dark:border-white/15 p-8 text-center">
      <p class="text-sm text-gray-500 dark:text-gray-400 italic">No chores yet. Add the recurring chores your household needs to keep up with.</p>
    </div>
  <% else %>
    <%# ── DESKTOP: table — click a cell to edit it (chores/_table_row) ── %>
    <div class="hidden md:block overflow-x-auto bg-white shadow-sm inset-ring inset-ring-gray-900/5 rounded-lg dark:bg-white/5 dark:inset-ring-white/10">
      <table class="min-w-full divide-y divide-gray-300 dark:divide-white/10">
        <thead class="bg-gray-50 dark:bg-white/5">
          <tr>
            <th scope="col" class="py-3.5 pl-4 pr-3 sm:pl-6 text-left text-sm font-semibold text-gray-900 dark:text-white">Chore</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Tasks</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Category</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Frequency</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Day</th>
            <% if current_household.assignable? %>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Assigned to</th>
            <% end %>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Last done</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-white">Next due</th>
            <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white dark:divide-white/10 dark:bg-white/5">
          <% @chores.each do |chore| %>
            <%= render "chores/table_row", chore: chore %>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# ── MOBILE: list, editing in a modal ── %>
    <div class="md:hidden rounded-lg border border-gray-200 dark:border-white/10 bg-[var(--ivory)] dark:bg-[#1a1f16] divide-y divide-gray-200 dark:divide-white/10">
      <% @chores.each do |chore| %>
        <%= render "chores/chore", chore: chore %>
      <% end %>
    </div>
  <% end %>
</div>
