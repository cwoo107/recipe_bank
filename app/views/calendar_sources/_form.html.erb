<%# calendar_sources/_form.html.erb %>
<%= form_with model: source, class: "space-y-6", data: { controller: "calendar-source-form" } do |f| %>
  <% if source.errors.any? %>
    <div class="rounded-lg bg-dusty-rose-50 dark:bg-dusty-rose-900/20 border border-dusty-rose-200 dark:border-dusty-rose-800/40 p-4">
      <ul class="text-sm text-dusty-rose-700 dark:text-dusty-rose-300 space-y-1 list-disc list-inside">
        <% source.errors.each do |e| %>
          <li><%= e.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# ── Provider ── %>
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Calendar Provider</label>
    <div class="grid grid-cols-2 gap-3">
      <% [
        ["google",  "Google Calendar",          "Secret iCal address from Google Calendar settings"],
        ["apple",   "Apple Calendar",           "Shared iCal link from Apple Calendar"],
        ["outlook", "Outlook / Microsoft 365",  "Published ICS link from Outlook settings"],
        ["ical",    "iCal / WebCal Feed",       "Any public or private .ics URL"]
      ].each do |value, label, hint| %>
        <label class="relative flex cursor-pointer rounded-lg border p-4 gap-3 transition
                      has-[:checked]:border-[#5f734c] has-[:checked]:ring-1 has-[:checked]:ring-[#5f734c]
                      border-gray-200 dark:border-white/10 hover:border-gray-300 dark:hover:border-white/20
                      bg-[var(--ivory)] dark:bg-[#1a1f16]">
          <%= f.radio_button :provider, value,
                checked: source.provider == value,
                data: { action: "change->calendar-source-form#providerChanged" } %>
          <div>
            <div class="text-sm font-medium text-gray-800 dark:text-gray-200"><%= label %></div>
            <div class="text-xs text-gray-400 dark:text-gray-500 mt-0.5"><%= hint %></div>
          </div>
        </label>
      <% end %>
    </div>
  </div>

  <%# ── Name ── %>
  <div>
    <%= f.label :name, "Display name", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" %>
    <%= f.text_field :name, placeholder: "My Calendar",
          class: "w-full rounded-lg border border-gray-300 dark:border-white/10 bg-white dark:bg-white/5
                  px-3.5 py-2.5 text-sm text-gray-900 dark:text-white placeholder:text-gray-400
                  focus:outline-none focus:ring-2 focus:ring-[#5f734c] dark:focus:ring-[#7a8f62]" %>
  </div>

  <%# ── iCal URL (shown for all providers — each has its own instructions) ── %>
  <div id="ical_url_section" data-calendar-source-form-target="urlSection">
    <%= f.label :ical_url, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5" do %>
      Calendar URL
    <% end %>
    <%= f.url_field :ical_url, placeholder: "https://…",
          class: "w-full rounded-lg border border-gray-300 dark:border-white/10 bg-white dark:bg-white/5
                  px-3.5 py-2.5 text-sm text-gray-900 dark:text-white placeholder:text-gray-400
                  focus:outline-none focus:ring-2 focus:ring-[#5f734c] dark:focus:ring-[#7a8f62]" %>

    <%# Per-provider instructions shown dynamically %>
    <div data-calendar-source-form-target="instructions">
      <%# Google %>
      <div data-provider="google" class="hidden mt-3 rounded-lg bg-honey-50 dark:bg-honey-900/20 border border-honey-200 dark:border-honey-800/30 p-4 text-sm text-honey-800 dark:text-honey-300 space-y-1">
        <p class="font-medium">How to get your Google Calendar secret iCal address:</p>
        <ol class="list-decimal list-inside space-y-1 text-honey-700 dark:text-honey-400">
          <li>Open <strong>Google Calendar</strong> on desktop</li>
          <li>Next to the calendar name, click the <strong>⋮ menu → Settings</strong></li>
          <li>Scroll to <strong>"Secret address in iCal format"</strong></li>
          <li>Copy that URL and paste it above</li>
        </ol>
        <p class="text-xs text-honey-600 dark:text-honey-500 pt-1">This URL is private — it gives read access without signing in.</p>
      </div>

      <%# Apple %>
      <div data-provider="apple" class="hidden mt-3 rounded-lg bg-mist-50 dark:bg-mist-900/20 border border-mist-200 dark:border-mist-800/30 p-4 text-sm text-mist-800 dark:text-mist-300 space-y-1">
        <p class="font-medium">How to get your Apple Calendar iCal link:</p>
        <ol class="list-decimal list-inside space-y-1 text-mist-700 dark:text-mist-400">
          <li>Open <strong>Apple Calendar</strong> on Mac</li>
          <li>Right-click (or Control-click) the calendar in the sidebar</li>
          <li>Choose <strong>Share Calendar…</strong></li>
          <li>Enable <strong>"Public calendar"</strong>, then click <strong>Copy Link</strong></li>
          <li>Paste the link above — replace <code class="font-mono text-xs">webcal://</code> with <code class="font-mono text-xs">https://</code> if needed</li>
        </ol>
      </div>

      <%# Outlook %>
      <div data-provider="outlook" class="hidden mt-3 rounded-lg bg-seafoam-50 dark:bg-seafoam-900/20 border border-seafoam-200 dark:border-seafoam-800/30 p-4 text-sm text-seafoam-800 dark:text-seafoam-300 space-y-3">
        <div>
          <p class="font-medium mb-1">Outlook.com (personal account):</p>
          <ol class="list-decimal list-inside space-y-1 text-seafoam-700 dark:text-seafoam-400">
            <li>Go to <strong>outlook.com</strong> and click the calendar icon in the left sidebar</li>
            <li>Right-click your calendar and choose <strong>Sharing and permissions</strong></li>
            <li>Under <strong>"Can view all details"</strong>, copy the <strong>ICS link</strong> shown at the bottom of that panel</li>
          </ol>
          <p class="text-xs text-seafoam-600 dark:text-seafoam-500 mt-1">
            If you don't see an ICS link there, try the classic interface:
            <a href="https://outlook.live.com/calendar/0/options/calendar/SharedCalendars" target="_blank"
               class="underline">outlook.live.com/calendar/0/options/calendar/SharedCalendars</a>
            → Publish a calendar → ICS link.
          </p>
        </div>
        <div>
          <p class="font-medium mb-1">Outlook desktop / Microsoft 365:</p>
          <ol class="list-decimal list-inside space-y-1 text-seafoam-700 dark:text-seafoam-400">
            <li>Open <strong>Outlook</strong> and go to the <strong>Calendar</strong> view</li>
            <li>Right-click the calendar → <strong>Properties</strong></li>
            <li>Click the <strong>Permissions</strong> tab and set access to <strong>Can view all details</strong></li>
            <li>Then go to <strong>File → Account Settings → Account Settings</strong></li>
            <li>Select the <strong>Internet Calendars</strong> tab to find the ICS URL, or ask your IT admin for the calendar's publish URL</li>
          </ol>
        </div>
      </div>

      <%# iCal %>
      <div data-provider="ical" class="hidden mt-3 text-xs text-gray-400 dark:text-gray-500">
        Paste any public or private <code class="font-mono">.ics</code> or <code class="font-mono">webcal://</code> URL.
      </div>
    </div>
  </div>

  <%# ── Color picker ── %>
  <div>
    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">Color</label>
    <div class="flex gap-2.5 flex-wrap">
      <% CalendarSource::COLORS.each do |color_key, classes| %>
        <label class="cursor-pointer" title="<%= color_key.humanize %>">
          <%= f.radio_button :color, color_key, checked: source.color == color_key, class: "sr-only peer" %>
          <span class="block size-8 rounded-full <%= classes[:dot] %> ring-2 ring-offset-2 ring-transparent
                       peer-checked:ring-[#5f734c] dark:peer-checked:ring-[#7a8f62]
                       hover:scale-110 transition-transform"></span>
        </label>
      <% end %>
    </div>
  </div>

  <%# ── Submit ── %>
  <div class="flex items-center gap-3 pt-2">
    <%= f.submit source.new_record? ? "Connect Calendar" : "Save Changes",
          class: "rounded-lg bg-[#5f734c] px-5 py-2.5 text-sm font-semibold text-white shadow-xs
                  hover:bg-[#4b5a3d] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c] cursor-pointer transition" %>
    <%= link_to "Cancel", calendars_path,
          class: "text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition" %>
  </div>
<% end %>
