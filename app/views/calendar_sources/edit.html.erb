<% content_for :title, "Edit Calendar" %>

<div class="max-w-lg mx-auto">
  <div class="mb-6">
    <h1 class="text-4xl tracking-tight text-olive-800 dark:text-[#e8ede3]" style="font-family: 'Instrument Serif', serif;">
      <span class="text-[#5f734c]">Edit</span> Calendar
    </h1>
    <p class="mt-2 text-sm text-gray-500 dark:text-gray-400"><%= @source.provider_label %></p>
  </div>

  <%= render "form", source: @source %>

  <div class="mt-8 pt-6 border-t border-gray-200 dark:border-white/10">
    <%= button_to "Remove this calendar", calendar_source_path(@source), method: :delete,
          class: "text-sm text-dusty-rose-600 dark:text-dusty-rose-400 hover:text-dusty-rose-800 dark:hover:text-dusty-rose-200 transition",
          data: { turbo_confirm: "Remove #{@source.name} and all its events?" } %>
  </div>
</div>
