<% content_for :title, "Account Settings" %>

<div class="min-h-screen flex flex-col justify-center py-12 px-4 bg-[var(--ivory)] dark:bg-[#1a1f16]">
  <div class="mx-auto w-full max-w-sm">

    <div class="bg-white dark:bg-[#242b1e] rounded-2xl shadow-sm inset-ring inset-ring-gray-900/5 dark:inset-ring-white/10 px-8 py-10">

      <% if resource.errors.any? %>
        <div class="mb-6 rounded-lg bg-dusty-rose-50 dark:bg-dusty-rose-900/20 border border-dusty-rose-200 dark:border-dusty-rose-800 px-4 py-3">
          <p class="text-sm font-medium text-dusty-rose-700 dark:text-dusty-rose-300 mb-1">
            Please fix the following:
          </p>
          <ul class="list-disc ml-4 space-y-0.5 text-sm text-dusty-rose-600 dark:text-dusty-rose-400">
            <% resource.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# Email + password update %>
      <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-5">Update email or password</h2>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }, class: "space-y-5") do |f| %>

        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-900 dark:text-white mb-1.5" %>
          <%= f.email_field :email,
                autocomplete: "email",
                class: "block w-full rounded-lg bg-white dark:bg-white/5 px-3 py-2.5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 focus:border-[#5f734c] dark:focus:border-[#7a8f62] focus:ring-2 focus:ring-[#5f734c]/20 dark:focus:ring-[#7a8f62]/20 outline-none transition text-sm" %>
        </div>

        <div class="border-t border-gray-100 dark:border-white/10 pt-5">
          <p class="text-xs text-gray-500 dark:text-gray-400 mb-4">Leave blank to keep your current password</p>

          <div class="space-y-4">
            <div>
              <%= f.label :password, "New password", class: "block text-sm font-medium text-gray-900 dark:text-white mb-1.5" %>
              <%= f.password_field :password,
                    autocomplete: "new-password",
                    class: "block w-full rounded-lg bg-white dark:bg-white/5 px-3 py-2.5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 focus:border-[#5f734c] dark:focus:border-[#7a8f62] focus:ring-2 focus:ring-[#5f734c]/20 dark:focus:ring-[#7a8f62]/20 outline-none transition text-sm" %>
              <% if @minimum_password_length %>
                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400"><%= @minimum_password_length %> characters minimum</p>
              <% end %>
            </div>

            <div>
              <%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-gray-900 dark:text-white mb-1.5" %>
              <%= f.password_field :password_confirmation,
                    autocomplete: "new-password",
                    class: "block w-full rounded-lg bg-white dark:bg-white/5 px-3 py-2.5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 focus:border-[#5f734c] dark:focus:border-[#7a8f62] focus:ring-2 focus:ring-[#5f734c]/20 dark:focus:ring-[#7a8f62]/20 outline-none transition text-sm" %>
            </div>
          </div>
        </div>

        <div class="border-t border-gray-100 dark:border-white/10 pt-5">
          <%= f.label :current_password, class: "block text-sm font-medium text-gray-900 dark:text-white mb-1.5" %>
          <p class="text-xs text-gray-500 dark:text-gray-400 mb-2">Required to confirm any changes</p>
          <%= f.password_field :current_password,
                autocomplete: "current-password",
                class: "block w-full rounded-lg bg-white dark:bg-white/5 px-3 py-2.5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 focus:border-[#5f734c] dark:focus:border-[#7a8f62] focus:ring-2 focus:ring-[#5f734c]/20 dark:focus:ring-[#7a8f62]/20 outline-none transition text-sm" %>
        </div>

        <div class="mt-4">
          <%= f.submit "Save changes",
                       class: "w-full rounded-lg px-4 py-2.5 bg-[#5f734c] hover:bg-[#4b5a3d] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c] text-white font-semibold text-sm transition-colors cursor-pointer" %>

        </div>
      <% end %>
    </div>

    <%# Display preferences — saved via PreferencesController so they don't
        need the current password like the email/password form above. %>
    <div class="mt-6 bg-white dark:bg-[#242b1e] rounded-2xl shadow-sm inset-ring inset-ring-gray-900/5 dark:inset-ring-white/10 px-8 py-6">
      <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-4">Preferences</h2>

      <%= form_with model: resource, scope: :user, url: preferences_path, method: :patch do |f| %>
        <div class="flex items-start gap-3">
          <%= f.check_box :compact_meals_view,
                class: "mt-0.5 size-4 rounded border-gray-300 dark:border-white/20 text-[#5f734c] focus:ring-[#5f734c] dark:bg-white/5 accent-[#5f734c]" %>
          <div>
            <%= f.label :compact_meals_view, "Compact meals view", class: "block text-sm font-medium text-gray-900 dark:text-white" %>
            <p class="text-xs text-gray-500 dark:text-gray-400">Show only recipe titles on the meals page — hides ingredients, servings, calories, macros and costs.</p>
          </div>
        </div>

        <fieldset class="mt-5">
          <legend class="block text-sm font-medium text-gray-900 dark:text-white">Theme</legend>
          <div class="mt-2 grid grid-cols-3 gap-2">
            <% [ [ "light", "Light" ], [ "dark", "Dark" ], [ "system", "System default" ] ].each do |theme, label| %>
              <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 has-checked:border-[#5f734c] has-checked:bg-sage-50 dark:border-white/10 dark:text-white dark:has-checked:border-[#7a8f62] dark:has-checked:bg-white/5">
                <%= f.radio_button :theme, theme, class: "size-4 accent-[#5f734c]" %>
                <%= label %>
              </label>
            <% end %>
          </div>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">System default follows your device's light or dark setting.</p>
        </fieldset>

        <div class="mt-5">
          <%= f.submit "Save preferences",
                class: "w-full rounded-lg px-4 py-2.5 bg-[#5f734c] hover:bg-[#4b5a3d] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c] text-white font-semibold text-sm transition-colors cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <%# Danger zone — account deletion %>
    <div class="mt-6 bg-white dark:bg-[#242b1e] rounded-2xl shadow-sm inset-ring inset-ring-dusty-rose-200 dark:inset-ring-dusty-rose-900/50 px-8 py-6">
      <h2 class="text-sm font-semibold text-dusty-rose-700 dark:text-dusty-rose-400 mb-1">Danger zone</h2>
      <p class="text-xs text-gray-500 dark:text-gray-400 mb-4">
        Permanently delete your account and its data.
      </p>
      <div data-controller="delete-account" data-delete-account-phrase-value="<%= User::CONFIRMATION %>">
        <button type="button" data-action="delete-account#open"
                class="w-full rounded-lg px-4 py-2.5 bg-dusty-rose-600 hover:bg-dusty-rose-700 dark:bg-dusty-rose-700 dark:hover:bg-dusty-rose-600 text-white font-semibold text-sm transition-colors cursor-pointer">
          Delete my account
        </button>

        <dialog data-delete-account-target="dialog" data-action="click->delete-account#backdropClick"
                class="m-auto w-11/12 sm:w-md rounded-2xl bg-white dark:bg-[#1a1f16] p-6 shadow-xl backdrop:bg-black/50">
          <h3 class="text-base font-semibold text-gray-900 dark:text-white">Delete your account?</h3>
          <div class="mt-2 space-y-2 text-sm text-gray-600 dark:text-gray-300">
            <% if resource.household_owner? %>
              <p>This deletes your account and your whole household — its meals, lists, chores, to-dos and calendar — for everyone in it.</p>
            <% else %>
              <p>This deletes your account. What you've added to <%= resource.household&.family_name || "your household" %> stays with it.</p>
            <% end %>
            <p><%= " Your subscription is cancelled." if resource.owned_household&.paid? %></p>
          </div>

          <%= form_with url: registration_path(resource_name), method: :delete, class: "mt-5" do |f| %>
            <%= f.label :confirmation, class: "block text-sm text-gray-700 dark:text-gray-200" do %>
              Type <strong class="font-semibold text-gray-900 dark:text-white"><%= User::CONFIRMATION %></strong> to confirm:
            <% end %>
            <%= f.text_field :confirmation, autocomplete: "off", autocapitalize: "off", spellcheck: false,
                  data: { delete_account_target: "input", action: "input->delete-account#check" },
                  class: "mt-2 block w-full rounded-lg bg-white dark:bg-white/5 px-3 py-2.5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 focus:border-dusty-rose-600 focus:ring-2 focus:ring-dusty-rose-600/20 outline-none transition text-sm" %>

            <div class="mt-5 flex flex-col gap-2">
              <%= f.button "Delete my account", type: "submit", disabled: true, data: { delete_account_target: "submit" },
                    class: "w-full rounded-lg px-4 py-2.5 bg-dusty-rose-600 hover:bg-dusty-rose-700 text-white text-sm font-semibold transition cursor-pointer disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-dusty-rose-600" %>
              <button type="button" data-action="delete-account#close"
                      class="w-full rounded-lg px-4 py-2.5 bg-gray-200 hover:bg-gray-300 dark:bg-white/10 dark:hover:bg-white/20 text-gray-900 dark:text-white text-sm font-medium transition cursor-pointer">
                Cancel
              </button>
            </div>
          <% end %>
        </dialog>
      </div>
    </div>

    <p class="mt-6 text-center text-sm text-gray-600 dark:text-gray-400">
      <%= link_to "← Back", :back,
            class: "font-medium text-[#5f734c] hover:text-[#4b5a3d] dark:text-[#7a8f62] dark:hover:text-[#5f734c]" %>
    </p>

  </div>
</div>
