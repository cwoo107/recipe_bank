<% content_for :preheader, "Your HomemakersHaven password was just changed." %>
<%= email_heading "Your password was changed" %>

<%= email_paragraph "Hi #{email_name_for(@resource)}," %>
<%= email_paragraph "The password for #{@resource.email} was just changed." %>

<%= email_note do %>
  If that wasn't you or someone in your household, <%= link_to "reset your password", new_user_password_url, style: "color:#{EmailHelper::SAGE};" %> right away.
<% end %>
