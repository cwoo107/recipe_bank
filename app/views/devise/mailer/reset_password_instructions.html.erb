<% content_for :preheader, "Use this link to choose a new password." %>
<%= email_heading "Reset your password" %>

<%= email_paragraph "Hi #{email_name_for(@resource)}," %>
<%= email_paragraph "Someone asked to reset the password for #{@resource.email}. Choose a new one here:" %>

<%= email_button "Choose a new password", edit_password_url(@resource, reset_password_token: @token) %>

<%= email_note do %>
  This link works for <%= distance_of_time_in_words(Devise.reset_password_within) %>. If you didn't ask for this, you can ignore this email. Your password won't change unless you use the link.
<% end %>
