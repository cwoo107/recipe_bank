<% content_for :title, "Sign In" %>

<div class="min-h-screen flex flex-col justify-center py-12 px-4 bg-[var(--ivory)] dark:bg-[#1a1f16]">
  <div class="mx-auto w-full max-w-sm">

    <%# Wordmark %>
    <div class="text-center mb-10">
      <%= link_to root_path do %>
        <span class="text-4xl font-bold text-[#5f734c] dark:text-[#7a8f62]"
              style="font-family: 'Instrument Serif', serif;">
           Homemakers<span class="text-olive-800 dark:text-[#e8ede3]">Haven</span>
        </span>
      <% end %>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Sign in to your account</p>
    </div>

    <div class="bg-white dark:bg-[#242b1e] rounded-2xl shadow-sm inset-ring inset-ring-gray-900/5 dark:inset-ring-white/10 px-8 py-10">

      <% if flash[:alert] %>
        <div class="mb-6 rounded-lg bg-dusty-rose-50 dark:bg-dusty-rose-900/20 border border-dusty-rose-200 dark:border-dusty-rose-800 px-4 py-3 text-sm text-dusty-rose-700 dark:text-dusty-rose-300">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), class: "space-y-5") do |f| %>
        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-900 dark:text-white mb-1.5" %>
          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                class: "block w-full rounded-lg bg-white dark:bg-white/5 px-3 py-2.5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 focus:border-[#5f734c] dark:focus:border-[#7a8f62] focus:ring-2 focus:ring-[#5f734c]/20 dark:focus:ring-[#7a8f62]/20 outline-none transition text-sm" %>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <%= f.label :password, class: "block text-sm font-medium text-gray-900 dark:text-white" %>
            <%= link_to "Forgot password?", new_password_path(resource_name),
                  class: "text-xs font-medium text-[#5f734c] hover:text-[#4b5a3d] dark:text-[#7a8f62] dark:hover:text-[#5f734c]" %>
          </div>
          <%= f.password_field :password,
                autocomplete: "current-password",
                class: "block w-full rounded-lg bg-white dark:bg-white/5 px-3 py-2.5 text-gray-900 dark:text-white border border-gray-300 dark:border-white/10 focus:border-[#5f734c] dark:focus:border-[#7a8f62] focus:ring-2 focus:ring-[#5f734c]/20 dark:focus:ring-[#7a8f62]/20 outline-none transition text-sm" %>
        </div>

        <div class="flex items-center gap-2.5">
          <%= f.check_box :remember_me,
                class: "h-4 w-4 rounded border-gray-300 dark:border-white/20",
                style: "accent-color: #5f734c;" %>
          <%= f.label :remember_me, class: "text-sm text-gray-700 dark:text-gray-300 select-none" %>
        </div>

        <%= f.submit "Sign in",
              class: "w-full rounded-lg px-4 py-2.5 bg-[#5f734c] hover:bg-[#4b5a3d] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c] text-white font-semibold text-sm transition-colors cursor-pointer mt-2" %>
      <% end %>
    </div>

    <p class="mt-6 text-center text-sm text-gray-600 dark:text-gray-400">
      Don't have an account?
      <%= link_to "Create one", new_registration_path(resource_name),
            class: "font-semibold text-[#5f734c] hover:text-[#4b5a3d] dark:text-[#7a8f62] dark:hover:text-[#5f734c]" %>
    </p>

  </div>
</div>
