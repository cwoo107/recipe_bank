<% @created_meals.each do |meal| %>
  <% next unless meal.calendar_meal? %>
  <% day_index = (meal.date - @date).to_i %>
  <% type      = meal.meal_name.downcase %>


  <%= turbo_stream.append "desktop_cell_#{day_index}_#{type}" do %>
    <%= render partial: "meals/meal", locals: { meal: meal, date: @date } %>
  <% end %>

  <%= turbo_stream.append "mobile_cell_#{day_index}_#{type}" do %>
    <%= render partial: "meals/meal", locals: { meal: meal, date: @date } %>
  <% end %>
<% end %>

<%= turbo_stream.replace "new_meal" do %>
  <%= render partial: "meals/new", locals: { meal: Meal.new(servings: current_household.family_size), week_start: @date } %>
<% end %>

<%# Shared meals whose servings dropped because someone now has their own
    meal in that slot (confirmed in the form). Each card shows twice —
    desktop grid and mobile list — so replace every copy. %>
<% @adjusted_meals.each do |adjusted| %>
  <%= turbo_stream.replace_all "#meal_#{adjusted.id}", partial: "meals/meal", locals: { meal: adjusted, date: @date } %>
<% end %>
