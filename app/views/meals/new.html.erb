<% content_for :title, "New meal" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl text-olive-800 dark:text-[#e8ede3]">New meal</h1>
<%= turbo_frame_tag 'new_meal' do %>
  <%= render "form", meal: @meal, week_start: @week_start %>
<% end %>
  <%= link_to "Back to meals", meals_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 inline-block font-medium bg-gray-100 hover:bg-gray-200 text-gray-700 dark:bg-white/10 dark:hover:bg-white/20 dark:text-white" %>
</div>
