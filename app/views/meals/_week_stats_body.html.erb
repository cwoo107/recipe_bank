<%# The Week summary panel's scrollable body, inside the week_stats_body
    turbo frame — the person switcher reloads it for one member via
    MealsController#week_stats.
    Locals: week_stats, date, member (nil = whole household), person_stats %>

<% if person_stats %>
  <div class="px-6 pt-4 shrink-0">
    <div class="flex flex-wrap gap-1.5">
      <% [ [ "Everyone", nil ] ].concat(current_household.people.map { |p| [ p.name, p ] }).each do |label, person| %>
        <% active = person&.id == member&.id %>
        <%= link_to label, week_stats_meals_path(date: date, member_id: person&.id),
              class: "rounded-full px-3 py-1 text-xs font-medium transition-colors #{active ? 'bg-[#5f734c] text-white dark:bg-[#7a8f62]' : 'text-gray-600 dark:text-gray-300 inset-ring inset-ring-gray-200 dark:inset-ring-white/10 hover:bg-gray-50 dark:hover:bg-white/10'}" %>
      <% end %>
    </div>
  </div>
<% end %>

<% if week_stats[:meal_count] > 0 %>

  <%# This div wraps the toggle buttons AND the views so the controller can find all targets %>
  <div class="flex-1 overflow-y-auto px-6 py-4 space-y-6" data-controller="week-stats-toggle">

    <%# Toggle: total vs per serving %>
    <div class="inline-flex rounded-lg inset-ring inset-ring-gray-200 dark:inset-ring-white/10 p-0.5 gap-0.5">
      <button type="button"
              data-action="click->week-stats-toggle#showPerServing"
              data-week-stats-toggle-target="perServingBtn"
              class="px-3 py-1.5 text-xs font-medium rounded-md bg-[#5f734c] text-white dark:bg-[#7a8f62] transition-colors">
        Daily avg
      </button>
      <button type="button"
              data-action="click->week-stats-toggle#showTotal"
              data-week-stats-toggle-target="totalBtn"
              class="px-3 py-1.5 text-xs font-medium rounded-md text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors">
        Total
      </button>

    </div>

    <%# Macro pie chart %>
    <div>
      <canvas
        data-controller="chartjs"
        data-chartjs-type-value="pie"
        data-chartjs-data-value='<%= week_stats[:chart_data].to_json %>'
        data-chartjs-options-value='{"responsive":true,"maintainAspectRatio":true,"plugins":{"legend":{"display":true,"position":"bottom","labels":{"boxWidth":12,"font":{"size":11}}}}}'
        style="max-height: 220px;">
      </canvas>
    </div>

    <%# Totals grid %>
    <div data-week-stats-toggle-target="totalView" class="hidden">
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500 mb-3">Weekly totals</p>
      <div class="grid grid-cols-2 gap-3">
        <div class="rounded-lg bg-gray-50 dark:bg-white/5 px-4 py-3">
          <p class="text-xs text-gray-500 dark:text-gray-400">Calories</p>
          <p class="text-xl font-semibold text-gray-900 dark:text-white mt-0.5"><%= week_stats[:total_calories] %></p>
        </div>
        <div class="rounded-lg bg-gray-50 dark:bg-white/5 px-4 py-3">
          <p class="text-xs text-gray-500 dark:text-gray-400">Est. cost</p>
          <p class="text-xl font-semibold text-gray-900 dark:text-white mt-0.5">$<%= sprintf('%.2f', week_stats[:total_cost]) %></p>
        </div>
        <div class="rounded-lg bg-gray-50 dark:bg-white/5 px-4 py-3">
          <p class="text-xs text-gray-500 dark:text-gray-400">Protein</p>
          <p class="text-xl font-semibold text-gray-900 dark:text-white mt-0.5"><%= week_stats[:total_protein] %>g</p>
        </div>
        <div class="rounded-lg bg-gray-50 dark:bg-white/5 px-4 py-3">
          <p class="text-xs text-gray-500 dark:text-gray-400">Carbs</p>
          <p class="text-xl font-semibold text-gray-900 dark:text-white mt-0.5"><%= week_stats[:total_carbs] %>g</p>
        </div>
        <div class="rounded-lg bg-gray-50 dark:bg-white/5 px-4 py-3 col-span-2">
          <p class="text-xs text-gray-500 dark:text-gray-400">Fat</p>
          <p class="text-xl font-semibold text-gray-900 dark:text-white mt-0.5"><%= week_stats[:total_fat] %>g</p>
        </div>
      </div>
    </div>

    <%# Per-serving aggregate (hidden by default) %>
    <div data-week-stats-toggle-target="perServingView" >
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500 mb-3">Daily average</p>
      <p class="text-xs text-gray-400 dark:text-gray-500 mb-3">Average per day across the full week</p>
      <div class="grid grid-cols-2 gap-3">
        <div class="rounded-lg bg-gray-50 dark:bg-white/5 px-4 py-3">
          <p class="text-xs text-gray-500 dark:text-gray-400">Calories</p>
          <p class="text-xl font-semibold text-gray-900 dark:text-white mt-0.5"><%= week_stats[:per_serv_calories] %></p>
        </div>
        <div class="rounded-lg bg-gray-50 dark:bg-white/5 px-4 py-3">
          <p class="text-xs text-gray-500 dark:text-gray-400">Est. cost</p>
          <p class="text-xl font-semibold text-gray-900 dark:text-white mt-0.5">$<%= sprintf('%.2f', week_stats[:per_serv_cost]) %></p>
        </div>
        <div class="rounded-lg bg-gray-50 dark:bg-white/5 px-4 py-3">
          <p class="text-xs text-gray-500 dark:text-gray-400">Protein</p>
          <p class="text-xl font-semibold text-gray-900 dark:text-white mt-0.5"><%= week_stats[:per_serv_protein] %>g</p>
        </div>
        <div class="rounded-lg bg-gray-50 dark:bg-white/5 px-4 py-3">
          <p class="text-xs text-gray-500 dark:text-gray-400">Carbs</p>
          <p class="text-xl font-semibold text-gray-900 dark:text-white mt-0.5"><%= week_stats[:per_serv_carbs] %>g</p>
        </div>
        <div class="rounded-lg bg-gray-50 dark:bg-white/5 px-4 py-3 col-span-2">
          <p class="text-xs text-gray-500 dark:text-gray-400">Fat</p>
          <p class="text-xl font-semibold text-gray-900 dark:text-white mt-0.5"><%= week_stats[:per_serv_fat] %>g</p>
        </div>
      </div>
    </div>

    <% if member %>
      <%# What this person ate — their share of each meal's calories and cost. %>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500 mb-3"><%= member.name %>'s meals</p>
        <ul class="divide-y divide-gray-100 dark:divide-white/5 text-sm">
          <% week_stats[:meals].each do |row| %>
            <li class="flex items-baseline justify-between gap-3 py-2">
              <div class="min-w-0">
                <p class="truncate text-gray-900 dark:text-white"><%= row[:name] %></p>
                <p class="text-xs text-gray-400 dark:text-gray-500">
                  <%= row[:date].strftime("%a") %> · <%= row[:meal_name].capitalize %>
                  · <%= row[:share] == 1 ? "all" : "#{(row[:share] * 100).round}%" %>
                </p>
              </div>
              <div class="shrink-0 text-right">
                <p class="text-gray-900 dark:text-white"><%= row[:calories].round %> cal</p>
                <p class="text-xs text-gray-400 dark:text-gray-500">$<%= sprintf('%.2f', row[:cost]) %></p>
              </div>
            </li>
          <% end %>
        </ul>
        <p class="mt-3 text-xs text-gray-400 dark:text-gray-500">
          Shared meals are split among everyone not having their own assigned meal at that time.
          <%= link_to "Full summary", household_member_path(member, date: date), data: { turbo_frame: "_top" }, class: "text-[#5f734c] dark:text-[#7a8f62] hover:underline" %>
        </p>
      </div>
    <% end %>

  </div>

<% else %>
  <div class="flex-1 flex items-center justify-center">
    <p class="text-sm text-gray-400 dark:text-gray-500 text-center px-6">
    <%= member ? "No meals for #{member.name} this week." : "No meals planned this week yet." %>
  </p>
  </div>
<% end %>
