<%# app/views/meals/_week_stats.html.erb %>
<%# Locals: week_stats, date, person_stats (show the per-person switcher) %>

<%# Backdrop %>
<div data-week-stats-target="overlay"
     data-action="click->week-stats#close"
     class="fixed inset-0 z-40 bg-black/30 opacity-0 pointer-events-none transition-opacity duration-300">
</div>

<%# Slide-out panel %>
<div data-week-stats-target="panel"
     class="fixed inset-y-0 right-0 z-50 w-full sm:w-96 bg-white dark:bg-[#1a1f16] shadow-xl translate-x-full transition-transform duration-300 ease-in-out flex flex-col overflow-hidden">

  <%# Header %>
  <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 dark:border-white/10 shrink-0">
    <div>
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Week summary</h2>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5"><%= date.strftime("%b %d") %> – <%= (date + 6.days).strftime("%b %d") %> · <%= week_stats[:meal_count] %> <%= "meal".pluralize(week_stats[:meal_count]) %></p>
    </div>
    <button type="button" data-action="click->week-stats#close" aria-label="Close week stats"
            class="rounded-md p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-gray-300 dark:hover:bg-white/10 transition-colors">
      <svg viewBox="0 0 20 20" fill="currentColor" class="size-5">
        <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/>
      </svg>
    </button>
  </div>

  <%= turbo_frame_tag "week_stats_body", class: "flex-1 flex flex-col overflow-hidden" do %>
    <%= render "meals/week_stats_body", week_stats: week_stats, date: date, member: nil,
               person_stats: local_assigns.fetch(:person_stats, false) %>
  <% end %>

</div>
