<% content_for :title, "Editing meal" %>

<div class="md:w-2/3 w-full">
  <%# The frame lets the meals page's Edit modal load just this form. %>
  <%= turbo_frame_tag dom_id(@meal, :edit) do %>
    <h1 class="font-bold text-2xl mb-4 text-gray-900 dark:text-white">Edit meal</h1>
    <%= render "form", meal: @meal %>
  <% end %>

  <%= link_to "Show this meal", @meal, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Back to meals", meals_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
