<%# Asked when a meal a recurring rule generated is dragged to another day or
    meal type — see meal_board_controller.js. Styled to match the chore
    board's move prompt (weekly_chores/_move_dialog). %>
<dialog data-meal-board-target="moveDialog"
        data-action="cancel->meal-board#dismiss click->meal-board#dialogBackdrop"
        class="dark:bg-[#1a1f16] w-11/12 sm:w-96 rounded-lg p-6 shadow-xl backdrop:bg-black/50 m-auto">
  <h3 class="text-base font-semibold text-gray-900 dark:text-white">Move recurring meal?</h3>
  <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">
    <span data-meal-board-target="moveMealName">This meal</span> · to <span data-meal-board-target="moveSlot">this slot</span>
  </p>
  <p class="mt-3 text-sm text-gray-600 dark:text-gray-300">
    Move just this one, or this one and every one after it?
  </p>

  <div class="mt-5 flex flex-col gap-2">
    <button type="button" data-action="meal-board#answer" data-value="one" autofocus
            class="w-full rounded-lg px-4 py-2.5 bg-[#5f734c] hover:bg-[#4b5a3d] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c] text-white text-sm font-medium cursor-pointer transition">
      Just this one
    </button>
    <button type="button" data-action="meal-board#answer" data-value="sequence"
            class="w-full rounded-lg px-4 py-2.5 bg-dusty-rose-600 hover:bg-dusty-rose-700 text-white text-sm font-medium cursor-pointer transition">
      This and all later ones
    </button>
    <button type="button" data-action="meal-board#dismiss"
            class="w-full rounded-lg px-4 py-2.5 bg-gray-200 hover:bg-gray-300 dark:bg-white/10 dark:hover:bg-white/20 text-gray-900 dark:text-white text-sm font-medium cursor-pointer transition">
      Cancel
    </button>
  </div>
</dialog>
