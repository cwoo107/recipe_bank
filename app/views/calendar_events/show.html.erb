<turbo-frame id="calendar_event_<%= @event.id %>">
  <div class="h-2 <%= @event.calendar_source.color_classes[:bg] %>"></div>

  <div class="px-6 pt-5 pb-2 overflow-y-auto" style="max-height: 70vh;">
    <div class="flex items-start justify-between gap-4 mb-4">
      <div class="flex items-start gap-3 min-w-0">
        <span class="mt-1 size-3 rounded-full shrink-0 <%= @event.calendar_source.color_classes[:dot] %>"></span>
        <div class="min-w-0">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white leading-snug"><%= @event.title %></h2>
          <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5"><%= @event.source_name %></p>
        </div>
      </div>
      <button type="button" data-action="dialog#close" aria-label="Close"
              class="shrink-0 text-gray-300 hover:text-gray-600 dark:text-gray-600 dark:hover:text-gray-300 transition">
        <svg class="size-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/>
        </svg>
      </button>
    </div>

    <dl class="space-y-3 text-sm mb-5">
      <div class="flex gap-3">
        <dt class="shrink-0 w-5 mt-0.5 text-gray-400 dark:text-gray-500">
          <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M5.75 2a.75.75 0 0 1 .75.75V4h7V2.75a.75.75 0 0 1 1.5 0V4h.25A2.75 2.75 0 0 1 18 6.75v8.5A2.75 2.75 0 0 1 15.25 18H4.75A2.75 2.75 0 0 1 2 15.25v-8.5A2.75 2.75 0 0 1 4.75 4H5V2.75A.75.75 0 0 1 5.75 2Zm-1 5.5c-.69 0-1.25.56-1.25 1.25v6.5c0 .69.56 1.25 1.25 1.25h10.5c.69 0 1.25-.56 1.25-1.25v-6.5c0-.69-.56-1.25-1.25-1.25H4.75Z" clip-rule="evenodd" /></svg>
        </dt>
        <dd class="text-gray-700 dark:text-gray-300">
          <% if @event.all_day? %>
            <%= @event.starts_at.in_time_zone.strftime("%A, %B %-d, %Y") %> · All day
          <% elsif @event.multi_day? %>
            <%= @event.starts_at.in_time_zone.strftime("%b %-d, %Y at %-I:%M %p") %> –
            <%= @event.ends_at.in_time_zone.strftime("%b %-d, %Y at %-I:%M %p").downcase %>
          <% else %>
            <%= @event.starts_at.in_time_zone.strftime("%A, %B %-d, %Y") %><br>
            <span class="text-gray-500 dark:text-gray-400"><%= @event.time_range %></span>
          <% end %>
        </dd>
      </div>

      <% if @event.location.present? %>
        <div class="flex gap-3">
          <dt class="shrink-0 w-5 mt-0.5 text-gray-400 dark:text-gray-500">
            <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="m9.69 18.933.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 0 0 .281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 1 0 3 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 0 0 2.273 1.765 11.842 11.842 0 0 0 .976.544l.062.029.018.008.006.003ZM10 11.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5Z" clip-rule="evenodd" /></svg>
          </dt>
          <dd class="text-gray-700 dark:text-gray-300 break-words"><%= @event.location %></dd>
        </div>
      <% end %>

      <% if @event.description.present? %>
        <div class="flex gap-3">
          <dt class="shrink-0 w-5 mt-0.5 text-gray-400 dark:text-gray-500">
            <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M2 4.75A.75.75 0 0 1 2.75 4h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 4.75Zm0 10.5a.75.75 0 0 1 .75-.75h7.5a.75.75 0 0 1 0 1.5h-7.5a.75.75 0 0 1-.75-.75ZM2 10a.75.75 0 0 1 .75-.75h14.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 10Z" clip-rule="evenodd" /></svg>
          </dt>
          <dd class="text-gray-700 dark:text-gray-300 whitespace-pre-wrap text-sm leading-relaxed break-words min-w-0"><%= @event.description %></dd>
        </div>
      <% end %>

      <% if @event.url.present? %>
        <div class="flex gap-3">
          <dt class="shrink-0 w-5 mt-0.5 text-gray-400 dark:text-gray-500">
            <svg viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M12.232 4.232a2.5 2.5 0 0 1 3.536 3.536l-1.225 1.224a.75.75 0 0 0 1.061 1.06l1.224-1.224a4 4 0 0 0-5.656-5.656l-3 3a4 4 0 0 0 .225 5.865.75.75 0 0 0 .977-1.138 2.5 2.5 0 0 1-.142-3.667l3-3Z" /><path d="M11.603 7.963a.75.75 0 0 0-.977 1.138 2.5 2.5 0 0 1 .142 3.667l-3 3a2.5 2.5 0 0 1-3.536-3.536l1.225-1.224a.75.75 0 0 0-1.061-1.06l-1.224 1.224a4 4 0 1 0 5.656 5.656l3-3a4 4 0 0 0-.225-5.865Z" /></svg>
          </dt>
          <dd class="min-w-0 overflow-hidden">
            <%= link_to @event.url, @event.url, target: "_blank",
                  class: "text-[#5f734c] dark:text-[#7a8f62] hover:underline text-sm break-all block" %>
          </dd>
        </div>
      <% end %>
    </dl>
  </div>


    <% unless @event.external_uid.present? %>
    <div class="px-6 py-4 bg-gray-50 dark:bg-white/5 border-t border-gray-100 dark:border-white/5 flex items-center justify-between">

      <%= button_to "Delete", calendar_event_path(@event), method: :delete,
            class: "text-sm text-dusty-rose-600 dark:text-dusty-rose-400 hover:text-dusty-rose-800 transition",
            data: { turbo_confirm: "Delete this event?" } %>
    </div>

    <% end %>
</turbo-frame>
