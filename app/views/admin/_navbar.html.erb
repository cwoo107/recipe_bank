<%# The admin section's own navbar (layouts/admin), with the way back to the
    household side of the app. %>
<% sections = [ [ "Overview", admin_root_path, "admin/dashboard" ],
                [ "Households", admin_households_path, "admin/households" ],
                [ "Users", admin_users_path, "admin/users" ],
                [ "Featured recipes", admin_featured_recipes_path, "admin/featured_recipes" ],
                [ "Beta invites", admin_beta_invites_path, "admin/beta_invites" ],
                [ "Launch list", admin_launch_subscribers_path, "admin/launch_subscribers" ] ] %>
<nav id="admin_navbar" class="bg-sage-900 shadow-sm dark:bg-[#12160f]" data-controller="mobile-menu">
  <div class="mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 justify-between">
      <div class="flex">
        <%= link_to admin_root_path, class: "flex shrink-0 items-center gap-2" do %>
          <span class="text-2xl text-white" style="font-family: 'Instrument Serif', serif;">HomemakersHaven</span>
          <span class="rounded-full bg-white/15 px-2 py-0.5 text-xs font-semibold uppercase tracking-wider text-white">Admin</span>
        <% end %>

        <div class="hidden lg:ml-8 lg:flex lg:gap-x-1">
          <% sections.each do |label, path, section| %>
            <%= link_to label, path,
                  class: "inline-flex items-center px-3 py-2 text-sm font-medium #{controller_path == section ? 'text-white border-b-2 border-white' : 'text-sage-100/80 hover:text-white'}" %>
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <%= link_to dashboard_path, class: "hidden items-center gap-1.5 rounded-md bg-white/10 px-3 py-1.5 text-sm font-medium text-white hover:bg-white/20 sm:inline-flex" do %>
          <span aria-hidden="true">←</span> My household
        <% end %>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete,
              form_class: "hidden sm:block",
              class: "text-sm font-medium text-sage-100/80 hover:text-white cursor-pointer" %>

        <button type="button" data-action="click->mobile-menu#toggle"
                class="inline-flex items-center justify-center rounded-md p-2 text-white hover:bg-white/10 lg:hidden">
          <span class="sr-only">Open admin menu</span>
          <svg class="block size-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="hidden lg:hidden" data-mobile-menu-target="menu">
    <div class="space-y-1 pb-3 pt-2">
      <% sections.each do |label, path, section| %>
        <%= link_to label, path,
              class: "block border-l-4 py-2 pl-3 pr-4 text-base font-medium #{controller_path == section ? 'border-white bg-white/10 text-white' : 'border-transparent text-sage-100/80 hover:bg-white/5 hover:text-white'}" %>
      <% end %>
    </div>
    <div class="border-t border-white/10 pb-3 pt-3 sm:hidden">
      <%= link_to "← My household", dashboard_path,
            class: "block border-l-4 border-transparent py-2 pl-3 pr-4 text-base font-medium text-white hover:bg-white/5" %>
      <%= button_to "Sign out", destroy_user_session_path, method: :delete,
            class: "block w-full text-left border-l-4 border-transparent py-2 pl-3 pr-4 text-base font-medium text-sage-100/80 hover:bg-white/5 hover:text-white cursor-pointer" %>
    </div>
  </div>
</nav>
