<%# Links between the admin pages, top right of each one's heading. %>
<nav class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
  <% [ [ "Households", admin_households_path ], [ "Featured recipes", admin_featured_recipes_path ],
       [ "Beta invites", admin_beta_invites_path ], [ "Launch list", admin_launch_subscribers_path ] ].each do |label, path| %>
    <% if current_page?(path) %>
      <span class="font-semibold text-gray-900 dark:text-white"><%= label %></span>
    <% else %>
      <%= link_to label, path, class: "text-[#5f734c] hover:underline dark:text-[#7a8f62]" %>
    <% end %>
  <% end %>
</nav>
