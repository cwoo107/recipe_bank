<%# locals: (todo:, priority_config:) %>
<% pri = priority_config[todo.priority] %>

<div id="todo_<%= todo.id %>"
     data-id="<%= todo.id %>"
     data-sortable-target="item"
     class="group relative rounded-lg bg-white dark:bg-[#242b1e] border border-gray-200 dark:border-white/10 p-3 shadow-sm hover:shadow-md transition-shadow cursor-grab active:cursor-grabbing">

  <%# Drag handle (invisible but full-width, class used by sortable_controller) %>
  <div class="sortable-handle absolute inset-0 rounded-lg cursor-grab active:cursor-grabbing" aria-hidden="true"></div>

  <div class="relative z-10 pointer-events-none">
    <%# Priority badge %>
    <div class="flex items-center justify-between mb-2">
      <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= pri[:classes] %>">
        <%= pri[:label] %>
      </span>
      <div class="pointer-events-auto flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
        <%# Edit %>
        <div data-controller="dialog" data-action="click->dialog#backdropClose">
          <dialog data-dialog-target="dialog" class="dark:bg-[#1a1f16] w-11/12 sm:w-1/2 rounded-lg p-6 shadow-xl backdrop:bg-black/50">
            <%= turbo_frame_tag "edit_todo_#{todo.id}", src: edit_todo_path(todo) do %><% end %>
            <div class="mt-4">
              <button type="button" data-action="dialog#close"
                      class="rounded-lg px-6 py-2.5 bg-gray-200 hover:bg-gray-300 dark:bg-white/10 dark:hover:bg-white/20 text-gray-900 dark:text-white font-medium transition">
                Close
              </button>
            </div>
          </dialog>
          <button type="button" data-action="dialog#open"
                  class="rounded p-1 text-gray-400 hover:text-[#5f734c] dark:hover:text-[#7a8f62] transition-colors"
                  aria-label="Edit task">
            <svg viewBox="0 0 16 16" fill="currentColor" class="size-3.5">
              <path d="M13.488 2.513a1.75 1.75 0 0 0-2.475 0L6.75 6.774a2.75 2.75 0 0 0-.596.892l-.83 2.495a.75.75 0 0 0 .945.944l2.495-.83a2.75 2.75 0 0 0 .892-.596l4.262-4.262a1.75 1.75 0 0 0 0-2.474Zm-1.414 1.06a.25.25 0 0 1 .354 0l.499.499a.25.25 0 0 1 0 .354l-.934.933-1.233-1.232.934-.933Zm-2.42 2.42 1.233 1.233-2.847 2.847a1.25 1.25 0 0 1-.405.27L6.38 10.75l.407-1.454a1.25 1.25 0 0 1 .27-.405l2.596-2.598Z" />
            </svg>
          </button>
        </div>
        <%# Delete %>
        <%= button_to todo_path(todo), method: :delete,
              class: "rounded p-1 text-gray-400 hover:text-dusty-rose-600 dark:hover:text-dusty-rose-400 transition-colors",
              aria: { label: "Delete task" },
              data: { turbo_confirm: "Delete \"#{todo.title}\"?" } do %>
          <svg viewBox="0 0 16 16" fill="currentColor" class="size-3.5">
            <path d="M5.75 3a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 0 1.5h-3A.75.75 0 0 1 5.75 3ZM3 4.25a.75.75 0 0 1 .75-.75h8.5a.75.75 0 0 1 0 1.5H3A.75.75 0 0 1 3 4.25Zm1.5 1.5.652 6.515A1.75 1.75 0 0 0 6.897 14h2.206a1.75 1.75 0 0 0 1.745-1.735L11.5 5.75h-7Z" />
          </svg>
        <% end %>
      </div>
    </div>

    <%# Title %>
    <p class="text-sm font-semibold text-gray-900 dark:text-white leading-snug"><%= todo.title %></p>

    <%# Description (truncated) %>
    <% if todo.description.present? %>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400 line-clamp-2"><%= todo.description %></p>
    <% end %>
    <% if todo.start_date.present? && todo.end_date.present? %>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
        <%= todo.start_date.strftime("%b %-d") %> – <%= todo.end_date.strftime("%b %-d") %>
      </p>
    <% end %>
    <% if todo.completed? %>
      <p class="text-xs text-gray-500 dark:text-gray-400">Took <%= todo.actual_hm %></p>
    <% elsif todo.estimated_time_to_complete.to_i.positive? %>
      <p class="text-xs text-gray-500 dark:text-gray-400">Est. <%= todo.estimated_hm %></p>
    <% end %>

  </div>
</div>
