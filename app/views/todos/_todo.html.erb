<%# locals: (todo:, priority_config:) %>
<% pri = priority_config[todo.priority] %>
<%# Which week a This Week to-do is planned for, when it isn't this one:
    left over from an earlier week ("Plan your week" asks about these), or
    already planned for a later one. %>
<% this_week = Date.current.beginning_of_week %>
<% week_note = if todo.status == "in_progress"
                 if todo.planned_week.nil? || todo.planned_week < this_week then "From an earlier week"
                 elsif todo.planned_week > this_week then WeeklyPlan.week_label(todo.planned_week)
                 end
               end %>

<div id="todo_<%= todo.id %>"
     data-id="<%= todo.id %>"
     data-sortable-target="item"
     data-controller="tap-edit"
     data-action="click->tap-edit#open"
     class="group relative rounded-lg bg-white dark:bg-[#242b1e] border border-gray-200 dark:border-white/10 p-3 shadow-sm hover:shadow-md transition-shadow <%= todo_movable?(todo) ? 'cursor-grab active:cursor-grabbing' : ('cursor-pointer' if todo_editable?(todo)) %> has-[[data-tap-edit-target]:focus-visible]:ring-2 has-[[data-tap-edit-target]:focus-visible]:ring-[#5f734c]">

  <%# Drag handle (invisible but full-width, class used by sortable_controller).
      Only to-dos this person may move get one — see PermissionsHelper. %>
  <% if todo_movable?(todo) %>
    <div class="sortable-handle absolute inset-0 rounded-lg cursor-grab active:cursor-grabbing" aria-hidden="true"></div>
  <% end %>

  <%# Edit dialog, opened by clicking or tapping the card
      (tap_edit_controller.js clicks the screen-reader-only button), with
      Delete beside Close. %>
  <% if todo_editable?(todo) %>
    <div data-controller="dialog" data-action="click->dialog#backdropClose">
      <dialog data-dialog-target="dialog" class="dark:bg-[#1a1f16] w-11/12 sm:w-1/2 rounded-lg p-6 shadow-xl backdrop:bg-black/50">
        <%= render "shared/dialog_close_x" %>
        <%= turbo_frame_tag "edit_todo_#{todo.id}", src: edit_todo_path(todo) do %><% end %>
        <div class="mt-4 flex items-center justify-between gap-3">
          <%= button_to "Delete", todo_path(todo), method: :delete,
                class: "rounded-lg px-4 py-2.5 text-sm font-semibold text-dusty-rose-700 hover:bg-dusty-rose-50 dark:text-dusty-rose-300 dark:hover:bg-dusty-rose-900/20 cursor-pointer transition",
                data: { turbo_confirm: "Delete \"#{todo.title}\"?" } %>
          <button type="button" data-action="dialog#close"
                  class="rounded-lg px-6 py-2.5 bg-gray-200 hover:bg-gray-300 dark:bg-white/10 dark:hover:bg-white/20 text-gray-900 dark:text-white font-medium transition">
            Close
          </button>
        </div>
      </dialog>
      <button type="button" class="sr-only" data-action="dialog#open" data-tap-edit-target="edit">Edit task</button>
    </div>
  <% end %>

  <div class="relative z-10 pointer-events-none">
    <%# Title %>
    <p class="text-sm font-semibold text-gray-900 dark:text-white leading-snug"><%= todo.title %></p>

    <%# Priority badge, who it's assigned to (only when someone is), and its tags %>
    <div class="mt-1 flex flex-wrap items-center gap-1.5">
      <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= pri[:classes] %>">
        <%= pri[:label] %>
      </span>
      <%= person_pill(todo.assignee) %>
      <% todo.tags.each do |tag| %>
        <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium <%= tag.pill_classes %>">
          <%= tag.name %>
        </span>
      <% end %>
    </div>

    <%# Description (truncated) %>
    <% if todo.description.present? %>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400 line-clamp-2"><%= todo.description %></p>
    <% end %>
    <% if week_note %>
      <p class="mt-1 text-xs font-medium text-honey-700 dark:text-honey-300"><%= week_note %></p>
    <% end %>
    <% if todo.completed? %>
      <p class="text-xs text-gray-500 dark:text-gray-400">Took <%= todo.actual_hm %></p>
    <% elsif todo.estimated_time_to_complete.to_i.positive? %>
      <p class="text-xs text-gray-500 dark:text-gray-400">Est. <%= todo.estimated_hm %></p>
    <% end %>

  </div>
</div>
