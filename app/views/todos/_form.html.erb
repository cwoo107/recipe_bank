<%# locals: (todo:) %>

<%= form_with model: todo,
      data: { controller: "dialog", action: "submit->dialog#close" } do |f| %>

  <div class="mb-5">
    <h3 class="text-2xl font-semibold text-olive-800 dark:text-[#e8ede3]"
        style="font-family: 'Instrument Serif', serif;">
      <%= todo.new_record? ? "New task" : "Edit task" %>
    </h3>
  </div>

  <% if todo.errors.any? %>
    <div class="mb-4 rounded-lg bg-dusty-rose-50 dark:bg-dusty-rose-900/20 p-3 border border-dusty-rose-200 dark:border-dusty-rose-700">
      <ul class="list-disc list-inside text-sm text-dusty-rose-700 dark:text-dusty-rose-300 space-y-1">
        <% todo.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Title %>
  <div class="mb-4">
    <%= f.label :title, "Title", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.text_field :title,
          class: "block w-full rounded-md border border-gray-300 dark:border-white/20 bg-white dark:bg-[#242b1e] px-3 py-2 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:border-[#5f734c] focus:ring-2 focus:ring-[#5f734c]/20 focus:outline-none",
          placeholder: "What needs to be done?" %>
  </div>

  <%# Description %>
  <div class="mb-4">
    <%= f.label :description, "Description", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.text_area :description,
          rows: 3,
          class: "block w-full rounded-md border border-gray-300 dark:border-white/20 bg-white dark:bg-[#242b1e] px-3 py-2 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:border-[#5f734c] focus:ring-2 focus:ring-[#5f734c]/20 focus:outline-none resize-none",
          placeholder: "Optional details…" %>
  </div>

  <%# Priority (required) %>
  <%
    active_classes = {
      "low"    => "bg-seafoam-100 border-seafoam-500 text-seafoam-800",
      "medium" => "bg-honey-100 border-honey-500 text-honey-800",
      "high"   => "bg-mauve-100 border-mauve-500 text-mauve-800",
      "urgent" => "bg-dusty-rose-100 border-dusty-rose-500 text-dusty-rose-800"
    }
    inactive_classes = "bg-white border-gray-300 text-gray-600"
    current_priority = todo.priority.to_s
    priority_group_id = "priority-group-#{todo.object_id}"
  %>
  <div class="mb-4">
    <%= f.label :priority, class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" do %>
      Priority <span class="text-dusty-rose-500">*</span>
    <% end %>
    <div id="<%= priority_group_id %>" class="grid grid-cols-4 gap-2">
      <% Todo::PRIORITIES.keys.each do |level| %>
        <% selected = current_priority == level.to_s %>
        <label class="cursor-pointer">
          <%= f.radio_button :priority, level, class: "sr-only" %>
          <span data-active-class="<%= active_classes[level.to_s] %>"
                data-inactive-class="<%= inactive_classes %>"
                class="block rounded-md border px-2 py-2 text-center text-xs font-medium transition-all <%= selected ? active_classes[level.to_s] : inactive_classes %>">
            <%= level.to_s.capitalize %>
          </span>
        </label>
      <% end %>
    </div>
  </div>
  <div class="mt-4">
    <label class="block text-sm font-medium text-olive-800 dark:text-[#e8ede3]">
      Estimated time to complete
    </label>
    <div class="mt-1 flex items-center gap-2">
      <%= f.number_field :estimated_hours,
                            in: 0..99, value: f.object.estimated_time_to_complete.to_i / 60,
                            placeholder: "0",
                            class: "w-20 rounded-md border-gray-300 dark:border-white/10 dark:bg-[#1a1f16] dark:text-white" %>
      <span class="text-sm text-gray-500 dark:text-gray-400">h</span>

      <%= f.number_field :estimated_minutes,
                            in: 0..59, step: 5, value: f.object.estimated_time_to_complete.to_i % 60,
                            placeholder: "0",
                            class: "w-20 rounded-md border-gray-300 dark:border-white/10 dark:bg-[#1a1f16] dark:text-white" %>
      <span class="text-sm text-gray-500 dark:text-gray-400">m</span>
    </div>
    <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
      Each calendar day provides 30 minutes of work capacity.
    </p>
  </div>

  <script>
    (function() {
      var group = document.getElementById("<%= priority_group_id %>");
      if (!group) return;
      group.addEventListener('change', function(e) {
        if (e.target.type !== 'radio') return;
        group.querySelectorAll('label').forEach(function(label) {
          var input  = label.querySelector('input');
          var span   = label.querySelector('span');
          var active   = span.dataset.activeClass;
          var inactive = span.dataset.inactiveClass;
          active.split(' ').forEach(function(c) { span.classList.toggle(c, input.checked); });
          inactive.split(' ').forEach(function(c) { span.classList.toggle(c, !input.checked); });
        });
      });
    })();
  </script>

  <%# Status (hidden if set via column quick-add) %>
  <div class="mb-6">
    <%= f.label :status, "Column", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
    <%= f.select :status,
          Todo::STATUSES.map { |s| [ Todo::STATUS_LABELS[s], s ] },
          {},
          class: "block w-full rounded-md border border-gray-300 dark:border-white/20 bg-white dark:bg-[#242b1e] px-3 py-2 text-sm text-gray-900 dark:text-white focus:border-[#5f734c] focus:ring-2 focus:ring-[#5f734c]/20 focus:outline-none" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit todo.new_record? ? "Create task" : "Save changes",
          class: "inline-flex items-center rounded-md bg-[#5f734c] px-4 py-2.5 text-sm font-semibold text-white hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:hover:bg-[#5f734c] cursor-pointer transition-colors" %>
  </div>
<% end %>
