<%#
  The week's to-dos as blocks of time, one after another in the order of
  the This Week column (completed ones first), along the hours set aside
  for the week. Rendered inline (todos/index, "Plan your week") and
  broadcast from Todo.broadcast_gantt — locals: { budget: TodoBudget }.
  The root element id MUST stay "gantt_chart" so the Turbo Stream replace targets it.
%>
<% gantt        = budget.gantt_data %>
<% chart_height = [ gantt[:rows].size * 34 + 40, 120 ].max %>

<div id="gantt_chart"
     class="flex flex-col rounded-lg border border-gray-200 dark:border-white/10 bg-[var(--ivory)] dark:bg-[#1a1f16] overflow-hidden">

  <%# Header %>
  <div class="flex flex-col gap-3 px-4 py-3 border-b border-gray-200 dark:border-white/10 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-baseline gap-2">
      <h2 class="text-xl font-semibold text-olive-800 dark:text-[#e8ede3]"
          style="font-family: 'Instrument Serif', serif;">
        The week's time
      </h2>
      <span class="text-xs font-medium text-gray-500 dark:text-gray-400"><%= gantt[:week_label] %></span>
    </div>

    <%# Legend %>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[11px] font-medium">
      <% {
           "Low" => "#95a97d", "Medium" => "#e7c878", "High" => "#a98fb0",
           "Urgent" => "#d39a86", "Completed" => "#c2c8ba"
         }.each do |label, color| %>
        <span class="inline-flex items-center gap-1.5 text-gray-600 dark:text-gray-400">
          <span class="inline-block size-2.5 rounded-sm" style="background: <%= color %>;"></span>
          <%= label %>
        </span>
      <% end %>
      <span class="inline-flex items-center gap-1.5 text-gray-600 dark:text-gray-400">
        <span class="inline-block h-3 border-l-2 border-dashed border-dusty-rose-500"></span>
        Time set aside
      </span>
    </div>
  </div>

  <% if gantt[:rows].empty? %>
    <div class="flex items-center justify-center min-h-32 m-3 rounded-md border-2 border-dashed border-gray-200 dark:border-white/10">
      <p class="px-4 text-center text-sm text-gray-400 dark:text-gray-600 italic">
        Nothing planned for this week — move a to-do into “To-Do This Week” to see it here.
      </p>
    </div>
  <% else %>
    <div class="p-3"
         data-controller="gantt"
         data-gantt-data-value='<%= gantt.to_json %>'>
      <div class="relative" style="height: <%= chart_height %>px;">
        <canvas data-gantt-target="canvas"></canvas>
      </div>
    </div>
  <% end %>
</div>
