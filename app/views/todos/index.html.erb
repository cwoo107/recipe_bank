<% content_for :title, "To Dos" %>

<%
  column_config = {
    "todo"        => { label: "To Do",       color: "seafoam",    accent: "#5f734c" },
    "in_progress" => { label: "In Progress", color: "honey",      accent: "#b88a00" },
    "done"        => { label: "Done",        color: "mist",       accent: "#4a7a7a" }
  }

  priority_config = {
    "low"    => { label: "Low",    classes: "bg-seafoam-100 text-seafoam-800 dark:bg-seafoam-900/30 dark:text-seafoam-300" },
    "medium" => { label: "Medium", classes: "bg-honey-100 text-honey-800 dark:bg-honey-900/30 dark:text-honey-300" },
    "high"   => { label: "High",   classes: "bg-mauve-100 text-mauve-800 dark:bg-mauve-900/30 dark:text-mauve-300" },
    "urgent" => { label: "Urgent", classes: "bg-dusty-rose-100 text-dusty-rose-800 dark:bg-dusty-rose-900/30 dark:text-dusty-rose-300" }
  }
%>

<div class="w-full">
  <%# Page header %>
  <div class="sm:flex sm:items-center sm:justify-between mb-8">
    <div>
      <h1 class="text-5xl tracking-tight text-olive-800 dark:text-[#e8ede3]">
        <span class="text-[#5f734c]" style="font-family: 'Instrument Serif', serif;">
          ToDo<span class="text-olive-800">List</span>
        </span>
      </h1>
      <p class="mt-2 text-sm text-gray-700 dark:text-gray-400">
        <%= current_user.todos.count %> task<%= current_user.todos.count == 1 ? "" : "s" %> across all columns
      </p>
    </div>
    <div class="mt-4 sm:ml-16 sm:mt-0">
      <div data-controller="dialog" data-action="click->dialog#backdropClose">
        <dialog data-dialog-target="dialog" class="dark:bg-[#1a1f16] w-11/12 sm:w-1/2 rounded-lg p-6 shadow-xl backdrop:bg-black/50">
          <%= turbo_frame_tag "new_todo", src: new_todo_path do %><% end %>
          <div class="mt-4">
            <button type="button" data-action="dialog#close" autofocus
                    class="rounded-lg px-6 py-2.5 bg-gray-200 hover:bg-gray-300 dark:bg-white/10 dark:hover:bg-white/20 text-gray-900 dark:text-white font-medium transition">
              Close
            </button>
          </div>
        </dialog>
        <button type="button" data-action="dialog#open"
                class="inline-flex items-center gap-x-2 rounded-md bg-[#5f734c] px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-[#4b5a3d] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#5f734c] dark:bg-[#7a8f62] dark:shadow-none dark:hover:bg-[#5f734c]">
          <svg viewBox="0 0 20 20" fill="currentColor" class="-ml-0.5 size-5" aria-hidden="true">
            <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
          </svg>
          Add a task
        </button>
      </div>
    </div>
  </div>

  <%# Kanban columns %>
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <% Todo::STATUSES.each do |status| %>
      <% cfg = column_config[status] %>
      <% todos = @todos_by_status[status] %>

      <div class="flex flex-col rounded-lg border border-gray-200 dark:border-white/10 bg-[var(--ivory)] dark:bg-[#1a1f16] overflow-hidden">
        <%# Column header %>
        <div class="flex items-center justify-between px-4 py-3 border-b border-gray-200 dark:border-white/10">
          <div class="flex items-center gap-2">
            <h2 class="text-xl font-semibold text-olive-800 dark:text-[#e8ede3]"
                style="font-family: 'Instrument Serif', serif;">
              <%= cfg[:label] %>
            </h2>
            <span class="inline-flex items-center rounded-full bg-gray-100 dark:bg-white/10 px-2 py-0.5 text-xs font-medium text-gray-600 dark:text-gray-400">
              <%= todos.count %>
            </span>
          </div>
          <%# Quick add for this column %>
          <div data-controller="dialog" data-action="click->dialog#backdropClose">
            <dialog data-dialog-target="dialog" class="dark:bg-[#1a1f16] w-11/12 sm:w-1/2 rounded-lg p-6 shadow-xl backdrop:bg-black/50">
              <%= turbo_frame_tag "new_todo_#{status}", src: new_todo_path(status: status) do %><% end %>
              <div class="mt-4">
                <button type="button" data-action="dialog#close"
                        class="rounded-lg px-6 py-2.5 bg-gray-200 hover:bg-gray-300 dark:bg-white/10 dark:hover:bg-white/20 text-gray-900 dark:text-white font-medium transition">
                  Close
                </button>
              </div>
            </dialog>
            <button type="button" data-action="dialog#open"
                    class="rounded-md p-1 text-gray-400 hover:text-[#5f734c] dark:hover:text-[#7a8f62] transition-colors"
                    aria-label="Add task to <%= cfg[:label] %>">
              <svg viewBox="0 0 20 20" fill="currentColor" class="size-4">
                <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
              </svg>
            </button>
          </div>
        </div>

        <%# Sortable card list %>
        <div id="todos_<%= status %>"
             class="flex flex-col gap-2 p-3 min-h-40 flex-1"
             data-controller="kanban"
             data-kanban-url-value="<%= reorder_todos_path %>"
             data-status="<%= status %>">
          <% todos.each do |todo| %>
            <%= render "todos/todo", todo: todo, priority_config: priority_config %>
          <% end %>

          <% if todos.empty? %>
            <div data-placeholder class="flex-1 flex items-center justify-center min-h-20 rounded-md border-2 border-dashed border-gray-200 dark:border-white/10">
              <p class="text-sm text-gray-400 dark:text-gray-600 italic">No tasks here yet</p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
